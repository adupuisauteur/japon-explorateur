#!/bin/sh
# Faux « docker » pour tester mettre-a-jour.ps1 sans Docker (2.0.0, complété en 2.0.1). Journalise chaque appel.
# 2.0.1 : garde une petite liste d'images (« nom identifiant ») à côté du journal des appels, pour simuler la
# construction, le téléchargement, l'étiquetage et le retour à l'ancienne version.
echo "$(pwd) | $*" >> "$FAKE_DOCKER_LOG"
IMAGES="${FAKE_DOCKER_LOG%/*}/images.txt"
env_value() { sed -n "s/^$1=//p" .env 2>/dev/null | head -n 1; }
if [ ! -f "$IMAGES" ]; then
  # Images présentes au départ : celles de l'installation actuelle (dossier FAKE_ACTUEL).
  printf 'japon-explorateur:%s sha256:ancienne\npostgres:15-bookworm sha256:postgres\nredis:7-alpine sha256:redis\n' \
    "$(cat "$FAKE_ACTUEL/VERSION")" > "$IMAGES"
  for absente in ${FAKE_IMAGES_ABSENTES:-}; do
    grep -v "^$absente " "$IMAGES" > "$IMAGES.tmp"; mv "$IMAGES.tmp" "$IMAGES"
  done
fi
set_image() { grep -v "^$1 " "$IMAGES" > "$IMAGES.tmp"; echo "$1 $2" >> "$IMAGES.tmp"; mv "$IMAGES.tmp" "$IMAGES"; }
ici_actuel() { [ "$(pwd)" = "$FAKE_ACTUEL" ]; }
case "$*" in
  "info") exit "${FAKE_DOCKER_INFO:-0}" ;;
  "compose ls -a --format json")
    # 2.0.2 (assistant) : projets Compose connus de Docker, au format JSON de « docker compose ls ».
    printf '%s\n' "${FAKE_COMPOSE_LS:-[]}"; exit "${FAKE_COMPOSE_LS_CODE:-0}" ;;
  "version --format {{.Server.Version}}") echo "29.9.3"; exit 0 ;;
  "compose ps -a")
    echo "NAME   SERVICE   STATUS"; echo "x-web-1   web   Up 2 minutes (healthy)"; exit 0 ;;
  "compose logs --tail 150 --no-color")
    # 2.0.2 (compte rendu) : des journaux qui contiennent un secret et une adresse, à masquer.
    printf '%s\n' "${FAKE_LOGS:-web-1  | démarrage}"; exit 0 ;;
  "compose exec -T web python manage.py mot_de_passe_oublie --liste")
    echo '[{"identifiant": "auteur-fictif", "nom": "Auteur fictif", "role": "Administrateur", "actif": true}]'; exit 0 ;;
  "compose exec -T web python manage.py mot_de_passe_oublie --utilisateur "*)
    # 2.0.2 : le mot de passe arrive sur l'entrée standard ; il est gardé à part pour vérifier qu'il est bien reçu.
    read -r mot; printf '%s' "$mot" > "${FAKE_DOCKER_LOG%/*}/mot-recu"
    if [ "${#mot}" -lt 10 ]; then echo "CommandError: Mot de passe refusé : Ce mot de passe est trop court." >&2; exit 1; fi
    echo "Mot de passe changé pour « $9 »."; exit 0 ;;
  "compose cp "*" web:/data/"*) exit "${FAKE_CP:-0}" ;;
  "compose exec -T web python manage.py restore_backup /data/"*" --yes")
    echo "Sauvegarde de sécurité créée : /data/backups/sauvegarde-20261123-150000-full.tar"
    if [ "${FAKE_RESTORE:-ok}" != ok ]; then echo "CommandError: Restauration impossible (ValueError : archive abîmée)." >&2; exit 1; fi
    echo "Base restaurée."; exit 0 ;;
  "compose restart") exit 0 ;;
  "volume ls -q")
    for v in ${FAKE_VOLUMES:-}; do echo "$v"; done; exit 0 ;;
  "volume ls --format {{.Name}}")
    for v in ${FAKE_VOLUMES:-}; do echo "$v"; done; exit 0 ;;
  "compose ps --services --status running")
    printf 'db\nredis\nweb\nworker\nbeat\n'; [ "${FAKE_ARGOS:-0}" = 1 ] && echo argos; exit 0 ;;
  "compose exec -T web python manage.py backup --verify")
    # Réponses telles que les lit Windows PowerShell 5.1 avec la page de code 850 (constat du 15 novembre 2026)
    if [ "${FAKE_BACKUP:-ok}" = "accents-abimes" ]; then
      echo "Termin├®e : /data/backups/sauvegarde-20261114-220000-full.tar (3829760 octets) ÔÇö Sauvegarde termin├®e."
      echo "Int├®grit├® v├®rifi├®e."; exit 0
    fi
    if [ "${FAKE_BACKUP:-ok}" = "echec-accents-abimes" ]; then
      echo "├ëchec :  (0 octets) ÔÇö ├ëchec : OSError : disque plein"; exit 0
    fi
    if [ "${FAKE_BACKUP:-ok}" = "echec-130" ]; then
      echo "Échec :  (0 octets) — Échec : OSError : disque plein"; exit 0
    fi
    echo "Terminée : /data/backups/sauvegarde-20261114-220000-full.tar (14 octets) — Sauvegarde terminée."
    echo "Intégrité vérifiée."; exit 0 ;;
  "compose cp web:"*)
    dest=$(echo "$*" | awk '{print $4}'); printf 'contenu-fictif' > "$dest"; exit 0 ;;
  "compose exec -T web sha256sum "*)
    echo "$(printf 'contenu-fictif' | sha256sum | cut -d' ' -f1)  /data/backups/x.tar"; exit 0 ;;
  "compose config --format json")
    # Comme le vrai : la configuration complète contient les mots de passe du .env.
    # 2.0.2-rc2 : avec les arguments de construction du vrai docker-compose.yml (FAKE_BUILD_ARGS) : deux noms qui
    # ne diffèrent que par la casse rendent ce JSON illisible pour PowerShell (défaut de la rc1).
    args=""; for a in ${FAKE_BUILD_ARGS:-}; do args="$args${args:+, }\"$a\": \"\""; done
    echo "{\"name\": \"$(env_value COMPOSE_PROJECT_NAME)\", \"services\": {\"web\": {\"build\": {\"context\": \".\", \"args\": {$args}}, \"image\": \"japon-explorateur:$(cat VERSION)\"}, \"db\": {\"image\": \"postgres:15-bookworm\", \"environment\": {\"POSTGRES_PASSWORD\": \"$(env_value POSTGRES_PASSWORD)\"}}}}"
    exit 0 ;;
  "compose config --images")
    printf 'japon-explorateur:%s\npostgres:15-bookworm\nredis:7-alpine\n' "$(cat VERSION)"; exit 0 ;;
  "image inspect --format {{.Id}} "*)
    nom=$(echo "$*" | awk '{print $5}')
    id=$(sed -n "s/^$nom //p" "$IMAGES" | head -n 1)
    if [ -n "$id" ]; then echo "$id"; exit 0; fi
    echo "Error: No such image: $nom" >&2; exit 1 ;;
  "tag "*)
    # 2.0.1-rc3 : comme Docker 29 (stockage containerd), la source doit être un nom existant, ou l'identifiant d'une
    # image qui porte encore au moins un nom : une image qui a perdu son dernier nom n'est plus retrouvable.
    [ "${FAKE_TAG_ECHEC:-0}" = 1 ] && { echo "Error response from daemon: No such image: $2" >&2; exit 1; }
    id=$(sed -n "s/^$2 //p" "$IMAGES" | head -n 1)
    [ -z "$id" ] && grep -q " $2\$" "$IMAGES" && id="$2"
    [ -z "$id" ] && { echo "Error response from daemon: No such image: $2" >&2; exit 1; }
    set_image "$3" "$id"; exit 0 ;;
  "compose build")
    if [ "${FAKE_BUILD_PARTIEL:-0}" = 1 ]; then
      # 2.0.1-rc2 : comme le 20/11/2026, une image est reconstruite et ré-étiquetée avant l'échec.
      set_image "japon-explorateur:$(cat VERSION)" "sha256:partielle"
      printf 'target web: failed to solve: exit code: 1\n\n' >&2; exit 1
    fi
    if [ "${FAKE_BUILD:-0}" != 0 ]; then
      # Lignes vides sur la sortie d'erreur, comme Docker (« RemoteException » sous Windows PowerShell 5.1).
      printf 'Dockerfile:15\n\n--------------------\n\n' >&2
      echo "failed to solve: python:3.12-slim-bookworm: failed to resolve source metadata: context deadline exceeded" >&2
      exit "$FAKE_BUILD"
    fi
    # Une image construite par dossier : deux constructions ne donnent jamais le même identifiant (comme Docker).
    set_image "japon-explorateur:$(cat VERSION)" "sha256:construite-$(pwd | sha256sum | cut -c1-8)"; exit 0 ;;
  "compose pull --ignore-buildable")
    if [ "${FAKE_PULL:-ok}" = ok ]; then
      for absente in ${FAKE_IMAGES_ABSENTES:-}; do set_image "$absente" "sha256:telechargee"; done; exit 0
    fi
    echo "Error response from daemon: Get https://registry-1.docker.io/v2/: context deadline exceeded" >&2; exit 1 ;;
  "compose down") exit 0 ;;
  "compose up -d")
    if ici_actuel; then exit "${FAKE_UP_ANCIENNE:-0}"; fi
    exit "${FAKE_UP:-0}" ;;
  "compose exec -T web curl -fsS http://localhost:8000/sante/")
    # 2.0.1-rc2 : page de santé du serveur web. ok ; ko (jamais) ; une-fois (répond une fois, puis plus).
    # 2.0.1-rc3 : dans le dossier de l'installation actuelle, c'est FAKE_SANTE_ANCIENNE qui compte.
    etat_sante="${FAKE_SANTE:-ok}"; ici_actuel && etat_sante="${FAKE_SANTE_ANCIENNE:-ok}"
    case "$etat_sante" in
      ok) echo '{"etat": "ok"}'; exit 0 ;;
      une-fois)
        if [ ! -f "${FAKE_DOCKER_LOG%/*}/sante-deja" ]; then
          touch "${FAKE_DOCKER_LOG%/*}/sante-deja"; echo '{"etat": "ok"}'; exit 0
        fi ;;
    esac
    echo "curl: (7) Failed to connect to localhost port 8000: Connection refused" >&2; exit 7 ;;
  "compose exec -T web python manage.py etat_installation --json")
    niveau=ok; [ "${FAKE_ETAT:-ok}" = ko ] && niveau=error
    echo "{\"version\": \"$(cat VERSION)\", \"etat\": \"warning\", \"controles\": [{\"cle\": \"base\", \"libelle\": \"Base de données et migrations\", \"niveau\": \"$niveau\", \"resume\": \"À jour\", \"details\": []}]}"
    echo "CommandError: exemple de texte après le JSON" >&2; exit 0 ;;
esac
echo "faux docker : appel non prévu : $*" >&2
exit 99
