+def argosmodel(source="en", target="fr", version="1.9"):
+    buffer = io.BytesIO()
+    with zipfile.ZipFile(buffer, "w") as z:
+        z.writestr("metadata.json", json.dumps({"from_code": source, "to_code": target, "package_version": version}))
+    return buffer.getvalue()
