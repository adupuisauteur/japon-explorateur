+{% extends "base.html" %}
+{% block title %}Traduction — Glossaires{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Glossaires</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-journal-text"></i> Glossaires</h1>
+  <p>Terminologie imposée aux traductions : noms propres, ères, titres, termes historiques. Un glossaire s'applique aux projets auxquels il est rattaché.</p></div>
+  <a class="btn btn-primary" href="{% url 'translation:glossary_create' %}"><i class="bi bi-plus-lg"></i> Nouveau glossaire</a></div>
+<div class="card-soft small mb-3">Application selon le moteur : <strong>DeepL</strong> — copie envoyée à DeepL seulement si vous cliquez sur « Envoyer à DeepL » ;
+  <strong>IA</strong> — termes présents dans les segments ajoutés à la consigne ; <strong>Google, Argos</strong> — aucune prise en charge.
+  Dans tous les cas, un contrôle local signale les écarts après traduction, sans rien corriger.</div>
+<h2 class="h5">Mes glossaires</h2>
+{% include "translation/_glossary_table.html" with glossaries=mine %}
+{% if user.is_admin_role %}
+<h2 class="h5 mt-4">Glossaires des autres comptes</h2>
+{% include "translation/_glossary_table.html" with glossaries=others show_owner=True %}
+{% if hidden %}<h2 class="h5 mt-4">Glossaires liés à des projets confidentiels d'autres comptes</h2>
+<p class="small text-muted">Métadonnées seulement.</p>
+<table class="table table-sm"><thead><tr><th>Nom</th><th>Propriétaire</th><th>Entrées</th></tr></thead><tbody>
+{% for g in hidden %}<tr><td><i class="bi bi-lock-fill"></i> {{ g.name }}</td><td>{{ g.owner }}</td><td>{{ g.n_entries }}</td></tr>{% endfor %}</tbody></table>{% endif %}
+{% endif %}
+{% endblock %}
diff --git a/templates/translation/home.html b/templates/translation/home.html
new file mode 100644
index 0000000..ed140cb
--- /dev/null
+++ b/templates/translation/home.html
@@ -0,0 +1,41 @@
+{% extends "base.html" %}
+{% block title %}Traduction{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-translate"></i> Traduction</h1>
+  <p>Traduction des notices et des documents, avec choix du moteur, glossaires, versions et validation humaine.
+  Aucun texte n'est envoyé à un service en ligne sans votre confirmation.</p></div></div>
+
+<div class="alert alert-info" role="status">
+  Version {{ APP_VERSION }} en cours de développement : les rubriques ci-dessous s'activent au fil des lots.
+</div>
+
+<div class="row g-3 mb-4">
+  {% for icon, name, text, lot, url_name in sections %}
+  <div class="col-md-6 col-lg-4">{% if url_name %}<a class="card-soft d-block text-decoration-none text-reset h-100" href="{% url url_name %}">{% else %}<div class="card-soft h-100">{% endif %}
+    <h2 class="h5"><i class="bi {{ icon }}"></i> {{ name }}</h2>
+    <p class="text-muted mb-1">{{ text }}</p>
+    {% if not url_name %}<span class="badge text-bg-light">Prévu au lot {{ lot }}</span>{% endif %}
+  {% if url_name %}</a>{% else %}</div>{% endif %}</div>
+  {% endfor %}
+</div>
+
+<h2 class="h4">Mes projets</h2>
+{% if mine %}
+<table class="table table-sm align-middle"><thead><tr><th>Titre</th><th>Documents</th><th>Confidentiel</th><th>Mis à jour</th></tr></thead><tbody>
+{% for p in mine %}<tr><td>{{ p.title }}{% if p.transferred_from %} <span class="badge text-bg-light" title="Transféré le {{ p.transferred_at|date:'d/m/Y' }}">transféré de {{ p.transferred_from }}</span>{% endif %}</td>
+  <td>{{ p.n_docs }}</td><td>{% if p.confidential %}<i class="bi bi-lock-fill" title="Confidentiel"></i> oui{% else %}non{% endif %}</td>
+  <td class="text-muted small">{{ p.updated_at|date:"d/m/Y H:i" }}</td></tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted">Aucun projet pour l'instant.</p>{% endif %}
+
+{% if user.is_admin_role %}
+<h2 class="h4 mt-4">Projets des autres comptes</h2>
+{% if others or hidden %}
+<table class="table table-sm align-middle"><thead><tr><th>Titre</th><th>Propriétaire</th><th>Documents</th><th>Accès</th></tr></thead><tbody>
+{% for p in others %}<tr><td>{{ p.title }}</td><td>{{ p.owner }}</td><td>{{ p.n_docs }}</td><td>Contenu consultable</td></tr>{% endfor %}
+{% for p in hidden %}<tr><td>{{ p.title }}</td><td>{{ p.owner }}</td><td>{{ p.n_docs }}</td>
+  <td><i class="bi bi-lock-fill"></i> Confidentiel : métadonnées seulement</td></tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted">Aucun.</p>{% endif %}
+{% endif %}
+{% endblock %}
diff --git a/templates/translation/job_detail.html b/templates/translation/job_detail.html
