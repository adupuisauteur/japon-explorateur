+<h2 class="h5 mt-3">{{ title }}</h2>
+{% if projects %}
+<table class="table table-sm align-middle"><thead><tr><th>Titre</th>{% if show_owner %}<th>Propriétaire</th>{% endif %}<th>Documents</th><th>Segments validés</th><th>Mis à jour</th></tr></thead><tbody>
+{% for p in projects %}<tr>
+  <td><a href="{% url 'translation:project_detail' p.pk %}">{{ p.title }}</a>{% if p.confidential %} <span class="badge text-bg-dark"><i class="bi bi-lock-fill"></i> confidentiel</span>{% endif %}{% if p.is_reference_corpus %} <span class="badge text-bg-info">corpus</span>{% endif %}{% if p.transferred_from %} <span class="badge text-bg-light">transféré de {{ p.transferred_from }}</span>{% endif %}</td>
+  {% if show_owner %}<td>{{ p.owner }}</td>{% endif %}
+  <td>{{ p.n_docs }}</td><td>{{ p.n_validated }} / {{ p.n_segments }}</td><td class="small text-muted">{{ p.updated_at|date:"d/m/Y H:i" }}</td></tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted small">Aucun.</p>{% endif %}
diff --git a/templates/translation/_terms.html b/templates/translation/_terms.html
new file mode 100644
