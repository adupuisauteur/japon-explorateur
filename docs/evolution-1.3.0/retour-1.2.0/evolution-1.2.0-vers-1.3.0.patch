+++ b/apps/translation/engines/ai.py
@@ -0,0 +1,219 @@
+"""
+Intelligences artificielles en ligne déjà configurées dans le module IA (ChatGPT, Claude, Gemini,
+service compatible OpenAI), utilisées comme moteurs de traduction.
+
+Réutilisation sans duplication : clés, fournisseurs et appels viennent de apps/ai (AIProviderCredential,
+providers.get_provider). Les clés restent gérées dans IA → Fournisseurs.
+Consentement (décision C5) : moteur indisponible si le profil IA actif est en mode « Désactivée » ou si
+la case « Traduction » du profil est décochée.
+Consignes : reference/consignes-ia.json (versionnées). Réponse JSON exigée et vérifiée : identifiants
+manquants ou en trop → réponse rejetée ; texte autour du JSON → alerte « commentaire hors traduction ».
+La création d'une tâche IA par appel (décision E1) et le plafond IA sont appliqués par la chaîne de
+traitement (lot 4), pas ici.
+"""
+import json
+import re
+from functools import lru_cache
+from pathlib import Path
+
+from apps.ai.models import PROVIDERS, AIProviderCredential
+from apps.ai.preferences import active_profile
+from apps.ai.providers import ProviderError, get_provider
+
+from .base import EngineResult, EngineStatus, TranslationEngine, engine_error
+
+PROMPTS_FILE = Path(__file__).resolve().parent.parent / "reference" / "consignes-ia.json"
+
+#: nature d'une ProviderError → (nature ConnectorError, catégorie du journal)
+PROVIDER_KIND_MAP = {
+    "auth": ("config", "cle_refusee"),
+    "quota": ("unavailable", "quota_depasse"),
+    "unavailable": ("unavailable", ""),
+    "not_found": ("config", ""),
+    "refused": ("config", ""),
+    "redirect": ("technical", ""),
+    "unparsable": ("unparsable", "reponse_vide"),
+    "technical": ("technical", ""),
+}
+
+#: débuts de réponse qui signalent un commentaire au lieu d'une traduction seule
+COMMENT_MARKERS = re.compile(r"(?i)^\s*(traduction\s*:|voici|note\s*:|remarque\s*:|translation\s*:)")
+
+
+@lru_cache(maxsize=1)
+def prompts():
+    return json.loads(PROMPTS_FILE.read_text(encoding="utf-8"))
+
+
+def _present_terms(glossary, text, source):
+    """Seules les entrées dont le terme figure dans les segments du paquet sont envoyées (lot 7).
+
+    `glossary` : GlossaryBundle (apps/translation/glossary.py) ou liste de (source, cible[, à éviter]).
+    """
+    if not glossary:
+        return []
+    if hasattr(glossary, "found_in"):
+        return [(form, term.target, term.avoid) for term, form in glossary.found_in(text)]
+    out = []
+    for item in glossary:
+        a, b, *rest = item
+        if a and a in text:
+            out.append((a, b, rest[0] if rest else []))
+    return out
+
+
+def _term_text(term):
+    a, b, avoid = term
+    return f"{a} → {b}" + (f" (à éviter : {', '.join(avoid)})" if avoid else "")
+
+
+def build_prompt(batch, source, target, *, glossary=None, variety="modern", context=None):
+    p = prompts()
+    labels = p["language_labels"]
+    joined_sources = "\n".join(s.text for s in batch)
+    terms = _present_terms(glossary, joined_sources, source)
+    instruction = p["instruction"].format(
+        source_label=labels.get(source, source), target_label=labels.get(target, target),
+        variety_note=p["variety_notes"].get(variety, ""),
+        glossary_note=p["glossary_note"].format(terms=" ; ".join(_term_text(t) for t in terms)) if terms else "",
+        context_note=p["context_note"].format(context=" / ".join(context)) if context else "",
+    )
+    data = {"segments": [{"id": s.id, "text": s.text} for s in batch]}
+    return p["system"], instruction + "\n\nSEGMENTS :\n" + json.dumps(data, ensure_ascii=False, indent=1), terms
+
+
+def parse_response(text, expected_ids):
+    """Retourne ({id: traduction}, alertes globales). Lève une erreur si la réponse ne convient pas."""
+    stripped = (text or "").strip()
+    match = re.search(r"\{.*\}", stripped, re.S)
+    if not match:
+        raise engine_error("La réponse de l'IA n'est pas au format JSON attendu.", kind="unparsable",
+                           code="reponse_vide")
+    alerts = []
+    if stripped[:match.start()].strip() or stripped[match.end():].strip():
+        alerts.append("commentaire hors traduction dans la réponse de l'IA (ignoré)")
+    try:
+        data = json.loads(match.group(0))
+    except ValueError:
+        raise engine_error("JSON invalide dans la réponse de l'IA.", kind="unparsable", code="reponse_vide") from None
+    items = data.get("translations") if isinstance(data, dict) else None
+    if not isinstance(items, list):
+        raise engine_error("Réponse de l'IA sans liste « translations ».", kind="unparsable", code="reponse_vide")
+    found = {}
+    for item in items:
+        if not isinstance(item, dict) or not isinstance(item.get("text"), str):
+            raise engine_error("Élément de traduction mal formé dans la réponse de l'IA.", kind="unparsable",
+                               code="reponse_vide")
+        found[str(item.get("id"))] = item["text"]
+    expected = set(expected_ids)
+    missing, extra = expected - set(found), set(found) - expected
+    if missing or extra or len(items) != len(expected):
+        detail = []
+        if missing:
+            detail.append(f"{len(missing)} segment(s) manquant(s)")
+        if extra:
+            detail.append(f"{len(extra)} identifiant(s) inconnu(s)")
+        if len(items) != len(found):
+            detail.append("identifiants en double")
+        raise engine_error("Réponse de l'IA rejetée : " + ", ".join(detail or ["nombre d'éléments incorrect"]) + ".",
+                           kind="unparsable", code="reponse_vide")
+    return found, alerts
+
+
+class AIEngine(TranslationEngine):
+    code = "ai"
+    label = "Intelligence artificielle en ligne"
+    online = True
+    needs_key = True
+    glossary_support = "prompt"
+    max_items = 20
+    max_chars = 6000
+
+    @property
+    def display_name(self):
+        provider = dict(PROVIDERS).get(self.ai_provider, self.ai_provider or "fournisseur à choisir")
+        return f"{provider} — {self.ai_model or 'modèle à choisir'}"
+
+    def credential(self):
+        return AIProviderCredential.objects.filter(user=self.user, provider=self.ai_provider).first()
+
+    def consent_problem(self):
+        profile = active_profile(self.user)
+        if profile.mode == "disabled":
+            return "L'IA est désactivée dans vos préférences IA."
+        if not profile.translation_enabled:
+            return "La traduction par IA n'est pas autorisée dans vos préférences IA (case « Traduction »)."
+        return ""
+
+    def status(self):
+        if not self.ai_provider:
+            return EngineStatus(False, "Fournisseur à choisir")
+        problem = self.consent_problem()
+        if problem:
+            return EngineStatus(False, "Non autorisé", problem, level="warning")
+        cred = self.credential()
+        if cred is None or not cred.is_configured:
+            return EngineStatus(False, "Clé absente", "Clé à saisir dans IA → Fournisseurs.", level="warning")
+        if not self.ai_model:
+            return EngineStatus(False, "Modèle à choisir")
+        if cred.status == "error":
+            return EngineStatus(True, "Dernier test en échec", cred.last_error, level="warning")
+        if cred.status == "ok":
+            return EngineStatus(True, "Clé testée avec succès", level="success")
+        return EngineStatus(True, "Clé non testée", "Testez-la dans IA → Fournisseurs.")
+
+    def test(self):
+        st = self.status()
+        return f"{self.display_name} : {st.label}. {st.detail}".strip()
+
+    def _provider(self):
+        problem = self.consent_problem()
+        if problem:
+            raise engine_error(problem, kind="config")
+        cred = self.credential()
+        if cred is None or not cred.is_configured:
+            raise engine_error("Aucune clé n'est enregistrée pour ce fournisseur (IA → Fournisseurs).",
+                               kind="config", code="cle_refusee")
+        if not self.ai_model:
+            raise engine_error("Aucun modèle n'est choisi pour ce moteur IA.", kind="config")
+        try:
+            return get_provider(cred)
+        except ProviderError as exc:
+            raise self._convert(exc) from None
+
+    def _convert(self, exc):
+        kind, code = PROVIDER_KIND_MAP.get(getattr(exc, "kind", "") or "technical", ("technical", ""))
+        return engine_error(str(exc), kind=kind, code=code, http_status=getattr(exc, "http_status", None),
+                            diagnostic={"engine": "ai", "provider": self.ai_provider, "model": self.ai_model,
+                                        "http_status": getattr(exc, "http_status", None)})
+
+    def translate(self, segments, source, target, *, glossary=None, variety="modern", context=None):
+        self.check_pair(source, target)
+        provider = self._provider()
+        translations, alerts = {}, {}
+        tokens_in = tokens_out = chars = 0
+        model = self.ai_model
+        for batch in self.batches(segments):
+            system, prompt, _terms = build_prompt(batch, source, target, glossary=glossary, variety=variety,
+                                                  context=context)
+            size = sum(len(s.text) for s in batch)
+            try:
+                completion = provider.complete(system, prompt, self.ai_model, max_tokens=min(8000, 500 + size * 4))
+            except ProviderError as exc:
+                raise self._convert(exc) from None
+            found, global_alerts = parse_response(completion.text, [s.id for s in batch])
+            for seg in batch:
+                text = found[seg.id]
+                seg_alerts = list(global_alerts)
+                if COMMENT_MARKERS.match(text) and not COMMENT_MARKERS.match(seg.text):
+                    seg_alerts.append("la traduction semble commencer par un commentaire")
+                translations[seg.id] = text
+                if seg_alerts:
+                    alerts[seg.id] = seg_alerts
+            tokens_in += completion.tokens_in
+            tokens_out += completion.tokens_out
+            chars += size
+            model = completion.model or model
+        return EngineResult(translations, chars_sent=chars, model=model,
+                            engine_version=f"consignes {prompts()['version']}", tokens_in=tokens_in,
+                            tokens_out=tokens_out, alerts=alerts)
diff --git a/apps/translation/engines/argos.py b/apps/translation/engines/argos.py
new file mode 100644
index 0000000..6bd76b0
--- /dev/null
+++ b/apps/translation/engines/argos.py
@@ -0,0 +1,181 @@
+"""
+Argos Translate : moteur local, hors ligne, sans clé (décision A1 : service Docker séparé et facultatif).
+
+Ce module est le CLIENT du service `argos` (docker/argos/server.py, lot 9). Contrat du service, sur le
+réseau interne Docker uniquement :
+  GET  /health       → {"argos_version": "…", "packages": [{"from": "ja", "to": "en", "version": "1.1"}, …]}
+  POST /translate    → corps {"texts": […], "source": "ja", "target": "fr"}
+                       réponse {"translations": […], "path": ["ja", "en", "fr"]}
+  POST /index        → paquets proposés par l'index Argos (le service consulte Internet)
+  POST /install      → {"from", "to"} : téléchargement depuis l'index et installation (Internet)
+  POST /install-file → {"filename"} : installation d'un fichier .argosmodel du dossier de dépôt
+  POST /remove       → {"from", "to"}
+  POST /install-sbd  → {"from", "to"} : modèle de découpage en phrases d'un paquet qui n'en contient pas (Internet)
+Les quatre derniers ne sont appelés que sur action explicite (Traduction → Moteurs locaux) : le choix de
+télécharger des paquets appartient à l'utilisateur.
+
+Mode simulé (décision du 13 novembre 2026) : tant que le service n'est pas activé ou que les paquets
+nécessaires ne sont pas installés (leur téléchargement attend votre autorisation), Argos peut être
+activé en MODE SIMULÉ. Il ne traduit alors rien : il renvoie le texte original précédé de la mention
+« [Simulation Argos — aucune traduction réelle] ». Ces versions portent l'indicateur `simulated` et la
+mention « Simulation » partout ; elles restent validables.
+"""
+from django.conf import settings
+
+from ..http import TranslationHTTP
+from .base import EngineResult, EngineStatus, TranslationEngine, engine_error
+
+SIMULATION_PREFIX = "[Simulation Argos — aucune traduction réelle] "
+PIVOT = "en"
+#: paquets nécessaires à chaque paire de la 1.3.0 (pas de paquet direct japonais → français dans l'index)
+NEEDED = {("ja", "fr"): [("ja", "en"), ("en", "fr")], ("en", "fr"): [("en", "fr")]}
+
+#: codes d'erreur du service → catégorie du journal et nature
+SERVICE_CODES = {
+    "paquet_absent": ("unsupported", "paquet_absent"),
+    "sbd_absent": ("config", "paquet_absent"),
+    "paquet_corrompu": ("technical", "paquet_absent"),
+    "argos_absent": ("config", "paquet_absent"),
+    "fichier_absent": ("query", ""),
+    "fichier_refuse": ("query", ""),
+    "langue_non_prise": ("unsupported", "langue_non_prise"),
+    "occupe": ("unavailable", ""),
+    "index_injoignable": ("unavailable", ""),
+    "telechargement_echoue": ("unavailable", ""),
+}
+
+
+class ArgosHTTP(TranslationHTTP):
+    def classify(self, status, service_code, service_message, diagnostic):
+        if service_code in SERVICE_CODES:
+            kind, code = SERVICE_CODES[service_code]
+            return engine_error(f"Service Argos : {service_message or service_code}", kind=kind, code=code,
+                                http_status=status, diagnostic=diagnostic)
+        return super().classify(status, service_code, service_message, diagnostic)
+
+
+def _path(source, target, packages):
+    # Un paquet sans son modèle de découpage en phrases ne peut pas traduire hors ligne : ignoré.
+    have = {(p.get("from"), p.get("to")) for p in packages if p.get("sbd_ready", True)}
+    if (source, target) in have:
+        return [source, target]
+    if (source, PIVOT) in have and (PIVOT, target) in have:
+        return [source, PIVOT, target]
+    return None
+
+
+class ArgosEngine(TranslationEngine):
+    code = "argos"
+    label = "Argos Translate (local)"
+    online = False
+    needs_key = False
+    glossary_support = "none"
+    max_items = 50
+    max_chars = 20000
+
+    def _http(self, timeout=None):
+        return ArgosHTTP("Argos Translate", timeout=timeout or settings.TRANSLATION_TIMEOUTS.get("argos"),
+                         transport=self.transport, retries=0)
+
+    @property
+    def service_url(self):
+        return (settings.TRANSLATION_ARGOS_URL or "").rstrip("/")
+
+    def health(self):
+        """État du service, ou None s'il n'est pas activé dans la configuration."""
+        if not self.service_url:
+            return None
+        data = self._http(timeout=3).request("GET", f"{self.service_url}/health")
+        if not isinstance(data, dict) or not isinstance(data.get("packages"), list):
+            raise engine_error("Réponse inattendue du service Argos.", kind="unparsable", code="paquet_absent")
+        return data
+
+    def _real_path(self, source, target):
+        """(chemin, versions) si une traduction réelle est possible ; sinon (None, raison)."""
+        try:
+            health = self.health()
+        except Exception as exc:  # service arrêté, profil non démarré, réseau Docker…
+            return None, f"service Argos injoignable — démarré avec le profil Docker « hors-ligne » ? ({exc})"
+        if health is None:
+            return None, "service Argos non activé (profil Docker « hors-ligne »)"
+        packages = health.get("packages") or []
+        path = _path(source, target, packages)
+        if path is None:
+            if _path(source, target, [dict(p, sbd_ready=True) for p in packages]):
+                return None, "modèle de découpage en phrases manquant (Traduction → Moteurs locaux)"
+            return None, "paquets de langues nécessaires non installés"
+        versions = {f"{p['from']}→{p['to']}": p.get("version", "?") for p in packages}
+        used = " ; ".join(f"{a}→{b} {versions.get(f'{a}→{b}', '?')}" for a, b in zip(path, path[1:]))
+        return path, f"Argos {health.get('argos_version', '?')} — {used}"
+
+    def status(self):
+        s = self.setting
+        if s is None or not s.enabled:
+            return EngineStatus(False, "Non activé", "Activez Argos pour l'utiliser (en mode simulé tant que le "
+                                "service et ses paquets ne sont pas installés).")
+        path, info = self._real_path("ja", "fr")
+        if path:
+            return EngineStatus(True, "Disponible hors ligne", info, level="success")
+        return EngineStatus(True, "Mode simulé", f"Aucune traduction réelle : {info}.", simulated=True,
+                            level="warning")
+
+    def test(self):
+        path, info = self._real_path("ja", "fr")
+        if path:
+            return f"Service Argos disponible : {info}."
+        return f"Mode simulé : {info}. Les traductions porteront la mention « Simulation »."
+
+    def translate(self, segments, source, target, *, glossary=None, variety="modern", context=None):
+        self.check_pair(source, target)
+        if self.setting is None or not self.setting.enabled:
+            raise engine_error("Argos n'est pas activé dans Traduction → Moteurs.", kind="config")
+        path, info = self._real_path(source, target)
+        chars = sum(len(s.text) for s in segments)
+        if path is None:
+            return EngineResult({s.id: SIMULATION_PREFIX + s.text for s in segments}, chars_sent=0,
+                                model="Argos (simulation)", engine_version=info, simulated=True)
+        translations = {}
+        for batch in self.batches(segments):
+            data = self._http().request("POST", f"{self.service_url}/translate",
+                                        json={"texts": [s.text for s in batch], "source": source, "target": target},
+                                        n_texts=len(batch), n_chars=sum(len(s.text) for s in batch))
+            items = data.get("translations") if isinstance(data, dict) else None
+            if not isinstance(items, list) or len(items) != len(batch) or not all(isinstance(t, str) for t in items):
+                raise engine_error("Réponse du service Argos incomplète ou mal formée.", kind="unparsable",
+                                   code="reponse_vide")
+            translations.update({s.id: t for s, t in zip(batch, items)})
+        return EngineResult(translations, chars_sent=chars, model="Argos Translate", engine_version=info)
+
+    # --- gestion des paquets (Traduction → Moteurs locaux ; action explicite de l'utilisateur) -----------
+    def _require_service(self):
+        if not self.service_url:
+            raise engine_error("Service Argos non configuré (TRANSLATION_ARGOS_URL).", kind="config")
+
+    def index(self):
+        """Paquets proposés par l'index Argos. Le service consulte Internet : appel sur action explicite."""
+        self._require_service()
+        data = self._http(timeout=60).request("POST", f"{self.service_url}/index", json={})
+        items = data.get("packages") if isinstance(data, dict) else None
+        if not isinstance(items, list):
+            raise engine_error("Réponse inattendue du service Argos (index).", kind="unparsable", code="reponse_vide")
+        return items
+
+    def install(self, source, target):
+        """Téléchargement depuis l'index et installation (long : délai TRANSLATION_ARGOS_INSTALL_TIMEOUT)."""
+        self._require_service()
+        return self._http(timeout=settings.TRANSLATION_ARGOS_INSTALL_TIMEOUT).request(
+            "POST", f"{self.service_url}/install", json={"from": source, "to": target})
+
+    def install_file(self, filename):
+        self._require_service()
+        return self._http(timeout=settings.TRANSLATION_ARGOS_INSTALL_TIMEOUT).request(
+            "POST", f"{self.service_url}/install-file", json={"filename": filename})
+
+    def install_sbd(self, source, target):
+        self._require_service()
+        return self._http(timeout=settings.TRANSLATION_ARGOS_INSTALL_TIMEOUT).request(
+            "POST", f"{self.service_url}/install-sbd", json={"from": source, "to": target})
+
+    def remove(self, source, target):
+        self._require_service()
+        return self._http(timeout=60).request("POST", f"{self.service_url}/remove", json={"from": source, "to": target})
diff --git a/apps/translation/engines/base.py b/apps/translation/engines/base.py
new file mode 100644
index 0000000..1eb52eb
--- /dev/null
+++ b/apps/translation/engines/base.py
@@ -0,0 +1,122 @@
+"""
+Contrat commun des moteurs de traduction (plan 1.3.0, lot 3).
+
+Un moteur traduit une liste de segments d'une langue vers une autre. Il ne connaît rien des projets,
+des tâches ni de la base de données : la chaîne de traitement (lot 4) ne dépend que de cette interface.
+Ajouter un moteur (Ollama plus tard) = écrire une classe qui hérite de TranslationEngine et l'inscrire
+dans registry.py.
+
+Les erreurs sont des ConnectorError (contrat de la 1.2.0) : `kind` décide du traitement (indisponible,
+configuration, requête…) et `code` porte la catégorie du journal des dysfonctionnements propre à la
+traduction (cle_refusee, quota_depasse, langue_non_prise…).
+"""
+from dataclasses import dataclass, field
+
+from apps.connectors.base import ConnectorError
+
+#: Paires validées pour la 1.3.0 (décision B2) : japonais → français et anglais → français.
+DEFAULT_PAIRS = frozenset({("ja", "fr"), ("en", "fr")})
+
+#: Phrase fictive, non confidentielle, utilisée par le bouton « Tester » quand un moteur exige un texte.
+TEST_PHRASE = "これは動作確認のための架空の文です。"
+
+
+class TranslationEngineError(ConnectorError):
+    """Erreur d'un moteur de traduction. `code` = catégorie du journal (voir apps.incidents.models.CATEGORIES)."""
+
+
+def engine_error(message, *, kind, code="", http_status=None, diagnostic=None):
+    return TranslationEngineError(message, kind=kind, code=code, http_status=http_status, diagnostic=diagnostic)
+
+
+@dataclass
+class Segment:
+    """Un texte à traduire. `id` est propre à l'appel (numéro de segment, champ de notice…)."""
+
+    id: str
+    text: str
+
+
+@dataclass
+class EngineResult:
+    """Résultat d'un appel. `translations` : identifiant de segment → texte traduit."""
+
+    translations: dict
+    chars_sent: int = 0
+    model: str = ""
+    engine_version: str = ""
+    simulated: bool = False
+    tokens_in: int = 0
+    tokens_out: int = 0
+    alerts: dict = field(default_factory=dict)  # identifiant → [alertes propres au moteur]
+
+
+@dataclass
+class EngineStatus:
+    """État présenté dans Traduction → Moteurs. `usable` : peut être choisi pour traduire maintenant."""
+
+    usable: bool
+    label: str
+    detail: str = ""
+    simulated: bool = False
+    level: str = "secondary"  # couleur Bootstrap : success, warning, danger, secondary
+
+
+class TranslationEngine:
+    code = ""
+    label = ""
+    online = True
+    needs_key = False
+    #: « native » (glossaire envoyé au service), « prompt » (entrées dans la consigne), « none » (contrôle local seul)
+    glossary_support = "none"
+    max_items = 50
+    max_chars = 5000
+    #: paramètre réseau injectable par les tests (httpx.MockTransport)
+    transport = None
+
+    def __init__(self, user, *, setting=None, ai_provider="", ai_model=""):
+        self.user = user
+        self.setting = setting
+        self.ai_provider = ai_provider
+        self.ai_model = ai_model
+
+    # --- description ------------------------------------------------------------------------------
+    def pairs(self):
+        return DEFAULT_PAIRS
+
+    def supports(self, source, target):
+        return (source, target) in self.pairs()
+
+    def status(self):
+        raise NotImplementedError
+
+    @property
+    def display_name(self):
+        return self.label
+
+    # --- traduction -------------------------------------------------------------------------------
+    def batches(self, segments):
+        """Découpe en paquets respectant les limites du service (nombre de textes, caractères)."""
+        batch, size = [], 0
+        for seg in segments:
+            n = len(seg.text)
+            if batch and (len(batch) >= self.max_items or size + n > self.max_chars):
+                yield batch
+                batch, size = [], 0
+            batch.append(seg)
+            size += n
+        if batch:
+            yield batch
+
+    def check_pair(self, source, target):
+        if not self.supports(source, target):
+            raise engine_error(f"{self.label} ne traduit pas de « {source} » vers « {target} » dans cette version.",
+                               kind="unsupported", code="langue_non_prise")
+
+    def translate(self, segments, source, target, *, glossary=None, variety="modern", context=None):
+        """Traduit `segments` (liste de Segment). `glossary` : liste de (terme source, terme cible)."""
+        raise NotImplementedError
+
+    def test(self):
+        """Vérifie le réglage sans texte réel. Retourne un message à afficher ; lève TranslationEngineError."""
+        raise NotImplementedError
diff --git a/apps/translation/engines/deepl.py b/apps/translation/engines/deepl.py
new file mode 100644
index 0000000..35159ec
--- /dev/null
+++ b/apps/translation/engines/deepl.py
@@ -0,0 +1,168 @@
+"""
+DeepL API (offre gratuite ou payante), traduction de texte.
+
+Vérifié sur la documentation officielle (13 novembre 2026) :
+- adresse https://api.deepl.com (offre payante) ou https://api-free.deepl.com (offre gratuite) ;
+- en-tête « Authorization: DeepL-Auth-Key <clé> » ;
+- POST /v2/translate : jusqu'à 50 textes par requête, corps limité à 128 Kio ; réponses dans l'ordre ;
+- GET /v2/usage : character_count et character_limit (1000000000000 = aucune limite configurée) ;
+- HTTP 456 : quota épuisé (ne pas réessayer) ; 429 : trop de requêtes (réessayer) ; 403 : authentification.
+L'offre (gratuite ou payante) est choisie par l'utilisateur ; elle n'est pas devinée à partir de la clé.
+
+Glossaires (lot 7, vérifié sur la documentation officielle le 14 novembre 2026) :
+- gestion par les points d'accès v3 : POST /v3/glossaries {"name", "dictionaries": [{"source_lang",
+  "target_lang", "entries", "entries_format": "tsv"}]} → "glossary_id" ; DELETE /v3/glossaries/{id} ;
+- la traduction reste sur /v2/translate avec "glossary_id" ; "source_lang" y est obligatoire (toujours
+  fourni ici) ; un seul glossaire par requête ;
+- langues prises en charge : GET /v3/languages?resource=glossary (liste d'objets « lang »,
+  « usable_as_source », « usable_as_target ») ;
+- entrées : pas de doublon, pas de terme vide, ni tabulation, ni retour à la ligne, ni espace en début ou
+  en fin ; 1024 octets au plus par terme.
+Aucun glossaire n'est envoyé sans action explicite de l'utilisateur (voir apps/translation/glossary.py).
+"""
+from apps.ai.crypto import decrypt_secret
+
+from ..http import TranslationHTTP
+from .base import EngineResult, EngineStatus, TranslationEngine, TranslationEngineError, engine_error
+
+BASE_URLS = {"free": "https://api-free.deepl.com", "pro": "https://api.deepl.com"}
+#: codes de langue DeepL (source / cible)
+SOURCE_CODES = {"ja": "JA", "en": "EN"}
+TARGET_CODES = {"fr": "FR"}
+NO_LIMIT = 1_000_000_000_000
+
+
+class DeepLHTTP(TranslationHTTP):
+    def classify(self, status, service_code, service_message, diagnostic):
+        if status == 456:
+            return engine_error("Quota DeepL épuisé pour la période en cours (ou plafond de la clé atteint).",
+                                kind="unavailable", code="quota_depasse", http_status=status, diagnostic=diagnostic)
+        if status == 403:
+            return engine_error("Clé DeepL refusée. Vérifiez la clé et l'offre choisie (gratuite ou payante).",
+                                kind="config", code="cle_refusee", http_status=status, diagnostic=diagnostic)
+        if status == 413:
+            return engine_error("Texte trop long pour une requête DeepL.", kind="technical", http_status=status,
+                                diagnostic=diagnostic)
+        return super().classify(status, service_code, service_message, diagnostic)
+
+
+class DeepLEngine(TranslationEngine):
+    code = "deepl"
+    label = "DeepL"
+    online = True
+    needs_key = True
+    glossary_support = "native"
+    max_items = 50
+    max_chars = 30000  # bien en deçà de 128 Kio une fois encodé en UTF-8 et en JSON
+
+    def _key(self):
+        if self.setting is None or not self.setting.has_key:
+            raise engine_error("Aucune clé DeepL n'est enregistrée.", kind="config", code="cle_refusee")
+        if self.setting.plan not in BASE_URLS:
+            raise engine_error("Choisissez l'offre DeepL (gratuite ou payante) : l'adresse du service en dépend.",
+                               kind="config")
+        return decrypt_secret(self.setting.encrypted_key)
+
+    def _http(self):
+        from django.conf import settings
+
+        return DeepLHTTP("DeepL", timeout=settings.TRANSLATION_TIMEOUTS.get("deepl"), transport=self.transport)
+
+    def _headers(self):
+        return {"Authorization": f"DeepL-Auth-Key {self._key()}"}
+
+    @property
+    def base_url(self):
+        if self.setting is None or self.setting.plan not in BASE_URLS:
+            raise engine_error("Choisissez l'offre DeepL (gratuite ou payante) : l'adresse du service en dépend.",
+                               kind="config")
+        return BASE_URLS[self.setting.plan]
+
+    def status(self):
+        s = self.setting
+        if s is None or not s.has_key:
+            return EngineStatus(False, "Non configuré", "Clé DeepL à saisir.")
+        if not s.enabled:
+            return EngineStatus(False, "Désactivé", level="secondary")
+        if s.status == "error":
+            return EngineStatus(True, "Dernier test en échec", s.last_error, level="warning")
+        if s.status == "ok":
+            return EngineStatus(True, "Testé avec succès", level="success")
+        return EngineStatus(True, "Configuré, non testé", level="secondary")
+
+    def test(self):
+        """Lit la consommation (/v2/usage) : aucun texte envoyé, aucun caractère décompté."""
+        headers = self._headers()
+        data = self._http().request("GET", f"{self.base_url}/v2/usage", headers=headers)
+        if not isinstance(data, dict) or "character_count" not in data:
+            raise engine_error("Réponse inattendue de DeepL (/v2/usage).", kind="unparsable", code="reponse_vide")
+        count, limit = int(data.get("character_count") or 0), int(data.get("character_limit") or 0)
+        self.setting.quota_info = {"character_count": count, "character_limit": limit}
+        if limit and limit < NO_LIMIT:
+            return f"Connexion réussie : {count:,} caractères utilisés sur {limit:,} pour la période.".replace(",", " ")
+        return f"Connexion réussie : {count:,} caractères utilisés ; aucune limite configurée.".replace(",", " ")
+
+    def translate(self, segments, source, target, *, glossary=None, variety="modern", context=None):
+        self.check_pair(source, target)
+        headers = self._headers()  # vérifie d'abord la clé et l'offre
+        url = f"{self.base_url}/v2/translate"
+        translations, chars = {}, 0
+        for batch in self.batches(segments):
+            body = {"text": [s.text for s in batch], "source_lang": SOURCE_CODES[source],
+                    "target_lang": TARGET_CODES[target]}
+            glossary_id = getattr(glossary, "deepl_glossary_id", "") if glossary is not None else ""
+            if glossary_id:
+                body["glossary_id"] = glossary_id
+            n = sum(len(s.text) for s in batch)
+            data = self._http().request("POST", url, headers=headers, json=body, n_texts=len(batch), n_chars=n)
+            items = data.get("translations") if isinstance(data, dict) else None
+            if not isinstance(items, list) or len(items) != len(batch):
+                raise engine_error("Réponse DeepL incomplète : le nombre de traductions ne correspond pas.",
+                                   kind="unparsable", code="reponse_vide")
+            for seg, item in zip(batch, items):
+                text = item.get("text") if isinstance(item, dict) else None
+                if not isinstance(text, str):
+                    raise engine_error("Réponse DeepL mal formée.", kind="unparsable", code="reponse_vide")
+                translations[seg.id] = text
+            chars += n
+        return EngineResult(translations, chars_sent=chars, model="DeepL API")
+
+    # --- glossaires (v3) ---------------------------------------------------------------------------
+    def glossary_pair_supported(self, source, target):
+        """Interroge DeepL (aucun texte envoyé). Lève une erreur si la réponse n'a pas la forme attendue."""
+        data = self._http().request("GET", f"{self.base_url}/v3/languages", headers=self._headers(),
+                                    params={"resource": "glossary"})
+        if not isinstance(data, list) or not all(isinstance(x, dict) and "lang" in x for x in data):
+            raise engine_error("Réponse inattendue de DeepL (langues des glossaires) : envoi annulé par prudence.",
+                               kind="unparsable", code="reponse_vide")
+        langs = {str(x["lang"]).lower(): x for x in data}
+        src, tgt = langs.get(source.lower()), langs.get(target.lower())
+        return bool(src and tgt and src.get("usable_as_source", True) and tgt.get("usable_as_target", True))
+
+    def create_glossary(self, name, source, target, lines):
+        """Crée un glossaire DeepL d'un dictionnaire (source → cible). Retourne (identifiant, nombre d'entrées)."""
+        body = {"name": name[:200], "dictionaries": [{"source_lang": source.lower(), "target_lang": target.lower(),
+                                                      "entries": "\n".join(lines), "entries_format": "tsv"}]}
+        try:
+            data = self._http().request("POST", f"{self.base_url}/v3/glossaries", headers=self._headers(), json=body,
+                                        n_texts=len(lines), n_chars=sum(len(x) for x in lines))
+        except TranslationEngineError as exc:
+            if exc.http_status in (400, 413, 422):
+                raise engine_error(f"Glossaire refusé par DeepL : {exc}", kind="technical", code="glossaire_refuse",
+                                   http_status=exc.http_status, diagnostic=exc.diagnostic) from None
+            raise
+        glossary_id = data.get("glossary_id") if isinstance(data, dict) else None
+        if not glossary_id:
+            raise engine_error("Réponse DeepL sans identifiant de glossaire.", kind="unparsable", code="glossaire_refuse")
+        count = sum(int(d.get("entry_count") or 0) for d in data.get("dictionaries") or [] if isinstance(d, dict))
+        return str(glossary_id), count
+
+    def delete_glossary(self, glossary_id):
+        """Supprime la copie distante. Retourne False si DeepL ne la connaît plus (404)."""
+        try:
+            self._http().request("DELETE", f"{self.base_url}/v3/glossaries/{glossary_id}", headers=self._headers())
+        except TranslationEngineError as exc:
+            if exc.http_status == 404:
+                return False
+            raise
+        return True
diff --git a/apps/translation/engines/google_basic.py b/apps/translation/engines/google_basic.py
new file mode 100644
index 0000000..4f89d15
--- /dev/null
+++ b/apps/translation/engines/google_basic.py
@@ -0,0 +1,97 @@
+"""
+Google Cloud Translation — édition Basic (v2), avec une clé d'API simple (décision A2).
+
+Vérifié sur la documentation officielle (13 novembre 2026) :
+- POST https://translation.googleapis.com/language/translate/v2, clé d'API en paramètre « key » ;
+- corps JSON : q (liste de textes), source, target, format (« text » pour du texte brut) ;
+- réponse : data.translations[].translatedText, dans l'ordre des textes envoyés ;
+- au plus 128 textes par requête ; Google recommande au plus 5 000 caractères par requête ;
+- pas de glossaire dans l'édition Basic : seul le contrôle terminologique local s'applique.
+À confirmer en test réel (non vérifiable ici) : la forme exacte des messages d'erreur. Le classement
+ci-dessous se fonde sur le code HTTP et sur le champ « status » de l'erreur Google.
+"""
+from apps.ai.crypto import decrypt_secret
+
+from ..http import TranslationHTTP
+from .base import TEST_PHRASE, EngineResult, EngineStatus, TranslationEngine, engine_error
+
+URL = "https://translation.googleapis.com/language/translate/v2"
+
+
+class GoogleHTTP(TranslationHTTP):
+    def classify(self, status, service_code, service_message, diagnostic):
+        message = service_message.lower()
+        if status == 400 and ("api key" in message or service_code == "INVALID_ARGUMENT" and "key" in message):
+            return engine_error("Clé Google refusée (clé non valide).", kind="config", code="cle_refusee",
+                                http_status=status, diagnostic=diagnostic)
+        if status == 403:
+            return engine_error("Accès refusé par Google : clé non autorisée, API Cloud Translation non activée "
+                                "ou facturation absente pour le projet.", kind="config", code="cle_refusee",
+                                http_status=status, diagnostic=diagnostic)
+        if status == 429 or service_code == "RESOURCE_EXHAUSTED":
+            return engine_error("Quota Google atteint : réessayez plus tard ou relevez le quota du projet.",
+                                kind="unavailable", code="quota_depasse", http_status=status, diagnostic=diagnostic)
+        return super().classify(status, service_code, service_message, diagnostic)
+
+
+class GoogleBasicEngine(TranslationEngine):
+    code = "google_basic"
+    label = "Google Traduction (Basic)"
+    online = True
+    needs_key = True
+    glossary_support = "none"
+    max_items = 128
+    max_chars = 5000
+
+    def _key(self):
+        if self.setting is None or not self.setting.has_key:
+            raise engine_error("Aucune clé Google n'est enregistrée.", kind="config", code="cle_refusee")
+        return decrypt_secret(self.setting.encrypted_key)
+
+    def _http(self):
+        from django.conf import settings
+
+        return GoogleHTTP("Google Traduction", timeout=settings.TRANSLATION_TIMEOUTS.get("google_basic"),
+                          transport=self.transport)
+
+    def status(self):
+        s = self.setting
+        if s is None or not s.has_key:
+            return EngineStatus(False, "Non configuré", "Clé Google Cloud à saisir.")
+        if not s.enabled:
+            return EngineStatus(False, "Désactivé", level="secondary")
+        if s.status == "error":
+            return EngineStatus(True, "Dernier test en échec", s.last_error, level="warning")
+        if s.status == "ok":
+            return EngineStatus(True, "Testé avec succès", level="success")
+        return EngineStatus(True, "Configuré, non testé", level="secondary")
+
+    def _call(self, texts, source, target):
+        body = {"q": texts, "source": source, "target": target, "format": "text"}
+        data = self._http().request("POST", URL, params={"key": self._key()}, json=body, n_texts=len(texts),
+                                    n_chars=sum(len(t) for t in texts))
+        items = (data.get("data") or {}).get("translations") if isinstance(data, dict) else None
+        if not isinstance(items, list) or len(items) != len(texts):
+            raise engine_error("Réponse Google incomplète : le nombre de traductions ne correspond pas.",
+                               kind="unparsable", code="reponse_vide")
+        out = []
+        for item in items:
+            text = item.get("translatedText") if isinstance(item, dict) else None
+            if not isinstance(text, str):
+                raise engine_error("Réponse Google mal formée.", kind="unparsable", code="reponse_vide")
+            out.append(text)
+        return out
+
+    def test(self):
+        """Traduit une phrase fictive fixe (une vingtaine de caractères décomptés)."""
+        result = self._call([TEST_PHRASE], "ja", "fr")[0]
+        return f"Connexion réussie. Phrase d'essai traduite : « {result} »"
+
+    def translate(self, segments, source, target, *, glossary=None, variety="modern", context=None):
+        self.check_pair(source, target)
+        translations, chars = {}, 0
+        for batch in self.batches(segments):
+            for seg, text in zip(batch, self._call([s.text for s in batch], source, target)):
+                translations[seg.id] = text
+            chars += sum(len(s.text) for s in batch)
+        return EngineResult(translations, chars_sent=chars, model="Google NMT (Basic v2)")
diff --git a/apps/translation/engines/registry.py b/apps/translation/engines/registry.py
new file mode 100644
index 0000000..3cbc06f
--- /dev/null
+++ b/apps/translation/engines/registry.py
@@ -0,0 +1,25 @@
+"""
+Registre des moteurs. Ajouter un moteur (Ollama, plus tard) : une classe dans ce dossier, une ligne ici.
+Le reste du module ne connaît que `get_engine` et `ENGINE_CLASSES`.
+"""
+from .ai import AIEngine
+from .argos import ArgosEngine
+from .deepl import DeepLEngine
+from .google_basic import GoogleBasicEngine
+
+ENGINE_CLASSES = {cls.code: cls for cls in (DeepLEngine, GoogleBasicEngine, ArgosEngine, AIEngine)}
+
+
+def get_engine(code, user, *, ai_provider="", ai_model=""):
+    """Instancie le moteur `code` pour `user`, avec son réglage (clé, offre…) s'il en a un."""
+    from ..models import EngineSetting
+
+    cls = ENGINE_CLASSES.get(code)
+    if cls is None:
+        from .base import engine_error
+
+        raise engine_error(f"Moteur de traduction inconnu : « {code} ».", kind="config")
+    setting = None
+    if code != "ai":
+        setting = EngineSetting.objects.filter(user=user, engine=code).first()
+    return cls(user, setting=setting, ai_provider=ai_provider, ai_model=ai_model)
diff --git a/apps/translation/evaluation.py b/apps/translation/evaluation.py
new file mode 100644
index 0000000..0209269
--- /dev/null
+++ b/apps/translation/evaluation.py
@@ -0,0 +1,128 @@
+"""
+Évaluation des moteurs sur un corpus de référence (plan 1.3.0, lot 10 ; cahier des charges § 15).
+
+- Le corpus est un projet du compte marqué « Corpus de référence » ; il ne doit contenir aucun texte
+  confidentiel (fourni ou validé par l'utilisateur). Les tests automatiques n'utilisent que des textes fictifs.
+- « Comparer les moteurs » prépare une tâche par moteur (nature « evaluation ») sur tous les segments du
+  corpus, sans reprise de la mémoire ni exclusion des segments validés ; RIEN n'est envoyé avant la
+  confirmation du coût estimé de chaque moteur. Les résultats sont des versions datées, conservées pour
+  des comparaisons ultérieures (Ollama plus tard).
+- L'appréciation est HUMAINE : l'utilisateur note chaque traduction (correcte, acceptable, fautive,
+  contresens) et peut commenter. Aucun score automatique n'est calculé ni présenté : la page ne montre que
+  la répartition des notes données par l'utilisateur.
+"""
+from collections import Counter, OrderedDict
+
+from django.utils import timezone
+
+from . import services
+from .models import RATINGS, TranslationJob
+from .segmentation import is_translatable
+
+LABEL_PREFIX = "Comparaison du "
+
+
+class EvaluationError(Exception):
+    pass
+
+
+def corpus_projects(user):
+    return user.translation_projects.filter(is_reference_corpus=True).order_by("title")
+
+
+def check_corpus(project, user):
+    if project.owner_id != user.pk:
+        raise EvaluationError("Seul le propriétaire du corpus peut lancer une comparaison.")
+    if not project.is_reference_corpus:
+        raise EvaluationError("Ce projet n'est pas marqué « Corpus de référence » (modifiez le projet).")
+
+
+def corpus_segments(project):
+    segments = []
+    for document in project.documents.order_by("order", "pk"):
+        segments += [s for s in document.segments.order_by("position") if is_translatable(s.source_text)]
+    return segments
+
+
+def prepare_comparison(user, project, choices):
+    """Prépare une tâche par moteur (aucun envoi). Retourne (libellé, tâches préparées, [(moteur, erreur)])."""
+    check_corpus(project, user)
+    unique = list(OrderedDict.fromkeys(c for c in choices if c))
+    if not unique:
+        raise EvaluationError("Choisissez au moins un moteur à comparer.")
+    segments = corpus_segments(project)
+    if not segments:
+        raise EvaluationError("Le corpus ne contient aucun segment à traduire : ajoutez-y un document.")
+    label = f"{LABEL_PREFIX}{timezone.localtime():%d/%m/%Y %H:%M:%S} — {project.title}"[:300]
+    jobs, errors = [], []
+    for choice in unique:
+        specs = [{"segment": s, "text": s.source_text} for s in segments]
+        try:
+            jobs.append(services._prepare(user, "evaluation", specs, project=project, choice=choice,
+                                          scope_label=label))
+        except services.TranslationUnavailable as exc:
+            errors.append((choice, str(exc)))
+    return label, jobs, errors
+
+
+def comparison_jobs(user, project, label):
+    return list(TranslationJob.objects.filter(user=user, project=project, kind="evaluation", scope_label=label)
+                .order_by("pk"))
+
+
+def comparisons(user, project):
+    """Comparaisons du corpus, de la plus récente à la plus ancienne : [(libellé, [tâches])]."""
+    groups = OrderedDict()
+    for job in (TranslationJob.objects.filter(user=user, project=project, kind="evaluation")
+                .order_by("-created_at", "pk")):
+        groups.setdefault(job.scope_label, []).append(job)
+    return [(label, sorted(jobs, key=lambda j: j.pk)) for label, jobs in groups.items()]
+
+
+def rows(jobs):
+    """Une ligne par segment : (segment, [version produite par chaque tâche, ou None])."""
+    by_job = {}
+    order = []
+    for job in jobs:
+        items = job.items.select_related("segment__document", "version").order_by("position")
+        by_job[job.pk] = {i.segment_id: i for i in items}
+        if not order:
+            order = [i.segment for i in items if i.segment_id]
+    return [(segment, [by_job[j.pk].get(segment.pk) for j in jobs]) for segment in order]
+
+
+def rating_summary(jobs):
+    """Répartition des notes HUMAINES par moteur (aucun score calculé)."""
+    out = []
+    for job in jobs:
+        versions = [i.version for i in job.items.select_related("version") if i.version_id]
+        counts = Counter(v.rating or "unrated" for v in versions)
+        out.append({"job": job, "label": services.engine_label(job), "counts": [(code, label, counts.get(code, 0)) for code, label in RATINGS],
+                    "unrated": counts.get("unrated", 0), "total": len(versions)})
+    return out
+
+
+def rate(version, user, rating, comment):
+    project = version.segment.document.project
+    if project.owner_id != user.pk:
+        raise EvaluationError("Seul le propriétaire du corpus note les traductions.")
+    if rating not in {code for code, _ in RATINGS} | {""}:
+        raise EvaluationError("Appréciation inconnue.")
+    version.rating, version.rating_comment = rating, (comment or "").strip()[:2000]
+    version.save(update_fields=["rating", "rating_comment"])
+    return version
+
+
+def confirm_all(jobs, user, *, second_confirmation=False, terms_acknowledged=False):
+    """Confirme les tâches préparées ; retourne (lancées, [(tâche, erreur)])."""
+    started, errors = [], []
+    for job in jobs:
+        if job.status != "draft":
+            continue
+        try:
+            services.confirm(job, user, second_confirmation=second_confirmation,
+                             terms_acknowledged=terms_acknowledged)
+            started.append(job)
+        except services.TranslationUnavailable as exc:
+            errors.append((job, str(exc)))
+    return started, errors
