+++ b/apps/translation/views/projects.py
@@ -0,0 +1,127 @@
+"""Projets de traduction : liste, création, modification, page du projet, suppression, copie d'une notice."""
+from django.contrib import messages
+from django.db.models import Count, Q
+from django.http import Http404
+from django.shortcuts import get_object_or_404, redirect, render
+from django.views.decorators.http import require_POST
+
+from apps.catalog.models import Record
+from apps.core.audit import log_action
+from apps.core.permissions import researcher_required
+
+from .. import projects as P
+from ..forms import ProjectForm
+from ..models import TranslationProject
+from ..permissions import (can_edit_project, can_view_project, can_view_project_metadata, projects_metadata_only_for,
+                           projects_with_content_for, require)
+
+
+def _annotated(qs):
+    return qs.select_related("owner").annotate(
+        n_docs=Count("documents", distinct=True), n_segments=Count("documents__segments", distinct=True),
+        n_validated=Count("documents__segments", filter=Q(documents__segments__state="validated"), distinct=True))
+
+
+def get_project_for(request, pk, *, edit=False):
+    """Projet dont l'utilisateur peut voir (ou modifier) le contenu ; 404 sinon (l'existence n'est pas révélée)."""
+    project = get_object_or_404(TranslationProject.objects.select_related("owner"), pk=pk)
+    allowed = can_edit_project(request.user, project) if edit else can_view_project(request.user, project)
+    if not allowed:
+        raise Http404
+    return project
+
+
+@researcher_required
+def project_list(request):
+    visible = projects_with_content_for(request.user)
+    return render(request, "translation/project_list.html", {
+        "mine": _annotated(visible.filter(owner=request.user)),
+        "others": _annotated(visible.exclude(owner=request.user)),
+        "hidden": _annotated(projects_metadata_only_for(request.user)),
+    })
+
+
+@researcher_required
+def project_create(request):
+    form = ProjectForm(request.POST or None, user=request.user)
+    if request.method == "POST" and form.is_valid():
+        project = form.save(commit=False)
+        project.owner = request.user
+        project.save()
+        log_action(request, "translation.project_created", project,
+                   f"Projet « {project.title} »{' (confidentiel)' if project.confidential else ''}")
+        messages.success(request, "Projet créé. Ajoutez maintenant un document.")
+        return redirect("translation:project_detail", pk=project.pk)
+    return render(request, "translation/project_form.html", {"form": form, "project": None})
+
+
+@researcher_required
+def project_edit(request, pk):
+    project = get_project_for(request, pk, edit=True)
+    form = ProjectForm(request.POST or None, instance=project, user=project.owner)
+    if request.method == "POST" and form.is_valid():
+        form.save()
+        log_action(request, "translation.project_updated", project, f"Projet « {project.title} »")
+        messages.success(request, "Projet enregistré.")
+        return redirect("translation:project_detail", pk=project.pk)
+    return render(request, "translation/project_form.html", {"form": form, "project": project})
+
+
+@researcher_required
+def project_detail(request, pk):
+    project = get_object_or_404(TranslationProject.objects.select_related("owner", "collection"), pk=pk)
+    if not can_view_project(request.user, project):
+        if can_view_project_metadata(request.user, project):
+            # Décision D3 : projet confidentiel d'un autre compte → titre, propriétaire, taille seulement.
+            meta = _annotated(TranslationProject.objects.filter(pk=project.pk)).get()
+            return render(request, "translation/project_metadata.html", {"project": meta})
+        raise Http404
+    documents = project.documents.annotate(
+        n_segments=Count("segments", distinct=True),
+        n_validated=Count("segments", filter=Q(segments__state="validated"), distinct=True),
+        n_alert=Count("segments", filter=Q(segments__state="alert"), distinct=True))
+    from .. import glossary as G
+    from .glossaries import linkable_glossaries
+
+    can_edit = can_edit_project(request.user, project)
+    return render(request, "translation/project_detail.html", {
+        "project": project, "documents": documents, "jobs": project.jobs.filter(user=request.user)[:10],
+        "can_edit": can_edit,
+        "glossary_links": project.glossary_links.select_related("glossary").annotate(n_entries=Count("glossary__entries")),
+        "linkable": linkable_glossaries(request, project) if can_edit else [],
+        "contradictions": G.project_contradictions(project),
+    })
+
+
+@researcher_required
+@require_POST
+def project_delete(request, pk):
+    project = get_object_or_404(TranslationProject, pk=pk, owner=request.user)  # propriétaire seulement
+    if request.POST.get("confirm_title", "").strip() != project.title.strip():
+        messages.error(request, "Pour supprimer le projet, recopiez exactement son titre.")
+        return redirect("translation:project_detail", pk=project.pk)
+    title = project.title
+    log_action(request, "translation.project_deleted", project, f"Projet « {title} » supprimé")
+    project.delete()
+    messages.info(request, f"Projet « {title} » supprimé avec ses documents et traductions.")
+    return redirect("translation:project_list")
+
+
+@researcher_required
+@require_POST
+def copy_record(request, record_id):
+    """Décision D2 : copie le texte d'une notice dans un projet (documents), sans contenu éditorial automatique."""
+    record = get_object_or_404(Record, record_id=record_id)
+    project = get_project_for(request, request.POST.get("project"), edit=True)
+    fields = [f for f in request.POST.getlist("fields") if f] or ["original_title", "description_original"]
+    try:
+        documents = P.copy_record_to_project(record, project, fields)
+    except P.ProjectError as exc:
+        messages.error(request, str(exc))
+        return redirect("translation:record_translations", record_id=record.record_id)
+    messages.success(request, f"{len(documents)} document(s) créé(s) dans « {project.title} ».")
+    return redirect("translation:document_workbench", pk=documents[0].pk)
+
+
+def require_edit(request, project):
+    require(can_edit_project(request.user, project))
diff --git a/apps/translation/views/records.py b/apps/translation/views/records.py
new file mode 100644
index 0000000..87f8d30
--- /dev/null
+++ b/apps/translation/views/records.py
@@ -0,0 +1,124 @@
+"""
+Traduction des notices (lot 5).
+
+- Préparer la traduction d'une ou plusieurs notices (fiche, sélection de la Bibliothèque) : champs (titre et
+  description ; sujets et lieu en option, décision C1), moteur par défaut ou deuxième moteur → tâche à confirmer.
+- Consulter, pour une notice, l'original, la traduction adoptée et toutes les propositions (versions), puis
+  valider (= adopter dans la notice, décision du 13 novembre 2026), rejeter ou supprimer. Comme sur la fiche,
+  valider et rejeter sont réservés à l'administrateur (C2) ; le chercheur propose.
+Les traductions restent dans la couche éditoriale existante (EditorialContent) ; la notice source n'est jamais
+modifiée (seuls les champs « traduits » de la couche éditoriale reçoivent la traduction adoptée).
+"""
+from django.contrib import messages
+from django.core.exceptions import PermissionDenied
+from django.shortcuts import get_object_or_404, redirect, render
+from django.urls import reverse
+from django.views.decorators.http import require_POST
+
+from apps.catalog.models import EditorialContent, Record
+from apps.catalog.services import ADOPTABLE_TRANSLATION_FIELDS, validate_translation
+from apps.core.audit import log_action
+from apps.core.permissions import researcher_required
+
+from .. import services
+
+DEFAULT_FIELDS = ("original_title", "description_original")
+
+
+def _ids(request):
+    raw = request.POST.get("records") if request.method == "POST" else request.GET.get("records", "")
+    return [i for i in (raw or "").split(",") if i][:500]
+
+
+def _engine_options(user):
+    options = []
+    for which, label in (("default", "Moteur par défaut"), ("second", "Deuxième moteur")):
+        choice = services.resolve_choice(user, which=which)
+        if choice:
+            engine = choice.engine(user)
+            options.append({"value": which, "label": label, "name": engine.display_name, "status": engine.status(),
+                            "online": engine.online})
+    return options
+
+
+@researcher_required
+def records_prepare(request):
+    ids = _ids(request)
+    records = list(Record.objects.filter(record_id__in=ids).select_related("catalogue"))
+    pref = services.ensure_preference(request.user)
+    defaults = list(DEFAULT_FIELDS) + (["subjects_original"] if pref.translate_subjects else []) + (
+        ["place_original"] if pref.translate_place else [])
+    if request.method == "POST":
+        fields = [f for f in request.POST.getlist("fields") if f in services.RECORD_FIELDS]
+        which = request.POST.get("engine", "default")
+        choice = services.resolve_choice(request.user, which="second" if which == "second" else "default")
+        if not records:
+            messages.error(request, "Aucune notice sélectionnée.")
+        elif not fields:
+            messages.error(request, "Choisissez au moins un champ à traduire.")
+        else:
+            try:
+                job = services.prepare_records_job(request.user, records, fields, choice=choice)
+                log_action(request, "translation.records_prepared", job, f"{len(records)} notice(s), {fields}")
+                return redirect("translation:job_detail", pk=job.pk)
+            except services.TranslationUnavailable as exc:
+                messages.error(request, str(exc))
+        defaults = fields or defaults
+    return render(request, "translation/records_prepare.html", {
+        "records": records, "ids": ",".join(r.record_id for r in records), "fields": services.RECORD_FIELDS,
+        "selected": defaults, "engines": _engine_options(request.user),
+        "kanbun": [r for r in records if r.language == "lzh"],
+    })
+
+
+@researcher_required
+def record_translations(request, record_id):
+    record = get_object_or_404(Record.objects.select_related("catalogue"), record_id=record_id)
+    proposals = (EditorialContent.objects.filter(record=record, kind="translation")
+                 .select_related("ai_task", "author").order_by("-created_at"))
+    rows = []
+    for field, label in services.RECORD_FIELDS.items():
+        original = (getattr(record, field, "") or "").strip()
+        adopted_field = ADOPTABLE_TRANSLATION_FIELDS.get(field)
+        rows.append({
+            "field": field, "label": label, "original": original,
+            "adopted": getattr(record, adopted_field, "") if adopted_field else "",
+            "adopted_origin": getattr(record, f"{adopted_field}_origin", "") if adopted_field else "",
+            "adoptable": bool(adopted_field),
+            "proposals": [p for p in proposals if p.target_field == field],
+        })
+    from ..models import TranslationProject
+
+    return render(request, "translation/record_translations.html", {
+        "record": record, "rows": rows, "engines": _engine_options(request.user),
+        "kanbun": record.language == "lzh",
+        "my_projects": TranslationProject.objects.filter(owner=request.user).order_by("title"),
+    })
+
+
+@researcher_required
+@require_POST
+def record_decide(request, pk):
+    ed = get_object_or_404(EditorialContent.objects.select_related("record"), pk=pk, kind="translation")
+    action = request.POST.get("action")
+    back = reverse("translation:record_translations", args=[ed.record.record_id])
+    if action in ("validate", "reject") and not request.user.is_admin_role:
+        raise PermissionDenied("Validation réservée à l'administrateur.")
+    if action == "validate":
+        field = validate_translation(ed, request.user)
+        log_action(request, "editorial.validate", ed, "Traduction validée et adoptée" if field else "Traduction validée")
+        messages.success(request, "Traduction validée" + (" et recopiée dans la fiche." if field else "."))
+    elif action == "reject":
+        ed.status = "rejected"
+        ed.save(update_fields=["status", "updated_at"])
+        log_action(request, "editorial.reject", ed, ed.get_kind_display())
+        messages.info(request, "Traduction rejetée (conservée dans l'historique).")
+    elif action == "delete":
+        if not (ed.author_id == request.user.pk or request.user.is_admin_role):
+            raise PermissionDenied("Seuls l'auteur et l'administrateur peuvent supprimer cette proposition.")
+        if ed.status == "validated" and not request.POST.get("confirm_validated"):
+            messages.error(request, "Cette traduction est validée : confirmez sa suppression.")
+            return redirect(back)
+        ed.delete()
+        messages.info(request, "Proposition supprimée.")
+    return redirect(back)
