diff --git a/templates/translation/job_list.html b/templates/translation/job_list.html
new file mode 100644
index 0000000..83b2b04
--- /dev/null
+++ b/templates/translation/job_list.html
@@ -0,0 +1,18 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Tâches{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Tâches</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-hourglass-split"></i> Tâches de traduction</h1>
+  <p>Chaque traduction, même d'un seul champ, est une tâche : confirmation, suivi, reprise après interruption.</p></div></div>
+{% if jobs %}
+<table class="table table-sm align-middle"><thead><tr><th>N°</th><th>Créée</th><th>Portée</th><th>Moteur</th><th>État</th><th>Avancement</th></tr></thead><tbody>
+{% for job, stale, label in jobs %}<tr>
+  <td><a href="{% url 'translation:job_detail' job.pk %}">{{ job.pk }}</a></td>
+  <td class="small text-muted">{{ job.created_at|date:"d/m/Y H:i" }}</td>
+  <td>{{ job.scope_label }}</td><td>{{ label }}</td>
+  <td>{% if stale %}<span class="badge text-bg-warning">Interrompue ?</span>{% else %}{{ job.get_status_display }}{% endif %}</td>
+  <td class="small">{{ job.done_items }} / {{ job.total_items }}{% if job.failed_items %} · <span class="text-danger">{{ job.failed_items }} échec(s)</span>{% endif %}{% if job.skipped_items %} · {{ job.skipped_items }} non envoyé(s){% endif %}</td>
+</tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted">Aucune tâche pour l'instant.</p>{% endif %}
+{% endblock %}
diff --git a/templates/translation/local_engines.html b/templates/translation/local_engines.html
new file mode 100644
index 0000000..b5d29cc
--- /dev/null
+++ b/templates/translation/local_engines.html
@@ -0,0 +1,51 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Moteurs locaux{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:engines' %}">Moteurs</a></li><li class="breadcrumb-item active">Moteurs locaux</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-box-seam"></i> Moteurs locaux — Argos Translate</h1>
+  <p>Argos Translate traduit sur votre ordinateur, sans Internet. Il fonctionne dans un service Docker facultatif, démarré par
+  <code>docker compose --profile hors-ligne up -d --build</code>. Ses paquets de langues sont téléchargés <strong>seulement si vous le décidez</strong>, ou installés depuis un fichier.</p></div></div>
+
+<section class="card-soft mb-3"><h2 class="h5">Service</h2>
+{% if health %}<p class="mb-1"><span class="badge text-bg-success">En service</span> Argos Translate {{ health.argos_version }}{% if health.busy %} · <span class="text-warning">installation en cours</span>{% endif %}</p>
+{% else %}<p class="mb-1"><span class="badge text-bg-warning">Indisponible</span> {{ problem }}</p>
+<p class="small text-muted mb-0">Tant que le service et ses paquets ne sont pas installés, Argos fonctionne en <strong>mode simulé</strong> : aucune traduction réelle, mention « Simulation » sur chaque résultat.</p>{% endif %}
+</section>
+
+<section class="card-soft mb-3"><h2 class="h5">Paquets nécessaires</h2>
+<p class="small text-muted">L'index Argos ne propose pas de paquet direct japonais → français : la traduction passe par l'anglais (deux paquets). La version des paquets utilisés est enregistrée avec chaque traduction.</p>
+<table class="table table-sm" style="max-width:700px"><thead><tr><th>Paire</th><th>Paquets</th></tr></thead><tbody>
+{% for row in needed %}<tr><td>{{ row.pair }}</td><td>{% for p in row.packages %}{{ p.code }} {% if p.installed %}<span class="badge text-bg-success">installé, v{{ p.installed.version }}</span>{% else %}<span class="badge text-bg-secondary">absent</span>{% endif %}{% if not forloop.last %} · {% endif %}{% endfor %}</td></tr>{% endfor %}
+</tbody></table>
+{% if health.packages %}<h3 class="h6">Paquets installés</h3><ul class="small">{% for p in health.packages %}<li>{{ p.from }}→{{ p.to }} (version {{ p.version }}{% if p.name %}, {{ p.name }}{% endif %})
+  {% if p.sbd_ready is False %}<span class="badge text-bg-warning">modèle de découpage en phrases manquant</span>
+    {% if can_manage %}<form method="post" action="{% url 'translation:argos_install_sbd' %}" class="d-inline-flex gap-1 align-items-center ms-1">{% csrf_token %}<input type="hidden" name="package" value="{{ p.from }}→{{ p.to }}">
+      <input class="form-check-input" type="checkbox" name="confirm" value="1" id="sbd-{{ forloop.counter }}" aria-label="Confirmer le téléchargement"><label class="small" for="sbd-{{ forloop.counter }}">je choisis de le télécharger (Internet, quelques Mo)</label>
+      <button class="btn btn-sm btn-outline-primary py-0">Télécharger</button></form>{% endif %}
+    <div class="text-muted">Ce paquet ne contient pas son modèle de découpage en phrases : sans lui, il ne peut pas traduire (la traduction n'utilise jamais Internet).</div>{% endif %}
+  {% if can_manage %}<form method="post" action="{% url 'translation:argos_remove' %}" class="d-inline">{% csrf_token %}<input type="hidden" name="package" value="{{ p.from }}→{{ p.to }}"><button class="btn btn-sm btn-link text-danger p-0 ms-2" data-confirm="Désinstaller le paquet {{ p.from }}→{{ p.to }} ?">Désinstaller</button></form>{% endif %}</li>{% endfor %}</ul>{% endif %}
+</section>
+
+{% if can_manage %}
+<section class="card-soft mb-3"><h2 class="h5">Télécharger depuis l'index Argos (Internet)</h2>
+  <p class="small">Étape 1 : consulter la liste des paquets proposés (le service interroge l'index Argos sur Internet ; <strong>rien n'est téléchargé</strong> à ce stade). Étape 2 : choisir les paquets et confirmer.</p>
+  <form method="post" action="{% url 'translation:argos_index' %}">{% csrf_token %}<button class="btn btn-sm btn-outline-primary" {% if not health %}disabled{% endif %}>Consulter l'index Argos</button></form>
+</section>
+<section class="card-soft mb-3"><h2 class="h5">Installer depuis un fichier (sans Internet)</h2>
+  <p class="small">Fichier de paquet <code>.argosmodel</code> obtenu par ailleurs (par exemple téléchargé sur un autre ordinateur). Il est copié vers le service, installé, puis la copie de transfert est effacée ; votre fichier d'origine n'est pas touché.</p>
+  <form method="post" action="{% url 'translation:argos_install_file' %}" enctype="multipart/form-data" class="d-flex gap-2" style="max-width:700px">{% csrf_token %}
+    <input type="file" name="file" accept=".argosmodel" class="form-control form-control-sm" aria-label="Fichier .argosmodel" required>
+    <button class="btn btn-sm btn-outline-primary text-nowrap" {% if not health %}disabled{% endif %}>Installer</button></form>
+</section>
+{% else %}<p class="small text-muted">Les paquets sont communs à toute l'installation : seul un administrateur peut les télécharger, les installer ou les désinstaller.</p>{% endif %}
+
+<section id="argos-jobs" class="mb-3" {% if running %}hx-get="{% url 'translation:local_engines' %}" hx-trigger="every 5s" hx-select="#argos-jobs" hx-swap="outerHTML"{% endif %}>
+<h2 class="h5">Installations récentes</h2>
+{% if jobs %}<table class="table table-sm align-middle"><thead><tr><th>N°</th><th>Opération</th><th>Par</th><th>État</th><th>Détail</th>{% if can_manage %}<th></th>{% endif %}</tr></thead><tbody>
+{% for job, stale in jobs %}<tr><td>{{ job.pk }}</td><td class="small">{{ job.scope_label }}<div class="text-muted">{{ job.created_at|date:"d/m/Y H:i" }}</div></td><td class="small">{{ job.user|default:"—" }}</td>
+  <td>{% if stale %}<span class="badge text-bg-warning">interrompue</span>{% else %}{{ job.get_status_display }}{% endif %}</td>
+  <td class="small">{% for item in job.items.all %}<div>{{ item.record_field|cut:"index:"|cut:"fichier:" }} : {{ item.get_status_display }}{% if item.error_message %} — {{ item.error_message }}{% endif %}</div>{% endfor %}</td>
+  {% if can_manage %}<td>{% if stale or job.status == 'failed' %}<form method="post" action="{% url 'translation:argos_job_action' job.pk %}">{% csrf_token %}<button class="btn btn-sm btn-outline-primary" name="action" value="relaunch">Reprendre</button></form>{% endif %}</td>{% endif %}</tr>{% endfor %}
+</tbody></table>{% else %}<p class="small text-muted">Aucune.</p>{% endif %}
+</section>
+{% endblock %}
diff --git a/templates/translation/memory.html b/templates/translation/memory.html
new file mode 100644
index 0000000..d4023e7
--- /dev/null
+++ b/templates/translation/memory.html
@@ -0,0 +1,28 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Mémoire de traduction{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Mémoire de traduction</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-archive"></i> Mémoire de traduction</h1>
+  <p>Paires validées de vos projets ({{ n_total }}, dont {{ n_excluded }} exclue(s)). Un segment identique (après normalisation des largeurs de caractères et des espaces) reprend la traduction validée comme <em>proposition</em>, jamais comme validation, et sans appel au moteur. Votre mémoire n'est visible que par vous.</p></div></div>
+<form method="get" class="d-flex flex-wrap gap-2 mb-3">
+  <input name="q" value="{{ q }}" class="form-control form-control-sm" style="max-width:320px" placeholder="Rechercher dans l'original ou la traduction" aria-label="Rechercher">
+  <select name="projet" class="form-select form-select-sm" style="width:auto" aria-label="Projet"><option value="">Tous les projets</option>{% for p in projects %}<option value="{{ p.pk }}" {% if project == p.pk|stringformat:"d" %}selected{% endif %}>{{ p.title }}</option>{% endfor %}</select>
+  <select name="etat" class="form-select form-select-sm" style="width:auto" aria-label="État"><option value="">Toutes</option><option value="actives" {% if state == "actives" %}selected{% endif %}>Utilisées par la mémoire</option><option value="exclues" {% if state == "exclues" %}selected{% endif %}>Exclues</option></select>
+  <button class="btn btn-sm btn-outline-secondary">Filtrer</button></form>
+<table class="table table-sm align-middle"><thead><tr><th>Original</th><th>Traduction validée</th><th>Projet</th><th>Origine</th><th>Validée le</th><th></th></tr></thead><tbody>
+{% for v in page %}<tr class="{% if v.excluded_from_memory %}text-muted{% endif %}">
+  <td style="white-space:pre-wrap" lang="{{ v.segment.document.project.source_lang }}">{{ v.segment.source_text|truncatechars:160 }}</td>
+  <td style="white-space:pre-wrap">{{ v.text|truncatechars:200 }}{% if v.simulated %} <span class="chip chip-warn">Simulation</span>{% endif %}</td>
+  <td class="small"><a href="{% url 'translation:segment_detail' v.segment.pk %}">{{ v.segment.document.project.title }}</a></td>
+  <td class="small">{{ v.get_origin_display }}</td><td class="small">{{ v.decided_at|date:"d/m/Y" }}</td>
+  <td><form method="post" action="{% url 'translation:memory_toggle' v.pk %}">{% csrf_token %}<input type="hidden" name="next" value="{{ request.get_full_path }}">
+    {% if v.excluded_from_memory %}<span class="badge text-bg-secondary">exclue</span> <button class="btn btn-sm btn-link" name="action" value="include">Réintégrer</button>
+    {% else %}<button class="btn btn-sm btn-link text-danger" name="action" value="exclude">Exclure</button>{% endif %}</form></td></tr>
+{% empty %}<tr><td colspan="6" class="text-muted">Aucune paire validée{% if q or state or project %} pour ce filtre{% endif %}.</td></tr>{% endfor %}
+</tbody></table>
+{% if page.has_other_pages %}<nav><ul class="pagination pagination-sm">
+{% if page.has_previous %}<li class="page-item"><a class="page-link" href="?q={{ q|urlencode }}&etat={{ state }}&projet={{ project }}&page={{ page.previous_page_number }}">Précédente</a></li>{% endif %}
+<li class="page-item disabled"><span class="page-link">{{ page.number }} / {{ page.paginator.num_pages }}</span></li>
+{% if page.has_next %}<li class="page-item"><a class="page-link" href="?q={{ q|urlencode }}&etat={{ state }}&projet={{ project }}&page={{ page.next_page_number }}">Suivante</a></li>{% endif %}
+</ul></nav>{% endif %}
+{% endblock %}
diff --git a/templates/translation/project_detail.html b/templates/translation/project_detail.html
new file mode 100644
index 0000000..b15cb29
--- /dev/null
+++ b/templates/translation/project_detail.html
@@ -0,0 +1,50 @@
+{% extends "base.html" %}
+{% block title %}{{ project.title }} — Traduction{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_list' %}">Projets</a></li><li class="breadcrumb-item active">{{ project.title }}</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1>{{ project.title }}{% if project.confidential %} <span class="badge text-bg-dark fs-6"><i class="bi bi-lock-fill"></i> confidentiel</span>{% endif %}</h1>
+  <p>{{ project.get_source_lang_display }} → {{ project.get_target_lang_display }} · propriétaire : {{ project.owner }}{% if project.collection %} · dossier : <a href="{{ project.collection.get_absolute_url }}">{{ project.collection.title }}</a>{% endif %}</p>
+  {% if project.description %}<p class="text-muted">{{ project.description }}</p>{% endif %}
+  {% if project.confidential %}<p class="small">Moteurs en ligne refusés pour ce projet : seuls les moteurs locaux (Argos) sont utilisables.</p>{% endif %}</div>
+  {% if can_edit %}<div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{% url 'translation:project_edit' project.pk %}">Modifier</a>
+    {% if project.owner == user %}<a class="btn btn-outline-secondary" href="{% url 'translation:project_export' project.pk %}"><i class="bi bi-download"></i> Exporter</a>{% endif %}
+    <a class="btn btn-primary" href="{% url 'translation:document_add' project.pk %}"><i class="bi bi-plus-lg"></i> Ajouter un document</a></div>{% endif %}</div>
+
+<h2 class="h5">Documents</h2>
+{% if documents %}
+<table class="table table-sm align-middle"><thead><tr><th>Titre</th><th>Provenance</th><th>Variété</th><th>Avancement</th></tr></thead><tbody>
+{% for d in documents %}<tr><td><a href="{% url 'translation:document_workbench' d.pk %}">{{ d.title }}</a></td>
+  <td class="small">{{ d.get_source_kind_display }}{% if d.source_filename and d.source_kind != 'record' %} ({{ d.source_filename }}){% endif %}{% if d.encoding_confidence == 'uncertain' %} <span class="text-warning">encodage confirmé à la main</span>{% endif %}</td>
+  <td class="small">{{ d.get_variety_display }}</td>
+  <td class="small">{{ d.n_validated }} validé(s) / {{ d.n_segments }}{% if d.n_alert %} · <span class="text-warning">{{ d.n_alert }} en alerte</span>{% endif %}</td></tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted">Aucun document.</p>{% endif %}
+
+<h2 class="h5 mt-4" id="glossaires">Glossaires du projet</h2>
+{% if glossary_links %}
+<table class="table table-sm align-middle" style="max-width:900px"><thead><tr><th>Priorité</th><th>Glossaire</th><th>Entrées</th><th>Version</th>{% if can_edit %}<th></th>{% endif %}</tr></thead><tbody>
+{% for link in glossary_links %}<tr><td>{{ forloop.counter }}</td><td><a href="{% url 'translation:glossary_detail' link.glossary.pk %}">{{ link.glossary.name }}</a>{% if link.glossary.source_lang != project.source_lang %} <span class="text-warning small">paire de langues différente : ignoré</span>{% endif %}</td><td>{{ link.n_entries }}</td><td>{{ link.glossary.version }}</td>
+  {% if can_edit %}<td class="text-nowrap"><form method="post" action="{% url 'translation:project_glossaries' project.pk %}" class="d-inline">{% csrf_token %}<input type="hidden" name="link" value="{{ link.pk }}">
+    {% if not forloop.first %}<button class="btn btn-sm btn-link" name="action" value="up" aria-label="Monter">↑</button>{% endif %}{% if not forloop.last %}<button class="btn btn-sm btn-link" name="action" value="down" aria-label="Descendre">↓</button>{% endif %}
+    <button class="btn btn-sm btn-link text-danger" name="action" value="remove">Retirer</button></form></td>{% endif %}</tr>{% endfor %}
+</tbody></table>
+<p class="small text-muted">En cas de doublon, le glossaire le plus haut dans la liste l'emporte.</p>
+{% else %}<p class="text-muted small">Aucun glossaire.</p>{% endif %}
+{% if contradictions %}<div class="alert alert-warning small" style="max-width:900px"><strong>Contradictions entre glossaires</strong> (même terme, traductions différentes ; la première est retenue) :<ul class="mb-0">
+{% for form, uses in contradictions %}<li><span lang="{{ project.source_lang }}">{{ form }}</span> : {% for g, t in uses %}« {{ t }} » ({{ g.name }}){% if not forloop.last %} ; {% endif %}{% endfor %}</li>{% endfor %}</ul></div>{% endif %}
+{% if can_edit and linkable %}<form method="post" action="{% url 'translation:project_glossaries' project.pk %}" class="d-flex gap-2 mb-3" style="max-width:600px">{% csrf_token %}
+  <select name="glossary" class="form-select form-select-sm" aria-label="Glossaire à ajouter">{% for g in linkable %}<option value="{{ g.pk }}">{{ g.name }}{% if g.owner != user %} ({{ g.owner }}){% endif %}</option>{% endfor %}</select>
+  <button class="btn btn-sm btn-outline-primary text-nowrap" name="action" value="add">Ajouter au projet</button></form>
+{% elif can_edit %}<p class="small"><a href="{% url 'translation:glossary_create' %}">Créer un glossaire</a> ({{ project.get_source_lang_display }} → {{ project.get_target_lang_display }}) pour l'ajouter à ce projet.</p>{% endif %}
+
+{% if jobs %}<h2 class="h5 mt-4">Mes dernières tâches sur ce projet</h2>
+<ul class="small">{% for j in jobs %}<li><a href="{% url 'translation:job_detail' j.pk %}">N° {{ j.pk }}</a> — {{ j.get_engine_display }} — {{ j.get_status_display }} — {{ j.done_items }} / {{ j.total_items }}</li>{% endfor %}</ul>{% endif %}
+
+{% if project.owner == user %}
+<details class="mt-4"><summary class="text-danger small">Supprimer le projet</summary>
+  <form method="post" action="{% url 'translation:project_delete' project.pk %}" class="card-soft mt-2" style="max-width:600px">{% csrf_token %}
+    <p class="small">Supprime le projet, ses documents, segments et toutes leurs traductions. Les notices ne sont pas touchées. Recopiez le titre pour confirmer.</p>
+    <input name="confirm_title" class="form-control form-control-sm mb-2" aria-label="Titre du projet">
+    <button class="btn btn-sm btn-danger">Supprimer définitivement</button></form></details>
+{% endif %}
+{% endblock %}
diff --git a/templates/translation/project_export.html b/templates/translation/project_export.html
new file mode 100644
index 0000000..376740d
--- /dev/null
+++ b/templates/translation/project_export.html
@@ -0,0 +1,22 @@
+{% extends "base.html" %}
+{% block title %}Exporter — {{ project.title }}{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:exports' %}">Exports</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_detail' project.pk %}">{{ project.title }}</a></li><li class="breadcrumb-item active">Exporter</li></ol></nav>{% endblock %}
+{% block content %}
+<h1>Exporter « {{ project.title }} »</h1>
+{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
+{% if project.confidential %}<div class="alert alert-secondary small"><i class="bi bi-lock-fill"></i> Projet confidentiel : le fichier exporté contient le texte en clair et l'indique dans son en-tête. Maîtrisez sa diffusion.</div>{% endif %}
+{% if preview %}{% with v=preview.fallback %}<p class="small">Projet entier : {{ v.translatable|length }} segment(s) à traduire — {{ v.count_validated }} validé(s), {{ v.count_proposed }} avec une proposition seulement, {{ v.count_untranslated }} sans traduction{% if v.simulated_count %} ; <span class="text-warning">{{ v.simulated_count }} traduction(s) simulée(s)</span>{% endif %}.</p>{% endwith %}{% endif %}
+<form method="get" class="card-soft" style="max-width:900px">
+  <div class="mb-3"><label class="form-label" for="document">Contenu</label>
+    <select id="document" name="document" class="form-select"><option value="">Tout le projet ({{ documents|length }} document(s))</option>
+      {% for d in documents %}<option value="{{ d.pk }}" {% if request.GET.document == d.pk|stringformat:"d" %}selected{% endif %}>{{ d.title }}</option>{% endfor %}</select></div>
+  <fieldset class="mb-3"><legend class="form-label fs-6">Format</legend>
+    {% for code, f in formats.items %}<div class="form-check"><input class="form-check-input" type="radio" name="format" id="f-{{ code }}" value="{{ code }}" {% if forloop.first %}checked{% endif %}>
+      <label class="form-check-label" for="f-{{ code }}">{{ f.0 }}</label></div>{% endfor %}</fieldset>
+  <fieldset class="mb-3"><legend class="form-label fs-6">Traductions exportées</legend>
+    {% for code, label in modes.items %}<div class="form-check"><input class="form-check-input" type="radio" name="mode" id="m-{{ code }}" value="{{ code }}" {% if forloop.first %}checked{% endif %}>
+      <label class="form-check-label" for="m-{{ code }}">{{ label }}</label></div>{% endfor %}</fieldset>
+  <button class="btn btn-primary"><i class="bi bi-download"></i> Télécharger</button>
+</form>
+<p class="small text-muted mt-3">Chaque fichier indique en en-tête les moteurs utilisés et la proportion de segments validés. Une traduction produite par un moteur simulé porte la mention « Simulation ». L'original exporté est le texte importé, jamais modifié.</p>
+{% endblock %}
diff --git a/templates/translation/project_form.html b/templates/translation/project_form.html
new file mode 100644
index 0000000..29ab82b
--- /dev/null
+++ b/templates/translation/project_form.html
@@ -0,0 +1,22 @@
+{% extends "base.html" %}
+{% block title %}{% if project %}Modifier le projet{% else %}Nouveau projet{% endif %}{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_list' %}">Projets</a></li><li class="breadcrumb-item active">{% if project %}{{ project.title }}{% else %}Nouveau{% endif %}</li></ol></nav>{% endblock %}
+{% block content %}
+<h1>{% if project %}Modifier « {{ project.title }} »{% else %}Nouveau projet de traduction{% endif %}</h1>
+<form method="post" class="card-soft" style="max-width:900px">{% csrf_token %}
+  {{ form.non_field_errors }}
+  <div class="mb-2">{{ form.title.label_tag }}{{ form.title }}{{ form.title.errors }}</div>
+  <div class="mb-2">{{ form.description.label_tag }}{{ form.description }}</div>
+  <div class="row g-2 mb-2"><div class="col-md-4">{{ form.source_lang.label_tag }}{{ form.source_lang }}</div>
+    <div class="col-md-4">{{ form.target_lang.label_tag }}{{ form.target_lang }}</div>
+    <div class="col-md-4">{{ form.collection.label_tag }}{{ form.collection }}</div></div>
+  <div class="form-check mb-1">{{ form.confidential }} <label class="form-check-label" for="{{ form.confidential.id_for_label }}"><strong>{{ form.confidential.label }}</strong></label>
+    <div class="form-text">{{ form.confidential.help_text }}</div>{{ form.confidential.errors }}</div>
+  <div class="form-check mb-3">{{ form.is_reference_corpus }} <label class="form-check-label" for="{{ form.is_reference_corpus.id_for_label }}">{{ form.is_reference_corpus.label }}</label></div>
+  <h2 class="h6">Moteurs propres au projet (facultatif)</h2>
+  <div class="row g-2">
+    {% for f in form %}{% if "engine" in f.name or "ai_" in f.name %}<div class="col-md-4">{{ f.label_tag }}{{ f }}{% if f.help_text %}<div class="form-text">{{ f.help_text }}</div>{% endif %}{{ f.errors }}</div>{% endif %}{% endfor %}
+  </div>
+  <button class="btn btn-primary mt-3">Enregistrer</button>
+</form>
+{% endblock %}
diff --git a/templates/translation/project_list.html b/templates/translation/project_list.html
new file mode 100644
index 0000000..785d83e
--- /dev/null
+++ b/templates/translation/project_list.html
@@ -0,0 +1,17 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Projets{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Projets</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-folder2"></i> Projets de traduction</h1>
+  <p>Un projet regroupe des documents découpés en segments, avec ses moteurs et ses glossaires.</p></div>
+  <a class="btn btn-primary" href="{% url 'translation:project_create' %}"><i class="bi bi-plus-lg"></i> Nouveau projet</a></div>
+{% include "translation/_project_table.html" with projects=mine title="Mes projets" %}
+{% if user.is_admin_role %}
+{% include "translation/_project_table.html" with projects=others title="Projets des autres comptes" show_owner=True %}
+{% if hidden %}<h2 class="h5 mt-4">Projets confidentiels des autres comptes</h2>
+<p class="small text-muted">Métadonnées seulement : le contenu n'est visible que par leur propriétaire.</p>
+<table class="table table-sm"><thead><tr><th>Titre</th><th>Propriétaire</th><th>Documents</th><th>Segments</th></tr></thead><tbody>
+{% for p in hidden %}<tr><td><i class="bi bi-lock-fill"></i> {{ p.title }}</td><td>{{ p.owner }}</td><td>{{ p.n_docs }}</td><td>{{ p.n_segments }}</td></tr>{% endfor %}
+</tbody></table>{% endif %}
+{% endif %}
+{% endblock %}
diff --git a/templates/translation/project_metadata.html b/templates/translation/project_metadata.html
new file mode 100644
index 0000000..6c9f104
--- /dev/null
+++ b/templates/translation/project_metadata.html
@@ -0,0 +1,13 @@
+{% extends "base.html" %}
+{% block title %}Projet confidentiel{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_list' %}">Projets</a></li><li class="breadcrumb-item active">Projet confidentiel</li></ol></nav>{% endblock %}
+{% block content %}
+<h1><i class="bi bi-lock-fill"></i> {{ project.title }}</h1>
+<div class="card-soft" style="max-width:700px">
+  <p>Ce projet est <strong>confidentiel</strong> : son contenu n'est visible que par son propriétaire.</p>
+  <dl class="row mb-0"><dt class="col-sm-4">Propriétaire</dt><dd class="col-sm-8">{{ project.owner }}</dd>
+    <dt class="col-sm-4">Documents</dt><dd class="col-sm-8">{{ project.n_docs }}</dd>
+    <dt class="col-sm-4">Segments</dt><dd class="col-sm-8">{{ project.n_segments }} (dont {{ project.n_validated }} validés)</dd>
+    <dt class="col-sm-4">Mis à jour</dt><dd class="col-sm-8">{{ project.updated_at|date:"d/m/Y H:i" }}</dd></dl>
+</div>
+{% endblock %}
diff --git a/templates/translation/record_translations.html b/templates/translation/record_translations.html
new file mode 100644
index 0000000..484557d
--- /dev/null
+++ b/templates/translation/record_translations.html
@@ -0,0 +1,61 @@
+{% extends "base.html" %}
+{% load app_tags %}
+{% block title %}Traductions — {{ record.original_title }}{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Notice {{ record.record_id }}</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1>{{ record.original_title }}</h1>
+  <p><a href="{{ record.get_absolute_url }}">Voir la fiche</a> · {{ record.catalogue.name }}{% if kanbun %} · <span class="badge text-bg-info">kanbun</span>{% endif %}</p></div></div>
+
+<form method="post" action="{% url 'translation:records_prepare' %}" class="card-soft mb-4">{% csrf_token %}
+  <input type="hidden" name="records" value="{{ record.record_id }}">
+  <h2 class="h6">Nouvelle traduction</h2>
+  <div class="mb-2">{% for row in rows %}{% if row.original %}<div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="fields" value="{{ row.field }}" id="nf-{{ row.field }}" {% if row.field == 'original_title' or row.field == 'description_original' %}checked{% endif %}>
+    <label class="form-check-label" for="nf-{{ row.field }}">{{ row.label }}</label></div>{% endif %}{% endfor %}</div>
+  {% include "translation/_engine_choice.html" %}
+  <button class="btn btn-sm btn-primary" {% if not engines %}disabled{% endif %}>Préparer (confirmation à l'étape suivante)</button>
+</form>
+
+<details class="card-soft mb-4"><summary class="h6 mb-0">Copier cette notice dans un projet de traduction</summary>
+  <p class="small mt-2">Pour un texte long ou un projet <strong>confidentiel</strong> : le texte est copié comme document du projet
+    (un document par champ), sans rien publier dans la notice. Vous pourrez ensuite publier la traduction validée, par une action explicite.</p>
+  {% if my_projects %}<form method="post" action="{% url 'translation:copy_record' record.record_id %}" class="d-flex flex-wrap gap-2 align-items-center">{% csrf_token %}
+    <select name="project" class="form-select form-select-sm" style="width:auto" aria-label="Projet">{% for p in my_projects %}<option value="{{ p.pk }}">{{ p.title }}{% if p.confidential %} (confidentiel){% endif %}</option>{% endfor %}</select>
+    {% for row in rows %}{% if row.original %}<div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="fields" value="{{ row.field }}" id="cp-{{ row.field }}" {% if row.field == 'original_title' or row.field == 'description_original' %}checked{% endif %}><label class="form-check-label small" for="cp-{{ row.field }}">{{ row.label }}</label></div>{% endif %}{% endfor %}
+    <button class="btn btn-sm btn-outline-primary">Copier</button></form>
+  {% else %}<p class="small mb-0">Vous n'avez pas encore de projet : <a href="{% url 'translation:project_create' %}">créer un projet</a>.</p>{% endif %}
+</details>
+
+{% for row in rows %}{% if row.original %}
+<section class="mb-4">
+  <h2 class="h5">{{ row.label }}</h2>
+  <div class="row g-3">
+    <div class="col-lg-5"><div class="card-soft h-100"><div class="small text-muted mb-1">Original (jamais modifié)</div><div style="white-space:pre-line" lang="ja">{{ row.original }}</div></div></div>
+    <div class="col-lg-7"><div class="card-soft h-100">
+      {% if row.adoptable %}<div class="small text-muted mb-1">Traduction adoptée dans la fiche {% origin_chip row.adopted_origin %}</div>
+        <div style="white-space:pre-line">{{ row.adopted|default:"— aucune —" }}</div>
+      {% else %}<div class="small text-muted">Ce champ n'a pas de traduction adoptée dans la fiche : la traduction validée reste dans la couche éditoriale.</div>{% endif %}
+    </div></div>
+  </div>
+  <h3 class="h6 mt-3">Propositions ({{ row.proposals|length }})</h3>
+  {% for ed in row.proposals %}
+  <div class="editorial-box {% if ed.origin == 'ai' or ed.origin == 'mt' %}ai{% endif %}">
+    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">{% origin_chip ed.origin %} <span class="chip">{{ ed.get_status_display }}</span>
+      {% if ed.data.simulated %}<span class="chip chip-warn">Simulation</span>{% endif %}
+      <span class="small text-muted">{% if ed.ai_task %}{{ ed.ai_task.get_provider_display }} · {{ ed.ai_task.model }}{% else %}{{ ed.data.model|default:ed.data.engine|default:"saisie" }}{% endif %} · {{ ed.created_at|date:"d/m/Y H:i" }}{% if ed.author %} · {{ ed.author }}{% endif %}</span></div>
+    <div style="white-space:pre-line">{{ ed.content }}</div>
+    {% for a in ed.data.alerts %}<div class="small text-warning">⚠ {{ a }}</div>{% endfor %}
+    {% if ed.source_text and ed.source_text != row.original %}<div class="small text-danger">L'original a changé depuis cette traduction.</div>{% endif %}
+    <form method="post" action="{% url 'translation:record_decide' ed.pk %}" class="d-flex flex-wrap gap-1 mt-2">{% csrf_token %}
+      {% if user.is_admin_role %}
+        {% if ed.status != 'validated' %}<button class="btn btn-sm btn-outline-success" name="action" value="validate">{% if row.adoptable %}Valider et adopter{% else %}Valider{% endif %}</button>{% endif %}
+        {% if ed.status != 'rejected' %}<button class="btn btn-sm btn-outline-secondary" name="action" value="reject">Rejeter</button>{% endif %}
+      {% endif %}
+      {% if user.is_admin_role or ed.author == user %}{% if ed.status == 'validated' %}<input type="hidden" name="confirm_validated" value="1">{% endif %}
+        <button class="btn btn-sm btn-link text-danger" name="action" value="delete" data-confirm="Supprimer cette proposition ?">Supprimer</button>{% endif %}
+    </form>
+  </div>
+  {% empty %}<p class="small text-muted">Aucune proposition.</p>{% endfor %}
+  {% if not user.is_admin_role %}<p class="small text-muted">La validation est réservée à l'administrateur.</p>{% endif %}
+</section>
+{% endif %}{% endfor %}
+{% endblock %}
diff --git a/templates/translation/records_prepare.html b/templates/translation/records_prepare.html
new file mode 100644
index 0000000..1f4af05
--- /dev/null
+++ b/templates/translation/records_prepare.html
@@ -0,0 +1,23 @@
+{% extends "base.html" %}
+{% block title %}Traduire des notices{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Notices</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-translate"></i> Traduire {{ records|length }} notice(s)</h1>
+  <p>Étape 1 sur 2 : préparation. Rien n'est envoyé avant votre confirmation sur l'écran suivant. Les traductions sont
+  <strong>proposées</strong> ; elles n'entrent dans la fiche qu'une fois validées par un administrateur.</p></div></div>
+{% if records %}
+<form method="post" class="card-soft mb-3">{% csrf_token %}<input type="hidden" name="records" value="{{ ids }}">
+  <fieldset class="mb-3"><legend class="h6">Champs à traduire</legend>
+  {% for code, label in fields.items %}<div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="fields" value="{{ code }}" id="f-{{ code }}" {% if code in selected %}checked{% endif %}>
+    <label class="form-check-label" for="f-{{ code }}">{{ label }}</label></div>{% endfor %}
+  </fieldset>
+  {% include "translation/_engine_choice.html" %}
+  {% if kanbun %}<div class="alert alert-info small">{{ kanbun|length }} notice(s) en chinois classique (kanbun) : elles seront marquées comme telles.
+    Les moteurs automatiques y sont peu fiables ; les IA reçoivent une consigne adaptée.</div>{% endif %}
+  <button class="btn btn-primary" {% if not engines %}disabled{% endif %}>Préparer la traduction</button>
+</form>
+<table class="table table-sm"><thead><tr><th>Notice</th><th>Titre</th><th>Langue</th></tr></thead><tbody>
+{% for r in records %}<tr><td class="small"><a href="{% url 'translation:record_translations' r.record_id %}">{{ r.record_id }}</a></td><td>{{ r.original_title }}</td><td class="small">{{ r.get_language_display|default:"—" }}</td></tr>{% endfor %}
+</tbody></table>
+{% else %}<p class="text-muted">Aucune notice sélectionnée.</p>{% endif %}
+{% endblock %}
diff --git a/templates/translation/segment_detail.html b/templates/translation/segment_detail.html
new file mode 100644
index 0000000..a5e988b
--- /dev/null
+++ b/templates/translation/segment_detail.html
@@ -0,0 +1,69 @@
+{% extends "base.html" %}
+{% load app_tags %}
+{% block title %}Segment {{ segment.position }} — {{ document.title }}{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_detail' project.pk %}">{{ project.title }}</a></li><li class="breadcrumb-item"><a href="{% url 'translation:document_workbench' document.pk %}#seg-{{ segment.pk }}">{{ document.title }}</a></li><li class="breadcrumb-item active">Segment {{ segment.position }}</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="d-flex justify-content-between align-items-center mb-2"><h1 class="h3 mb-0">Segment {{ segment.position }}{% if segment.chapter %} <span class="badge text-bg-light fs-6">{{ segment.chapter.title }}</span>{% endif %}</h1>
+  <div>{% if previous %}<a class="btn btn-sm btn-outline-secondary" href="{% url 'translation:segment_detail' previous.pk %}">← {{ previous.position }}</a>{% endif %}
+    {% if next %}<a class="btn btn-sm btn-outline-secondary" href="{% url 'translation:segment_detail' next.pk %}">{{ next.position }} →</a>{% endif %}</div></div>
+<div class="card-soft mb-3"><div class="small text-muted mb-1">Original (texte importé, jamais modifié par une traduction)</div>
+  <div class="fs-5" style="white-space:pre-wrap" lang="{{ project.source_lang }}">{{ segment.source_text }}</div>
+  {% if segment.source_changed %}<div class="small text-danger mt-1">Original modifié depuis la traduction (fusion ou division) : vérifiez les versions ci-dessous.</div>{% endif %}</div>
+
+{% if terms_found %}<div class="card-soft mb-3 small"><strong>Termes du glossaire présents :</strong>
+  {% for term, form in terms_found %}<span class="chip"><span lang="{{ project.source_lang }}">{{ form }}</span> → {{ term.target }}{% if term.avoid %} <span class="text-danger">(éviter : {{ term.avoid|join:", " }})</span>{% endif %}</span> {% endfor %}
+  <span class="text-muted">({% for term, form in terms_found %}{% ifchanged term.glossary_name %}{{ term.glossary_name }}{% if not forloop.last %}, {% endif %}{% endifchanged %}{% endfor %})</span></div>{% endif %}
+
+{% if can_edit %}
+<div class="d-flex flex-wrap gap-2 mb-3">
+  <form method="post" action="{% url 'translation:segment_action' segment.pk %}" class="d-flex gap-1">{% csrf_token %}
+    <select name="engine" class="form-select form-select-sm" style="width:auto" aria-label="Moteur"><option value="default">Moteur par défaut</option><option value="second">Deuxième moteur</option></select>
+    <button class="btn btn-sm btn-primary" name="action" value="translate">Traduire ce segment…</button></form>
+  <form method="post" action="{% url 'translation:segment_action' segment.pk %}">{% csrf_token %}{% if next %}<button class="btn btn-sm btn-outline-secondary" name="action" value="merge" data-confirm="Fusionner avec le segment suivant ?">Fusionner avec le suivant</button>{% endif %}</form>
+</div>
+<details class="mb-3"><summary class="small">Diviser ce segment</summary>
+  <form method="post" action="{% url 'translation:segment_action' segment.pk %}" class="card-soft mt-2">{% csrf_token %}
+    <label class="form-label small" for="first-part">Gardez dans ce champ seulement la PREMIÈRE partie (supprimez la fin) :</label>
+    <textarea id="first-part" name="first_part" class="form-control mb-2" rows="3" lang="{{ project.source_lang }}">{{ segment.source_text }}</textarea>
+    <button class="btn btn-sm btn-outline-secondary" name="action" value="split">Diviser</button></form></details>
+<details class="mb-3"><summary class="small">Commencer un chapitre à ce segment</summary>
+  <form method="post" action="{% url 'translation:segment_action' segment.pk %}" class="d-flex gap-2 mt-2">{% csrf_token %}
+    <input name="title" class="form-control form-control-sm" placeholder="Titre du chapitre" aria-label="Titre du chapitre" style="max-width:400px">
+    <button class="btn btn-sm btn-outline-secondary" name="action" value="chapter">Créer le chapitre</button></form></details>
+{% if term_glossaries %}<details class="mb-3"><summary class="small">Ajouter un terme au glossaire</summary>
+  <form method="post" action="{% url 'translation:segment_term' segment.pk %}" class="card-soft mt-2">{% csrf_token %}
+    <div class="row g-2"><div class="col-md-3"><label class="form-label small" for="term-src">Terme source (copié de l'original)</label><input id="term-src" name="source_term" class="form-control form-control-sm" lang="{{ project.source_lang }}" required></div>
+      <div class="col-md-3"><label class="form-label small" for="term-tgt">Traduction imposée</label><input id="term-tgt" name="target_term" class="form-control form-control-sm" required></div>
+      <div class="col-md-2"><label class="form-label small" for="term-cat">Catégorie</label><select id="term-cat" name="category" class="form-select form-select-sm">{% for code, label in term_categories %}<option value="{{ code }}" {% if code == "other" %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
+      <div class="col-md-4"><label class="form-label small" for="term-gl">Glossaire</label><select id="term-gl" name="glossary" class="form-select form-select-sm">{% for g in term_glossaries %}<option value="{{ g.pk }}">{{ g.name }}</option>{% endfor %}</select></div></div>
+    <button class="btn btn-sm btn-outline-primary mt-2">Ajouter</button> <span class="small text-muted">Les traductions existantes ne sont pas modifiées.</span></form></details>{% endif %}
+<section class="card-soft mb-3"><h2 class="h6">{% if edit_from %}Corriger la version du {{ edit_from.created_at|date:"d/m/Y H:i" }}{% else %}Saisir ma traduction{% endif %}</h2>
+  <form method="post" action="{% url 'translation:segment_action' segment.pk %}">{% csrf_token %}
+    {% if edit_from %}<input type="hidden" name="parent" value="{{ edit_from.pk }}">{% endif %}
+    <textarea name="text" class="form-control mb-2" rows="3" aria-label="Traduction">{% if edit_from %}{{ edit_from.text }}{% endif %}</textarea>
+    <button class="btn btn-sm btn-primary" name="action" value="human">Enregistrer comme nouvelle version</button>
+    <span class="small text-muted">La version d'origine est conservée.</span></form></section>
+{% endif %}
+
+<h2 class="h5">Versions ({{ versions|length }})</h2>
+{% for v in versions %}
+<div class="editorial-box {% if v.origin == 'ai' or v.origin == 'machine' %}ai{% endif %}{% if v.status == 'validated' %} border-success{% endif %}">
+  <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
+    <strong>{{ v.get_status_display }}</strong> <span class="chip">{{ v.get_origin_display }}</span>
+    {% if v.simulated %}<span class="chip chip-warn">Simulation</span>{% endif %}
+    <span class="small text-muted">{% if v.model %}{{ v.model }}{% elif v.engine %}{{ v.get_engine_display }}{% endif %}{% if v.engine_version %} · {{ v.engine_version }}{% endif %} · {{ v.created_at|date:"d/m/Y H:i" }}{% if v.author %} · {{ v.author }}{% endif %}{% if v.cost_estimate is not None %} · ≈ {{ v.cost_estimate|floatformat:5 }} {{ v.currency }}{% endif %}</span>
+    {% if v.parent %}<span class="small text-muted">corrige la version du {{ v.parent.created_at|date:"d/m/Y H:i" }}</span>{% endif %}
+    {% if v.decided_by %}<span class="small text-muted">· décision : {{ v.decided_by }}, {{ v.decided_at|date:"d/m/Y H:i" }}</span>{% endif %}</div>
+  <div style="white-space:pre-wrap">{{ v.text }}</div>
+  {% for a in v.alerts %}<div class="small text-warning">⚠ {{ a }}</div>{% endfor %}
+  {% if v.source_text != segment.source_text %}<div class="small text-danger">Traduite d'un original différent : « {{ v.source_text|truncatechars:80 }} »</div>{% endif %}
+  <div class="d-flex flex-wrap gap-1 mt-2">
+    {% if can_validate %}<form method="post" action="{% url 'translation:version_action' v.pk %}" class="d-flex gap-1">{% csrf_token %}
+      {% if v.status != 'validated' %}<button class="btn btn-sm btn-outline-success" name="action" value="validate">Valider</button>{% endif %}
+      {% if v.status != 'rejected' %}<button class="btn btn-sm btn-outline-secondary" name="action" value="reject">Rejeter</button>{% endif %}</form>{% endif %}
+    {% if can_edit %}<a class="btn btn-sm btn-link" href="?corriger={{ v.pk }}">Corriger</a>{% endif %}
+  </div>
+</div>
+{% empty %}<p class="text-muted">Aucune version : ce segment n'est pas encore traduit.</p>{% endfor %}
+{% if not can_validate %}<p class="small text-muted">Seul le propriétaire du projet valide les traductions.</p>{% endif %}
+{% endblock %}
diff --git a/templates/translation/usage.html b/templates/translation/usage.html
new file mode 100644
index 0000000..c5a295a
--- /dev/null
+++ b/templates/translation/usage.html
@@ -0,0 +1,31 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Consommation{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Consommation</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-speedometer2"></i> Consommation</h1>
+  <p>Vos envois aux moteurs de traduction, par moteur et par mois. <strong>Les montants sont des estimations ; la facture du fournisseur fait foi.</strong></p></div>
+  <form method="get"><div class="d-flex gap-1"><select name="mois" class="form-select form-select-sm" aria-label="Mois">{% for m in months %}<option value="{{ m|date:'Y-m' }}" {% if m == month %}selected{% endif %}>{{ m|date:"F Y" }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-secondary">Afficher</button></div></form></div>
+
+{% if caps %}<section class="card-soft mb-3"><h2 class="h5">Plafonds du mois en cours</h2>
+{% for c in caps %}<div class="mb-2"><div class="small">{{ c.label }} : {{ c.used }} / {{ c.cap }} {{ c.unit }}</div>
+  <div class="progress" style="max-width:500px" role="progressbar" aria-label="{{ c.label }}" aria-valuenow="{{ c.share }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar {% if c.share >= 100 %}bg-danger{% elif c.share >= 80 %}bg-warning{% endif %}" style="width:{{ c.share }}%"></div></div></div>{% endfor %}
+<p class="small text-muted mb-0">Au-delà d'un plafond, la traduction est bloquée. Plafonds de caractères : <a href="{% url 'translation:engines' %}">Traduction → Moteurs</a> ; plafond IA : préférences IA.</p></section>{% endif %}
+
+<h2 class="h5">{{ month|date:"F Y" }}</h2>
+<table class="table table-sm align-middle"><thead><tr><th>Moteur</th><th>Tâches</th><th>Caractères envoyés</th><th>Traductions reçues</th><th>Coût estimé</th></tr></thead><tbody>
+{% for r in data.rows %}<tr><td>{{ r.label }}{% if r.simulated %} <span class="chip chip-warn">dont {{ r.simulated }} simulée(s)</span>{% endif %}{% if r.code == "ai" %}<div class="small text-muted">{{ r.tokens_in }} jetons envoyés, {{ r.tokens_out }} reçus (tâches IA)</div>{% endif %}</td>
+  <td>{{ r.jobs }}</td><td>{{ r.chars }}</td><td>{{ r.translations }}</td>
+  <td>{% for cur, amount in r.costs.items %}≈ {{ amount|floatformat:4 }} {{ cur }}{% if not forloop.last %}<br>{% endif %}{% empty %}<span class="text-muted small">{% if r.code == "argos" %}gratuit (local){% else %}non disponible (tarif non renseigné){% endif %}</span>{% endfor %}</td></tr>
+{% empty %}<tr><td colspan="5" class="text-muted">Aucun envoi ce mois-ci.</td></tr>{% endfor %}
+{% if data.legacy.tasks %}<tr><td>Traductions de l'ancien module IA<div class="small text-muted">{{ data.legacy.tokens_in }} jetons envoyés, {{ data.legacy.tokens_out }} reçus</div></td><td>{{ data.legacy.tasks }}</td><td class="text-muted">—</td><td class="text-muted">—</td>
+  <td>{% for cur, amount in data.legacy.costs.items %}≈ {{ amount|floatformat:4 }} {{ cur }}{% empty %}—{% endfor %}</td></tr>{% endif %}
+</tbody>
+{% if data.rows %}<tfoot><tr class="fw-semibold"><td>Total</td><td></td><td>{{ data.chars }}</td><td>{{ data.translations }}</td><td>{% for cur, amount in data.totals.items %}≈ {{ amount|floatformat:4 }} {{ cur }}{% if not forloop.last %}<br>{% endif %}{% empty %}—{% endfor %}</td></tr></tfoot>{% endif %}
+</table>
+<p class="small text-muted">Chiffres calculés à partir de vos tâches du mois (une tâche compte pour le mois où elle a été préparée) ; une traduction simulée ou reprise de la mémoire n'envoie aucun caractère. Coût IA : tarifs saisis dans le module IA.</p>
+
+{% if data.detail %}<details><summary class="small">Détail des {{ data.detail|length }} tâche(s)</summary>
+<table class="table table-sm small mt-2"><thead><tr><th>N°</th><th>Date</th><th>Portée</th><th>Moteur</th><th>État</th><th>Caractères</th><th>Traductions</th><th>Coût estimé</th></tr></thead><tbody>
+{% for d in data.detail %}<tr><td>{% if d.job.kind == 'package' %}{{ d.job.pk }}{% else %}<a href="{% url 'translation:job_detail' d.job.pk %}">{{ d.job.pk }}</a>{% endif %}</td><td>{{ d.job.created_at|date:"d/m H:i" }}</td><td>{{ d.job.scope_label|truncatechars:60 }}</td><td>{{ d.label }}</td><td>{{ d.job.get_status_display }}</td><td>{{ d.job.chars_sent }}</td><td>{{ d.done }}</td>
+  <td>{% for cur, amount in d.costs.items %}≈ {{ amount|floatformat:4 }} {{ cur }}{% empty %}—{% endfor %}</td></tr>{% endfor %}</tbody></table></details>{% endif %}
+{% endblock %}
diff --git a/templates/translation/workbench.html b/templates/translation/workbench.html
new file mode 100644
index 0000000..d87ee51
--- /dev/null
+++ b/templates/translation/workbench.html
@@ -0,0 +1,57 @@
+{% extends "base.html" %}
+{% load app_tags %}
+{% block title %}{{ document.title }} — Traduction{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_list' %}">Projets</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_detail' project.pk %}">{{ project.title }}</a></li><li class="breadcrumb-item active">{{ document.title }}</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1>{{ document.title }}</h1>
+  <p>{{ document.get_variety_display }} · {{ counts.validated }} validé(s) / {{ total }} segment(s){% if counts.alert %} · <span class="text-warning">{{ counts.alert }} en alerte</span>{% endif %}
+    {% if project.confidential %} · <span class="badge text-bg-dark"><i class="bi bi-lock-fill"></i> confidentiel</span>{% endif %}</p>
+  {% if document.variety != 'modern' %}<p class="small text-warning">Texte marqué {{ document.get_variety_display|lower }} : les moteurs automatiques y sont peu fiables ; les IA reçoivent une consigne adaptée.</p>{% endif %}
+  {% if not integrity %}<div class="alert alert-danger">Anomalie : les segments ne redonnent plus exactement le texte importé. Signalez-le (journal des dysfonctionnements).</div>{% endif %}</div>
+  {% if project.owner == user %}<a class="btn btn-outline-secondary align-self-start" href="{% url 'translation:project_export' project.pk %}?document={{ document.pk }}"><i class="bi bi-download"></i> Exporter ce document</a>{% endif %}
+  <div class="progress" style="width:220px" role="progressbar" aria-label="Segments validés" aria-valuenow="{{ counts.validated }}" aria-valuemin="0" aria-valuemax="{{ total }}"><div class="progress-bar bg-success" style="width:{% widthratio counts.validated total 100 %}%"></div></div></div>
+
+<form method="get" class="d-flex flex-wrap gap-2 mb-2 align-items-center">
+  <select name="etat" class="form-select form-select-sm" style="width:auto" aria-label="Filtrer par état"><option value="">Tous les états</option>{% for code, label in states %}<option value="{{ code }}" {% if state == code %}selected{% endif %}>{{ label }} ({{ counts|get_item:code }})</option>{% endfor %}</select>
+  {% if chapters %}<select name="chapitre" class="form-select form-select-sm" style="width:auto" aria-label="Chapitre"><option value="">Tous les chapitres</option>{% for c in chapters %}<option value="{{ c.pk }}" {% if chapter == c.pk|stringformat:"s" %}selected{% endif %}>{{ c.title }}</option>{% endfor %}</select>{% endif %}
+  <button class="btn btn-sm btn-outline-secondary">Filtrer</button>
+</form>
+
+<form method="post" action="{% url 'translation:document_bulk' document.pk %}">{% csrf_token %}
+{% if can_edit %}
+<div class="d-flex flex-wrap gap-2 align-items-center mb-2 card-soft py-2">
+  <select name="scope" class="form-select form-select-sm" style="width:auto" aria-label="Portée"><option value="selected">Segments cochés</option><option value="untranslated">Tous les non traduits</option>{% for c in chapters %}<option value="chapter:{{ c.pk }}">Chapitre : {{ c.title }}</option>{% endfor %}</select>
+  <select name="engine" class="form-select form-select-sm" style="width:auto" aria-label="Moteur"><option value="default">Moteur par défaut</option><option value="second">Deuxième moteur</option></select>
+  <button class="btn btn-sm btn-primary" name="action" value="translate">Traduire…</button>
+  {% if can_validate %}<button class="btn btn-sm btn-outline-success" name="action" value="validate" title="Valide la dernière proposition de chaque segment, sauf s'il a déjà une version validée">Valider les dernières propositions</button>{% endif %}
+  <span class="small text-muted">Une confirmation est demandée avant tout envoi.</span>
+</div>
+{% endif %}
+<table class="table table-sm align-top workbench"><thead><tr>{% if can_edit %}<th></th>{% endif %}<th>#</th><th style="width:45%">Original</th><th>Traduction</th><th>État</th></tr></thead><tbody>
+{% for row in rows %}{% with seg=row.segment v=row.shown %}
+<tr id="seg-{{ seg.pk }}">
+  {% if can_edit %}<td>{% if row.translatable %}<input type="checkbox" class="form-check-input" name="segments" value="{{ seg.pk }}" aria-label="Sélectionner le segment {{ seg.position }}">{% endif %}</td>{% endif %}
+  <td class="small text-muted"><a href="{% url 'translation:segment_detail' seg.pk %}">{{ seg.position }}</a>{% if seg.chapter and seg.chapter.order == seg.position %}<div class="badge text-bg-light">{{ seg.chapter.title|truncatechars:20 }}</div>{% endif %}</td>
+  <td lang="{{ project.source_lang }}" style="white-space:pre-wrap">{{ seg.source_text }}</td>
+  <td>{% if v %}<div style="white-space:pre-wrap">{{ v.text }}</div>
+      <div class="small text-muted">{% if v.status == 'validated' %}<span class="text-success">validée</span>{% else %}proposée{% endif %} · {{ v.get_origin_display }}{% if v.model %} · {{ v.model }}{% endif %}{% if row.n_versions > 1 %} · <a href="{% url 'translation:segment_detail' seg.pk %}">{{ row.n_versions }} versions</a>{% endif %}</div>
+      {% if v.simulated %}<span class="chip chip-warn">Simulation</span>{% endif %}
+      {% for a in v.alerts %}<div class="small text-warning">⚠ {{ a }}</div>{% endfor %}
+    {% elif not row.translatable %}<span class="text-muted small">rien à traduire</span>{% else %}<span class="text-muted">—</span>{% endif %}
+    {% if seg.source_changed %}<div class="small text-danger">Original modifié depuis la traduction (fusion ou division).</div>{% endif %}</td>
+  <td class="small">{{ seg.get_state_display }}</td>
+</tr>{% endwith %}{% empty %}<tr><td colspan="5" class="text-muted">Aucun segment.</td></tr>{% endfor %}
+</tbody></table>
+</form>
+{% if page.has_other_pages %}<nav><ul class="pagination pagination-sm">{% if page.has_previous %}<li class="page-item"><a class="page-link" href="?page={{ page.previous_page_number }}&etat={{ state }}&chapitre={{ chapter }}">Précédent</a></li>{% endif %}<li class="page-item disabled"><span class="page-link">{{ page.number }} / {{ page.paginator.num_pages }}</span></li>{% if page.has_next %}<li class="page-item"><a class="page-link" href="?page={{ page.next_page_number }}&etat={{ state }}&chapitre={{ chapter }}">Suivant</a></li>{% endif %}</ul></nav>{% endif %}
+
+{% if notice_field and can_validate %}
+<section class="card-soft mt-4"><h2 class="h6">Publier dans la notice</h2>
+  <p class="small">Ce document vient de la notice <a href="{% url 'translation:record_translations' document.record.record_id %}">{{ document.record.original_title }}</a>.
+    Une fois tous les segments validés, sa traduction peut être proposée dans la notice ; un administrateur la validera.
+    {% if project.confidential %}<strong>Attention : la notice est commune à tous les comptes ; la traduction publiée sortira de la confidentialité du projet.</strong>{% else %}La traduction publiée sera visible par tous les comptes.{% endif %}</p>
+  <form method="post" action="{% url 'translation:document_publish' document.pk %}">{% csrf_token %}
+    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm_publish" value="1" id="confirm-publish"><label class="form-check-label" for="confirm-publish">Je comprends que cette traduction deviendra visible par tous les comptes.</label></div>
+    <button class="btn btn-sm btn-outline-primary">Publier dans la notice</button></form></section>
+{% endif %}
+{% endblock %}
diff --git a/tests/fixtures/traduction/README.md b/tests/fixtures/traduction/README.md
new file mode 100644
index 0000000..e9b0e2e
