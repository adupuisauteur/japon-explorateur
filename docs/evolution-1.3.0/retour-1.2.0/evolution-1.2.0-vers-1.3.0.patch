@@ -0,0 +1,4 @@
+{% comment %}Résumé des conditions d'un fournisseur avant le premier envoi (cahier des charges § 13). Variable : t.{% endcomment %}
+<div class="alert alert-info small mb-2"><strong>Avant le premier envoi à {{ t.name }} : ce que deviennent vos textes</strong>
+  <ul class="mb-1 mt-1">{% for p in t.points %}<li>{{ p }}</li>{% endfor %}</ul>
+  <div>{% if t.verified_on %}Résumé vérifié le {{ t.verified_on }}{% endif %}{% for s in t.sources %} · <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.label }}</a>{% endfor %}. Les conditions officielles font foi.</div></div>
diff --git a/templates/translation/argos_index.html b/templates/translation/argos_index.html
new file mode 100644
index 0000000..3974a74
--- /dev/null
+++ b/templates/translation/argos_index.html
@@ -0,0 +1,20 @@
+{% extends "base.html" %}
+{% block title %}Index Argos — Moteurs locaux{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:local_engines' %}">Moteurs locaux</a></li><li class="breadcrumb-item active">Index Argos</li></ol></nav>{% endblock %}
+{% block content %}
+<h1>Paquets proposés par l'index Argos</h1>
+<p class="small text-muted">Langues du module seulement (japonais, anglais, français). Les paquets utiles aux paires de la 1.3.0 sont présélectionnés s'ils ne sont pas installés.</p>
+<form method="post" action="{% url 'translation:argos_install' %}" class="card-soft" style="max-width:900px">{% csrf_token %}
+<table class="table table-sm align-middle"><thead><tr><th></th><th>Paquet</th><th>Version</th><th>Taille</th><th>État</th></tr></thead><tbody>
+{% for r in rows %}<tr><td><input class="form-check-input" type="checkbox" name="packages" value="{{ r.code }}" id="p-{{ forloop.counter }}" {% if r.needed and not r.installed %}checked{% endif %}></td>
+  <td><label for="p-{{ forloop.counter }}">{{ r.code }}{% if r.name %} <span class="small text-muted">({{ r.name }})</span>{% endif %}</label>{% if r.needed %} <span class="badge text-bg-info">utile</span>{% endif %}</td>
+  <td>{{ r.version }}</td><td class="small">{% if r.size %}{{ r.size|filesizeformat }}{% else %}non indiquée{% endif %}</td>
+  <td class="small">{% if r.installed %}installé (v{{ r.installed.version }}){% else %}—{% endif %}</td></tr>
+{% empty %}<tr><td colspan="5" class="text-muted">L'index ne propose aucun paquet pour ces langues.</td></tr>{% endfor %}
+</tbody></table>
+{% if rows %}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="1" id="confirm">
+  <label class="form-check-label" for="confirm">Je choisis de télécharger les paquets cochés depuis Internet (index Argos Open Technologies). Un paquet pèse de quelques dizaines à quelques centaines de Mo ; l'installation peut durer plusieurs minutes. Aucun texte à traduire n'est envoyé.</label></div>
+<button class="btn btn-primary">Télécharger et installer</button>{% endif %}
+<a class="btn btn-link" href="{% url 'translation:local_engines' %}">Annuler</a>
+</form>
+{% endblock %}
diff --git a/templates/translation/comparison.html b/templates/translation/comparison.html
new file mode 100644
index 0000000..1223630
--- /dev/null
+++ b/templates/translation/comparison.html
@@ -0,0 +1,45 @@
+{% extends "base.html" %}
+{% block title %}{{ label }} — Évaluation{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:evaluation' %}">Évaluation</a></li><li class="breadcrumb-item active">{{ label }}</li></ol></nav>{% endblock %}
+{% block content %}
+<div id="comparaison" {% if running %}hx-get="{{ url }}" hx-trigger="every 3s" hx-select="#comparaison" hx-swap="outerHTML"{% endif %}>
+<h1 class="h3">{{ label }}</h1>
+{% if drafts %}
+<section class="card-soft mb-3"><h2 class="h5">Confirmation du coût — rien n'a encore été envoyé</h2>
+<table class="table table-sm align-middle"><thead><tr><th>Moteur</th><th>Segments</th><th>Caractères</th><th>Coût estimé</th><th>Envoi</th></tr></thead><tbody>
+{% for job, s, name in drafts %}<tr><td>{{ name }}{% if s.status.simulated %} <span class="chip chip-warn">Simulation</span>{% endif %}<div class="small text-muted">{% if s.engine.online %}service en ligne : le texte sera envoyé{% else %}moteur local{% endif %}</div></td>
+  <td>{{ s.counts.pending }}</td><td>{{ job.chars_estimated }}</td>
+  <td class="small">{% if not s.engine.online %}gratuit (moteur local){% elif s.cost.amount is not None %}≈ {{ s.cost.amount|floatformat:4 }} {{ s.cost.currency }} <span class="text-muted">({{ s.cost.basis }})</span>{% else %}<span class="text-muted">non disponible — {{ s.cost.basis }}</span>{% endif %}</td>
+  <td class="small">{% if s.problems %}<span class="text-danger">{{ s.problems|join:" " }}</span>{% else %}<span class="text-success">possible</span>{% endif %}</td></tr>{% endfor %}
+</tbody></table>
+<p class="small text-muted">Montants estimés ; la facture du fournisseur fait foi.</p>
+{% for t in terms %}{% include "translation/_terms.html" with t=t %}{% endfor %}
+<form method="post" action="{% url 'translation:comparison_action' project.pk %}" class="d-flex flex-wrap gap-2 align-items-center">{% csrf_token %}<input type="hidden" name="c" value="{{ label }}">
+  {% if terms %}<div class="form-check w-100"><input class="form-check-input" type="checkbox" name="terms_acknowledged" value="1" id="terms-ack"><label class="form-check-label" for="terms-ack">J'ai pris connaissance des résumés ci-dessus.</label></div>{% endif %}
+  {% if needs_second %}<div class="form-check"><input class="form-check-input" type="checkbox" name="second_confirmation" value="1" id="second"><label class="form-check-label" for="second">Volume important : je confirme une seconde fois l'envoi</label></div>{% endif %}
+  <button class="btn btn-primary" name="action" value="confirm">Confirmer et lancer</button>
+  <button class="btn btn-outline-secondary" name="action" value="cancel">Annuler</button></form>
+</section>
+{% endif %}
+
+<section class="mb-3"><h2 class="h5">Vos notes</h2>
+<p class="small text-muted">Répartition des appréciations que <strong>vous</strong> avez données. Aucun score automatique n'est calculé : seule votre lecture juge la qualité.</p>
+<table class="table table-sm" style="max-width:900px"><thead><tr><th>Moteur</th><th>État</th>{% for code, name in ratings %}<th>{{ name }}</th>{% endfor %}<th>Non notées</th></tr></thead><tbody>
+{% for s in summary %}<tr><td>{{ s.label }}</td><td class="small">{{ s.job.get_status_display }}{% if s.job.status != 'draft' %} ({{ s.job.done_items }}/{{ s.job.total_items }}){% endif %}</td>
+  {% for code, name, n in s.counts %}<td>{{ n }}</td>{% endfor %}<td>{{ s.unrated }}</td></tr>{% endfor %}
+</tbody></table></section>
+
+<h2 class="h5">Segments</h2>
+<table class="table table-sm align-top"><thead><tr><th style="width:22%">Original</th>{% for job, name in columns %}<th>{{ name }}</th>{% endfor %}</tr></thead><tbody>
+{% for segment, items in rows %}<tr id="s-{{ segment.pk }}"><td lang="{{ project.source_lang }}" style="white-space:pre-wrap">{{ segment.source_text }}</td>
+  {% for item in items %}<td>{% if item.version %}{% with v=item.version %}
+    <div style="white-space:pre-wrap">{{ v.text }}</div>{% if v.simulated %}<span class="chip chip-warn">Simulation</span>{% endif %}
+    {% for a in v.alerts %}<div class="small text-warning">⚠ {{ a }}</div>{% endfor %}
+    <form method="post" action="{% url 'translation:version_rate' v.pk %}" class="mt-1">{% csrf_token %}<input type="hidden" name="next" value="{{ url }}#s-{{ segment.pk }}">
+      <select name="rating" class="form-select form-select-sm mb-1" aria-label="Appréciation"><option value="">— non notée —</option>{% for code, name in ratings %}<option value="{{ code }}" {% if v.rating == code %}selected{% endif %}>{{ name }}</option>{% endfor %}</select>
+      <input name="comment" value="{{ v.rating_comment }}" class="form-control form-control-sm mb-1" placeholder="Commentaire" aria-label="Commentaire">
+      <button class="btn btn-sm btn-outline-secondary py-0">Noter</button></form>{% endwith %}
+  {% elif item %}<span class="small text-muted">{{ item.get_status_display }}{% if item.error_message %} — {{ item.error_message }}{% endif %}</span>{% endif %}</td>{% endfor %}</tr>{% endfor %}
+</tbody></table>
+</div>
+{% endblock %}
diff --git a/templates/translation/document_form.html b/templates/translation/document_form.html
new file mode 100644
index 0000000..b66409b
--- /dev/null
+++ b/templates/translation/document_form.html
@@ -0,0 +1,32 @@
+{% extends "base.html" %}
+{% block title %}Ajouter un document{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_list' %}">Projets</a></li><li class="breadcrumb-item"><a href="{% url 'translation:project_detail' project.pk %}">{{ project.title }}</a></li><li class="breadcrumb-item active">Nouveau document</li></ol></nav>{% endblock %}
+{% block content %}
+<h1>Ajouter un document à « {{ project.title }} »</h1>
+{% if preview %}
+<div class="card-soft mb-3">
+  <h2 class="h5 text-warning"><i class="bi bi-exclamation-triangle"></i> Encodage incertain : vérifiez l'aperçu</h2>
+  <p class="small">Fichier « {{ preview.filename }} » lu comme <strong>{{ preview.encoding }}</strong>. {% for n in preview.notes %}{{ n }}. {% endfor %}
+    Si le texte ci-dessous est illisible, n'importez pas : enregistrez le fichier en UTF-8 et recommencez.</p>
+  <pre class="border rounded p-2 bg-light" style="max-height:300px;white-space:pre-wrap" lang="ja">{{ preview.text|truncatechars:3000 }}</pre>
+  <form method="post">{% csrf_token %}
+    <input type="hidden" name="title" value="{{ form_data.title }}"><input type="hidden" name="variety" value="{{ form_data.variety }}">
+    <input type="hidden" name="source_kind" value="{{ preview.kind }}"><input type="hidden" name="filename" value="{{ preview.filename }}">
+    <input type="hidden" name="encoding" value="{{ preview.encoding }}">
+    <textarea name="confirmed_text" hidden>{{ preview.text }}</textarea>
+    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm_encoding" value="1" id="confirm-encoding">
+      <label class="form-check-label" for="confirm-encoding">Le texte est lisible : importer avec cet encodage.</label></div>
+    <button class="btn btn-primary">Importer</button> <a class="btn btn-link" href="{% url 'translation:document_add' project.pk %}">Recommencer</a>
+  </form>
+</div>
+{% else %}
+<form method="post" enctype="multipart/form-data" class="card-soft" style="max-width:900px">{% csrf_token %}
+  {{ form.non_field_errors }}
+  <div class="row g-2 mb-2"><div class="col-md-8">{{ form.title.label_tag }}{{ form.title }}</div><div class="col-md-4">{{ form.variety.label_tag }}{{ form.variety }}</div></div>
+  <div class="mb-2">{{ form.text.label_tag }}{{ form.text }}</div>
+  <div class="mb-2">{{ form.file.label_tag }}{{ form.file }}<div class="form-text">Encodages reconnus : UTF-8, Shift_JIS, EUC-JP, UTF-16. PDF : texte sélectionnable seulement (pas d'OCR). Mise en forme non conservée.</div></div>
+  <p class="small text-muted">Le texte est découpé automatiquement en segments (fins de phrase, citations, retours à la ligne) ; vous pourrez fusionner ou diviser des segments. Le texte importé est conservé à l'identique.</p>
+  <button class="btn btn-primary">Importer et découper</button>
+</form>
+{% endif %}
+{% endblock %}
diff --git a/templates/translation/engines.html b/templates/translation/engines.html
new file mode 100644
index 0000000..9256b0b
--- /dev/null
+++ b/templates/translation/engines.html
@@ -0,0 +1,77 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Moteurs{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Moteurs</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-cpu"></i> Moteurs de traduction</h1>
+  <p>Seul endroit où se choisissent les moteurs de traduction. Enregistrer un réglage ou tester une clé ne lance aucune
+  traduction. Les clés sont chiffrées et ne sont plus jamais affichées.</p></div></div>
+
+{% if not encryption_ok %}<div class="alert alert-danger">La clé de chiffrement du serveur (<code>AI_KEYS_ENCRYPTION_KEY</code>) n'est pas définie : impossible d'enregistrer une clé.</div>{% endif %}
+
+<section class="card-soft mb-4">
+  <h2 class="h5">Moteurs choisis</h2>
+  <form method="post" action="{% url 'translation:preferences_save' %}" class="row g-2">{% csrf_token %}
+    <div class="col-md-4">{{ pref_form.default_engine.label_tag }}{{ pref_form.default_engine }}</div>
+    <div class="col-md-4">{{ pref_form.default_ai_provider.label_tag }}{{ pref_form.default_ai_provider }}</div>
+    <div class="col-md-4">{{ pref_form.default_ai_model.label_tag }}{{ pref_form.default_ai_model }}</div>
+    <div class="col-md-4">{{ pref_form.second_engine.label_tag }}{{ pref_form.second_engine }}</div>
+    <div class="col-md-4">{{ pref_form.second_ai_provider.label_tag }}{{ pref_form.second_ai_provider }}</div>
+    <div class="col-md-4">{{ pref_form.second_ai_model.label_tag }}{{ pref_form.second_ai_model }}</div>
+    <div class="col-md-4">{{ pref_form.confirmation_threshold.label_tag }}{{ pref_form.confirmation_threshold }}</div>
+    <div class="col-md-8 d-flex flex-column justify-content-end gap-1">
+      <div class="form-check">{{ pref_form.send_neighbour_context }} <label class="form-check-label" for="{{ pref_form.send_neighbour_context.id_for_label }}">{{ pref_form.send_neighbour_context.label }}</label></div>
+      <div class="form-check">{{ pref_form.translate_subjects }} <label class="form-check-label" for="{{ pref_form.translate_subjects.id_for_label }}">{{ pref_form.translate_subjects.label }}</label></div>
+      <div class="form-check">{{ pref_form.translate_place }} <label class="form-check-label" for="{{ pref_form.translate_place.id_for_label }}">{{ pref_form.translate_place.label }}</label></div>
+    </div>
+    <div class="col-12"><button class="btn btn-primary btn-sm">Enregistrer le choix des moteurs</button>
+      <span class="small text-muted ms-2">Le deuxième moteur est seulement <strong>proposé</strong> en cas d'échec ; il n'est jamais utilisé d'office.</span></div>
+  </form>
+  <div class="small mt-2">
+    {% if default_status %}Moteur par défaut : <strong>{{ default_status.name }}</strong> — <span class="text-{{ default_status.status.level }}">{{ default_status.status.label }}</span>{% if default_status.status.simulated %} <span class="chip chip-warn">Simulation</span>{% endif %}<br>{% else %}<span class="text-muted">Aucun moteur par défaut : choisissez-en un.</span><br>{% endif %}
+    {% if second_status %}Deuxième moteur : <strong>{{ second_status.name }}</strong> — <span class="text-{{ second_status.status.level }}">{{ second_status.status.label }}</span>{% endif %}
+  </div>
+</section>
+
+<h2 class="h5">Services de traduction</h2>
+<div class="row g-3 mb-4">
+{% for row in rows %}
+  <div class="col-lg-4"><div class="card-soft h-100" id="moteur-{{ row.code }}">
+    <h3 class="h6 d-flex justify-content-between align-items-start">{{ row.label }}
+      <span class="badge text-bg-{{ row.status.level }}">{{ row.status.label }}</span></h3>
+    <p class="small text-muted mb-2">{% if row.cls.online %}Service en ligne : le texte est envoyé au fournisseur.{% else %}Moteur local : aucun texte ne quitte votre ordinateur.{% endif %}
+      {% if row.cls.glossary_support == 'native' %}Glossaires pris en charge par le service.{% elif row.cls.glossary_support == 'none' %}Pas de glossaire côté moteur : contrôle terminologique local.{% endif %}</p>
+    {% if row.status.detail %}<p class="small mb-2">{{ row.status.detail }}</p>{% endif %}
+    {% if row.status.simulated %}<div class="alert alert-warning small py-2">Mode simulé : aucune traduction réelle ; chaque résultat porte la mention « Simulation ».</div>{% endif %}
+    {% if row.code == 'argos' %}<p class="small mb-2"><a href="{% url 'translation:local_engines' %}"><i class="bi bi-box-seam"></i> Service et paquets de langues (Moteurs locaux)</a></p>{% endif %}
+    {% if row.setting.has_key %}<p class="small mb-2"><i class="bi bi-key"></i> Clé enregistrée (chiffrée){% if row.setting.last_tested_at %}, dernier test le {{ row.setting.last_tested_at|date:"d/m/Y H:i" }}{% endif %}.</p>{% endif %}
+    {% if row.setting.quota_info.character_limit %}<p class="small mb-2">Consommation lue : {{ row.setting.quota_info.character_count }} / {{ row.setting.quota_info.character_limit }} caractères.</p>{% endif %}
+    <form method="post" action="{% url 'translation:engine_save' row.code %}" class="d-grid gap-2">{% csrf_token %}
+      {% for field in row.form %}
+        {% if field.field.widget.input_type == 'checkbox' %}<div class="form-check">{{ field }} <label class="form-check-label" for="{{ field.id_for_label }}">{{ field.label }}</label></div>
+        {% else %}<div>{{ field.label_tag }}{{ field }}{% if field.name == 'api_key' and row.help %}<div class="form-text">{{ row.help }}</div>{% endif %}</div>{% endif %}
+      {% endfor %}
+      <div class="d-flex flex-wrap gap-1">
+        <button class="btn btn-sm btn-primary" name="action" value="save">Enregistrer</button>
+        {% if row.setting %}<button class="btn btn-sm btn-outline-secondary" name="action" value="test" formnovalidate>Tester</button>{% endif %}
+        {% if row.setting.has_key %}<button class="btn btn-sm btn-link text-danger" name="action" value="revoke" formnovalidate data-confirm="Effacer cette clé du serveur ?">Effacer la clé</button>{% endif %}
+      </div>
+    </form>
+  </div></div>
+{% endfor %}
+</div>
+
+<h2 class="h5">Intelligences artificielles en ligne</h2>
+<p class="small text-muted">Les clés se gèrent dans <a href="{% url 'ai:providers' %}">IA → Fournisseurs</a>.
+  L'usage des IA pour traduire suit vos <a href="{% url 'ai:preferences' %}">préférences IA</a> :
+  mode « {{ profile.get_mode_display }} », traduction {% if profile.translation_enabled %}autorisée{% else %}<strong>non autorisée</strong>{% endif %}.</p>
+<table class="table table-sm align-middle"><thead><tr><th>Fournisseur</th><th>État</th><th>Modèles connus</th><th></th></tr></thead><tbody>
+{% for ai in ai_rows %}<tr><td>{{ ai.label }}</td><td><span class="text-{{ ai.status.level }}">{{ ai.status.label }}</span>{% if ai.status.detail %}<div class="small text-muted">{{ ai.status.detail }}</div>{% endif %}</td>
+  <td class="small">{% if ai.models %}{{ ai.models|length }} modèle(s){% else %}—{% endif %}</td>
+  <td><a class="btn btn-sm btn-link" href="{% url 'ai:providers' %}">Gérer la clé</a></td></tr>{% endfor %}
+</tbody></table>
+<h2 class="h5 mt-4" id="conditions">Conditions d'utilisation des textes envoyés</h2>
+<p class="small text-muted">Résumés vérifiés sur les pages officielles des fournisseurs ; les conditions officielles font foi. Avant le premier envoi à un fournisseur, son résumé est affiché et vous confirmez en avoir pris connaissance. Argos ne transmet rien : il traduit sur votre ordinateur.</p>
+{% for t in provider_terms %}<details class="mb-2"><summary>{{ t.name }} <span class="small text-muted">— vérifié le {{ t.verified_on }}{% if t.read %} · lu{% endif %}</span></summary>
+  <ul class="small mt-1 mb-1">{% for p in t.points %}<li>{{ p }}</li>{% endfor %}</ul>
+  <div class="small">{% for s in t.sources %}<a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.label }}</a>{% if not forloop.last %} · {% endif %}{% endfor %}</div></details>{% endfor %}
+{% endblock %}
diff --git a/templates/translation/evaluation.html b/templates/translation/evaluation.html
new file mode 100644
index 0000000..c98ed3c
--- /dev/null
+++ b/templates/translation/evaluation.html
@@ -0,0 +1,20 @@
+{% extends "base.html" %}
+{% block title %}Traduction — Évaluation{% endblock %}
+{% block breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb small"><li class="breadcrumb-item"><a href="{% url 'translation:home' %}">Traduction</a></li><li class="breadcrumb-item active">Évaluation</li></ol></nav>{% endblock %}
+{% block content %}
+<div class="page-head"><div><h1><i class="bi bi-clipboard-check"></i> Évaluation des moteurs</h1>
+  <p>Traduisez un corpus de référence avec plusieurs moteurs, puis notez vous-même chaque traduction. L'appréciation est humaine : l'application ne calcule aucun score de qualité. Les résultats sont datés et conservés pour les comparaisons futures.</p></div></div>
+<div class="card-soft small mb-3">Un corpus de référence est un de vos projets coché « Corpus de référence » (création ou modification du projet). Il ne doit contenir <strong>aucun texte confidentiel</strong> : japonais contemporain, phrases complexes, noms propres, vocabulaire historique, expressions littéraires, termes administratifs anciens, ambiguïtés, quelques segments de japonais classique. Chaque moteur traduit tous les segments, même déjà validés : la comparaison porte sur les mêmes textes. Rien n'est envoyé avant que vous ayez confirmé le coût estimé.</div>
+{% for project, comparisons, n_segments in corpora %}
+<section class="card-soft mb-4"><h2 class="h5"><a href="{% url 'translation:project_detail' project.pk %}">{{ project.title }}</a> <span class="badge text-bg-info">corpus</span>{% if project.confidential %} <span class="badge text-bg-dark">confidentiel : moteurs locaux seulement</span>{% endif %}</h2>
+  <p class="small text-muted">{{ n_segments }} segment(s) à traduire · {{ project.get_source_lang_display }} → {{ project.get_target_lang_display }}</p>
+  <form method="post" action="{% url 'translation:comparison_prepare' project.pk %}">{% csrf_token %}
+    <div class="d-flex flex-wrap gap-3 mb-2">{% for code, label in engines %}<div class="form-check"><input class="form-check-input" type="checkbox" name="engines" value="{{ code }}" id="e-{{ project.pk }}-{{ code }}"><label class="form-check-label" for="e-{{ project.pk }}-{{ code }}">{{ label }}</label></div>{% endfor %}</div>
+    {% for i in "12" %}<div class="row g-2 mb-2" style="max-width:700px"><div class="col-md-5"><select name="ai_provider_{{ i }}" class="form-select form-select-sm" aria-label="Fournisseur IA {{ i }}"><option value="">— IA {{ i }} (facultatif) —</option>{% for code, label in ai_providers %}<option value="{{ code }}" {% if i == "1" and pref.default_engine == "ai" and pref.default_ai_provider == code %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
+      <div class="col-md-7"><input name="ai_model_{{ i }}" class="form-control form-control-sm" placeholder="Modèle" aria-label="Modèle IA {{ i }}" {% if i == "1" and pref.default_engine == "ai" %}value="{{ pref.default_ai_model }}"{% endif %}></div></div>{% endfor %}
+    <button class="btn btn-sm btn-primary">Préparer la comparaison</button> <span class="small text-muted">Rien n'est envoyé à cette étape.</span>
+  </form>
+  {% if comparisons %}<h3 class="h6 mt-3">Comparaisons</h3><ul class="small mb-0">{% for label, jobs in comparisons %}<li><a href="{% url 'translation:comparison' project.pk %}?c={{ label|urlencode }}">{{ label }}</a> — {{ jobs|length }} moteur(s){% for j in jobs %}{% if j.status == 'draft' %} · <span class="text-warning">à confirmer</span>{% endif %}{% endfor %}</li>{% endfor %}</ul>{% endif %}
+</section>
+{% empty %}<p class="text-muted">Aucun corpus de référence. <a href="{% url 'translation:project_create' %}">Créez un projet</a> et cochez « Corpus de référence », puis ajoutez-y vos textes.</p>{% endfor %}
+{% endblock %}
diff --git a/templates/translation/exports_home.html b/templates/translation/exports_home.html
new file mode 100644
