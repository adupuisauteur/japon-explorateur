+"""
+Documents et segments : ajout (collage ou fichier), écran de travail à deux colonnes, page d'un segment
+(versions, comparaison, correction, validation, fusion, division, chapitre), traduction, publication.
+"""
+from django.contrib import messages
+from django.core.paginator import Paginator
+from django.http import Http404
+from django.shortcuts import get_object_or_404, redirect, render
+from django.urls import reverse
+from django.views.decorators.http import require_POST
+
+from apps.core.audit import log_action
+from apps.core.permissions import researcher_required
+
+from .. import glossary as G
+from .. import projects as P
+from .. import services
+from ..forms import DocumentForm
+from ..importers import ImportRefused, import_file
+from ..models import SEGMENT_STATES, TranslationDocument, TranslationSegment, TranslationVersion
+from ..permissions import can_edit_glossary, can_edit_project, can_validate_project, can_view_project, require
+from ..segmentation import is_translatable
+from .projects import get_project_for
+
+
+def _document(request, pk, *, edit=False):
+    document = get_object_or_404(TranslationDocument.objects.select_related("project__owner", "record"), pk=pk)
+    project = document.project
+    if not (can_edit_project(request.user, project) if edit else can_view_project(request.user, project)):
+        raise Http404
+    return document
+
+
+def _segment(request, pk, *, edit=False):
+    segment = get_object_or_404(TranslationSegment.objects.select_related("document__project__owner", "chapter"), pk=pk)
+    project = segment.document.project
+    if not (can_edit_project(request.user, project) if edit else can_view_project(request.user, project)):
+        raise Http404
+    return segment
+
+
+def _workbench_url(segment):
+    return reverse("translation:document_workbench", args=[segment.document_id]) + f"#seg-{segment.pk}"
+
+
+@researcher_required
+def document_add(request, project_pk):
+    project = get_project_for(request, project_pk, edit=True)
+    form = DocumentForm(request.POST or None, request.FILES or None)
+    preview = None
+    if request.method == "POST" and request.POST.get("confirmed_text") is not None:
+        # Deuxième étape après un encodage incertain : texte décodé revu par l'utilisateur.
+        if not request.POST.get("confirm_encoding"):
+            messages.error(request, "Cochez la confirmation après avoir vérifié l'aperçu.")
+        else:
+            document = P.create_document(
+                project, title=request.POST.get("title", ""), text=request.POST["confirmed_text"],
+                source_kind=request.POST.get("source_kind", "txt"), filename=request.POST.get("filename", ""),
+                encoding=request.POST.get("encoding", ""), confidence="uncertain",
+                variety=request.POST.get("variety", "modern"))
+            return _created(request, document)
+    elif request.method == "POST" and form.is_valid():
+        data = form.cleaned_data
+        try:
+            if data.get("file"):
+                imported = import_file(data["file"])
+                if imported.confidence == "uncertain":
+                    preview = imported
+                else:
+                    for note in imported.notes:
+                        messages.info(request, note)
+                    document = P.create_document(project, title=data["title"], text=imported.text,
+                                                 source_kind=imported.kind, filename=imported.filename,
+                                                 encoding=imported.encoding, confidence=imported.confidence,
+                                                 variety=data["variety"])
+                    return _created(request, document)
+            else:
+                document = P.create_document(project, title=data["title"], text=data["text"], source_kind="paste",
+                                             variety=data["variety"])
+                return _created(request, document)
+        except (ImportRefused, P.ProjectError) as exc:
+            messages.error(request, str(exc))
+    return render(request, "translation/document_form.html", {"project": project, "form": form, "preview": preview,
+                                                              "form_data": request.POST})
+
+
+def _created(request, document):
+    n = document.segments.count()
+    log_action(request, "translation.document_created", document, f"{n} segment(s)")
+    messages.success(request, f"Document importé et découpé en {n} segment(s). Le texte importé est conservé à "
+                              "l'identique.")
+    return redirect("translation:document_workbench", pk=document.pk)
+
+
+@researcher_required
+def document_workbench(request, pk):
+    document = _document(request, pk)
+    project = document.project
+    segments = document.segments.select_related("chapter").prefetch_related("versions").order_by("position")
+    state = request.GET.get("etat", "")
+    if state in dict(SEGMENT_STATES):
+        segments = segments.filter(state=state)
+    chapter = request.GET.get("chapitre", "")
+    if chapter.isdigit():
+        segments = segments.filter(chapter_id=int(chapter))
+    page = Paginator(segments, 100).get_page(request.GET.get("page"))
+    rows = []
+    for seg in page:
+        versions = sorted(seg.versions.all(), key=lambda v: v.created_at, reverse=True)
+        shown = next((v for v in versions if v.status == "validated"), None) or next(
+            (v for v in versions if v.status == "proposed"), None)
+        rows.append({"segment": seg, "shown": shown, "n_versions": len(versions),
+                     "translatable": is_translatable(seg.source_text)})
+    counts = {code: document.segments.filter(state=code).count() for code, _ in SEGMENT_STATES}
+    return render(request, "translation/workbench.html", {
+        "document": document, "project": project, "rows": rows, "page": page, "states": SEGMENT_STATES,
+        "state": state, "chapter": chapter, "chapters": document.chapters.order_by("order"), "counts": counts,
+        "total": sum(counts.values()), "can_edit": can_edit_project(request.user, project),
+        "can_validate": can_validate_project(request.user, project), "notice_field": P.notice_field(document),
+        "integrity": P.integrity_ok(document),
+    })
+
+
+@researcher_required
+@require_POST
+def document_bulk(request, pk):
+    document = _document(request, pk, edit=True)
+    project = document.project
+    ids = [int(i) for i in request.POST.getlist("segments") if i.isdigit()]
+    scope = request.POST.get("scope", "selected")
+    segments = document.segments.order_by("position")
+    if scope == "untranslated":
+        segments = segments.filter(state="untranslated")
+    elif scope.startswith("chapter:") and scope[8:].isdigit():
+        segments = segments.filter(chapter_id=int(scope[8:]))
+    else:
+        segments = segments.filter(pk__in=ids)
+    segments = [s for s in segments if is_translatable(s.source_text)]
+    if not segments:
+        messages.error(request, "Aucun segment à traiter (sélectionnez des segments).")
+        return redirect("translation:document_workbench", pk=document.pk)
+    action = request.POST.get("action")
+    if action == "validate":
+        require(can_validate_project(request.user, project))
+        n = P.validate_latest_proposals(segments, request.user)
+        messages.success(request, f"{n} traduction(s) validée(s).")
+        return redirect("translation:document_workbench", pk=document.pk)
+    which = "second" if request.POST.get("engine") == "second" else "default"
+    try:
+        job = services.prepare_segments_job(request.user, segments, project=project,
+                                            choice=services.resolve_choice(request.user, project=project, which=which))
+    except services.TranslationUnavailable as exc:
+        messages.error(request, str(exc))
+        return redirect("translation:document_workbench", pk=document.pk)
+    return redirect("translation:job_detail", pk=job.pk)
+
+
+@researcher_required
+def segment_detail(request, pk):
+    segment = _segment(request, pk)
+    project = segment.document.project
+    versions = segment.versions.select_related("author", "decided_by", "parent").order_by("-created_at")
+    neighbours = TranslationSegment.objects.filter(document=segment.document,
+                                                   position__in=(segment.position - 1, segment.position + 1))
+    return render(request, "translation/segment_detail.html", {
+        "segment": segment, "document": segment.document, "project": project, "versions": versions,
+        "previous": next((s for s in neighbours if s.position < segment.position), None),
+        "next": next((s for s in neighbours if s.position > segment.position), None),
+        "can_edit": can_edit_project(request.user, project), "can_validate": can_validate_project(request.user, project),
+        "edit_from": versions.filter(pk=request.GET.get("corriger")).first() if request.GET.get("corriger") else None,
+        "terms_found": G.terms_in(segment.source_text, G.project_terms(project), project.source_lang),
+        "term_glossaries": [g for g in G.project_glossaries(project) if can_edit_glossary(request.user, g)],
+        "term_categories": G.GLOSSARY_CATEGORIES,
+    })
+
+
+@researcher_required
+@require_POST
+def segment_action(request, pk):
+    segment = _segment(request, pk, edit=True)
+    project = segment.document.project
+    action = request.POST.get("action")
+    try:
+        if action == "translate":
+            which = "second" if request.POST.get("engine") == "second" else "default"
+            job = services.prepare_segments_job(request.user, [segment], project=project,
+                                                choice=services.resolve_choice(request.user, project=project,
+                                                                               which=which))
+            return redirect("translation:job_detail", pk=job.pk)
+        if action == "human":
+            parent = segment.versions.filter(pk=request.POST.get("parent")).first() if request.POST.get("parent") else None
+            P.add_human_version(segment, request.user, request.POST.get("text", ""), parent=parent)
+            messages.success(request, "Traduction enregistrée comme nouvelle version (proposée).")
+        elif action == "merge":
+            P.merge_with_next(segment)
+            messages.success(request, "Segments fusionnés ; le texte importé est inchangé.")
+        elif action == "split":
+            P.split_segment(segment, request.POST.get("first_part", ""))
+            messages.success(request, "Segment divisé ; le texte importé est inchangé.")
+        elif action == "chapter":
+            P.start_chapter(segment, request.POST.get("title", ""))
+            messages.success(request, "Chapitre créé.")
+    except (P.ProjectError, services.TranslationUnavailable) as exc:
+        messages.error(request, str(exc))
+        return redirect("translation:segment_detail", pk=segment.pk)
+    return redirect(_workbench_url(segment) if action in ("merge", "split", "chapter") else
+                    reverse("translation:segment_detail", args=[segment.pk]))
+
+
+@researcher_required
+@require_POST
+def version_action(request, pk):
+    version = get_object_or_404(TranslationVersion.objects.select_related("segment__document__project"), pk=pk)
+    project = version.segment.document.project
+    if not can_view_project(request.user, project):
+        raise Http404
+    require(can_validate_project(request.user, project))  # seul le propriétaire valide (C2)
+    action = request.POST.get("action")
+    if action == "validate":
+        P.validate_version(version, request.user)
+        messages.success(request, "Version validée ; la précédente redevient proposée.")
+    elif action == "reject":
+        P.reject_version(version, request.user)
+        messages.info(request, "Version rejetée (conservée dans l'historique).")
+    return redirect("translation:segment_detail", pk=version.segment_id)
+
+
+@researcher_required
+@require_POST
+def document_publish(request, pk):
+    document = _document(request, pk, edit=True)
+    require(can_validate_project(request.user, document.project))
+    if not request.POST.get("confirm_publish"):
+        messages.error(request, "Cochez la confirmation : la traduction publiée sera visible par tous les comptes.")
+        return redirect("translation:document_workbench", pk=document.pk)
+    try:
+        ed = P.publish_to_record(document, request.user)
+    except P.ProjectError as exc:
+        messages.error(request, str(exc))
+        return redirect("translation:document_workbench", pk=document.pk)
+    log_action(request, "translation.published", ed,
+               f"Document {document.pk} publié dans la notice (projet {'confidentiel' if document.project.confidential else 'ordinaire'})")
+    messages.success(request, "Traduction publiée dans la notice comme proposition ; un administrateur peut la "
+                              "valider (et l'adopter) depuis la notice.")
+    return redirect("translation:record_translations", record_id=document.record.record_id)
diff --git a/apps/translation/views/engines.py b/apps/translation/views/engines.py
new file mode 100644
index 0000000..c388c30
--- /dev/null
+++ b/apps/translation/views/engines.py
@@ -0,0 +1,155 @@
+"""
+Traduction → Moteurs : lieu UNIQUE du choix des moteurs de traduction (décision « point unique »).
+
+- DeepL et Google : clé saisie ici, chiffrée, jamais réaffichée ; test sans texte réel quand c'est possible.
+- Argos : activation (mode simulé tant que le service et ses paquets ne sont pas installés).
+- IA : état lu dans le module IA ; les clés restent dans IA → Fournisseurs.
+Enregistrer un réglage ne lance jamais de traduction.
+"""
+from django.contrib import messages
+from django.core.exceptions import ImproperlyConfigured
+from django.shortcuts import redirect, render
+from django.utils import timezone
+from django.views.decorators.http import require_POST
+
+from apps.ai.crypto import encrypt_secret, encryption_available
+from apps.ai.models import PROVIDERS as AI_PROVIDERS
+from apps.ai.models import AIProviderCredential
+from apps.ai.preferences import active_profile
+from apps.core.audit import log_action
+from apps.core.permissions import researcher_required
+
+from ..engines.base import TranslationEngineError
+from ..engines.registry import ENGINE_CLASSES, get_engine
+from .. import terms
+from ..forms import EngineSettingForm, PreferenceForm
+from ..journal import record_translation_error
+from ..models import SETTING_ENGINES, EngineSetting
+
+KEY_HELP = {
+    "deepl": "Clé de l'API DeepL (compte DeepL API, offre gratuite ou payante).",
+    "google_basic": "Clé d'API Google Cloud, restreinte à l'API Cloud Translation.",
+}
+
+
+def preference_for(user):
+    from ..services import ensure_preference
+
+    return ensure_preference(user)
+
+
+@researcher_required
+def engines(request):
+    user = request.user
+    settings_by_engine = {s.engine: s for s in EngineSetting.objects.filter(user=user)}
+    rows = []
+    for code, label in SETTING_ENGINES:
+        setting = settings_by_engine.get(code)
+        engine = get_engine(code, user)
+        initial = {"enabled": setting.enabled if setting else True}
+        if setting:
+            initial.update({"plan": setting.plan, "monthly_char_cap": setting.monthly_char_cap})
+        rows.append({"code": code, "label": label, "setting": setting, "status": engine.status(),
+                     "form": EngineSettingForm(engine=code, initial=initial), "help": KEY_HELP.get(code, ""),
+                     "cls": ENGINE_CLASSES[code]})
+    credentials = {c.provider: c for c in AIProviderCredential.objects.filter(user=user)}
+    profile = active_profile(user)
+    ai_rows = []
+    for code, label in AI_PROVIDERS:
+        cred = credentials.get(code)
+        engine = get_engine("ai", user, ai_provider=code, ai_model="(modèle)")
+        ai_rows.append({"code": code, "label": label, "credential": cred, "status": engine.status(),
+                        "models": (cred.available_models if cred else [])[:300]})
+    pref = preference_for(user)
+    return render(request, "translation/engines.html", {
+        "rows": rows, "ai_rows": ai_rows, "profile": profile, "pref": pref,
+        "pref_form": PreferenceForm(instance=pref), "encryption_ok": encryption_available(),
+        "default_status": _choice_status(user, pref, "default"), "second_status": _choice_status(user, pref, "second"),
+        "provider_terms": [dict(t, read=terms.acknowledged(user, t["key"])) for t in terms.all_terms()],
+    })
+
+
+def _choice_status(user, pref, prefix):
+    code = getattr(pref, f"{prefix}_engine")
+    if not code:
+        return None
+    engine = get_engine(code, user, ai_provider=getattr(pref, f"{prefix}_ai_provider"),
+                        ai_model=getattr(pref, f"{prefix}_ai_model"))
+    return {"name": engine.display_name, "status": engine.status()}
+
+
+@researcher_required
+@require_POST
+def engine_save(request, code):
+    if code not in dict(SETTING_ENGINES):
+        return redirect("translation:engines")
+    user = request.user
+    setting, _ = EngineSetting.objects.get_or_create(user=user, engine=code)
+    action = request.POST.get("action", "save")
+    label = setting.get_engine_display()
+    if action == "revoke":
+        setting.encrypted_key = ""
+        setting.status = "revoked"
+        setting.quota_info = {}
+        setting.save()
+        log_action(request, "translation.key_revoked", setting, label)
+        messages.info(request, f"Clé {label} effacée du serveur.")
+        return redirect("translation:engines")
+    if action == "test":
+        engine = get_engine(code, user)
+        try:
+            message = engine.test()
+            setting.status, setting.last_error = "ok", ""
+            messages.success(request, message)
+        except TranslationEngineError as exc:
+            setting.status, setting.last_error = "error", str(exc)[:500]
+            record_translation_error(exc, engine=code, operation="Test du moteur depuis Traduction → Moteurs")
+            messages.error(request, f"Échec du test : {exc}")
+        except ImproperlyConfigured as exc:
+            setting.status, setting.last_error = "error", str(exc)[:500]
+            messages.error(request, str(exc))
+        setting.last_tested_at = timezone.now()
+        setting.save()
+        return redirect("translation:engines")
+    form = EngineSettingForm(request.POST, engine=code)
+    if not form.is_valid():
+        messages.error(request, "Réglage invalide : " + "; ".join(e for errs in form.errors.values() for e in errs))
+        return redirect("translation:engines")
+    key = form.cleaned_data.get("api_key") or ""
+    if key:
+        try:
+            setting.encrypted_key = encrypt_secret(key)
+        except ImproperlyConfigured as exc:
+            messages.error(request, str(exc))
+            return redirect("translation:engines")
+        setting.status = "untested"
+        setting.quota_info = {}
+    if "plan" in form.cleaned_data:
+        if form.cleaned_data["plan"] != setting.plan:
+            setting.status = "untested" if setting.has_key else setting.status
+        setting.plan = form.cleaned_data["plan"]
+    setting.monthly_char_cap = form.cleaned_data.get("monthly_char_cap")
+    setting.enabled = bool(form.cleaned_data.get("enabled"))
+    setting.save()
+    log_action(request, "translation.engine_saved", setting,
+               f"{label} : {'clé enregistrée (chiffrée), ' if key else ''}actif={setting.enabled}")
+    messages.success(request, f"Réglage {label} enregistré." + (" Clé chiffrée ; elle ne sera plus affichée. "
+                                                                "Testez la connexion." if key else "")
+                     + " Aucune traduction n'a été lancée.")
+    return redirect("translation:engines")
+
+
+@researcher_required
+@require_POST
+def preferences_save(request):
+    pref = preference_for(request.user)
+    form = PreferenceForm(request.POST, instance=pref)
+    if form.is_valid():
+        form.save()
+        log_action(request, "translation.preferences", pref,
+                   f"Moteur par défaut : {pref.default_engine or '—'} ; deuxième : {pref.second_engine or '—'}")
+        messages.success(request, "Choix des moteurs enregistré. Aucune traduction n'a été lancée.")
+    else:
+        messages.error(request, "Choix non enregistré : "
+                       + "; ".join(e for errs in form.errors.values() for e in errs))
+    return redirect("translation:engines")
diff --git a/apps/translation/views/evaluation.py b/apps/translation/views/evaluation.py
new file mode 100644
index 0000000..5bebc10
--- /dev/null
+++ b/apps/translation/views/evaluation.py
@@ -0,0 +1,136 @@
+"""Traduction → Évaluation : corpus de référence, comparaison des moteurs, notation humaine (lot 10)."""
+from urllib.parse import quote, unquote
+
+from django.contrib import messages
+from django.http import Http404
+from django.shortcuts import get_object_or_404, redirect, render
+from django.urls import reverse
+from django.views.decorators.http import require_POST
+
+from apps.ai.models import PROVIDERS as AI_PROVIDERS
+from apps.core.audit import log_action
+from apps.core.permissions import researcher_required
+
+from .. import evaluation as E
+from .. import services
+from ..models import ENGINES, RATINGS, TranslationProject, TranslationVersion
+
+
+def _corpus(request, pk):
+    project = get_object_or_404(TranslationProject, pk=pk, owner=request.user)  # propriétaire seulement
+    if not project.is_reference_corpus:
+        raise Http404
+    return project
+
+
+@researcher_required
+def evaluation_home(request):
+    corpora = E.corpus_projects(request.user)
+    return render(request, "translation/evaluation.html", {
+        "corpora": [(p, E.comparisons(request.user, p)[:5], len(E.corpus_segments(p))) for p in corpora],
+        "engines": [(code, label) for code, label in ENGINES if code != "ai"], "ai_providers": AI_PROVIDERS,
+        "pref": services.ensure_preference(request.user),
+    })
+
+
+def _choices(request):
+    choices = [services.EngineChoice(code) for code in request.POST.getlist("engines") if code in dict(ENGINES)
+               and code != "ai"]
+    for i in (1, 2):
+        provider, model = request.POST.get(f"ai_provider_{i}", ""), request.POST.get(f"ai_model_{i}", "").strip()
+        if provider and model and provider in dict(AI_PROVIDERS):
+            choices.append(services.EngineChoice("ai", provider, model))
+    return choices
+
+
+@researcher_required
+@require_POST
+def comparison_prepare(request, pk):
+    project = _corpus(request, pk)
+    try:
+        label, jobs, errors = E.prepare_comparison(request.user, project, _choices(request))
+    except E.EvaluationError as exc:
+        messages.error(request, str(exc))
+        return redirect("translation:evaluation")
+    for choice, error in errors:
+        messages.warning(request, f"{choice.engine(request.user).display_name} écarté : {error}")
+    if not jobs:
+        messages.error(request, "Aucun moteur utilisable : rien n'a été préparé.")
+        return redirect("translation:evaluation")
+    return redirect(_comparison_url(project, label))
+
+
+def _unique_terms(drafts):
+    seen, out = set(), []
+    for job in drafts:
+        entry = services._terms_needed(job)
+        if entry and entry["key"] not in seen:
+            seen.add(entry["key"])
+            out.append(entry)
+    return out
+
+
+def _comparison_url(project, label):
+    return reverse("translation:comparison", args=[project.pk]) + "?c=" + quote(label)
+
+
+@researcher_required
+def comparison(request, pk):
+    project = _corpus(request, pk)
+    label = unquote(request.GET.get("c", ""))
+    jobs = E.comparison_jobs(request.user, project, label)
+    if not jobs:
+        raise Http404
+    drafts = [j for j in jobs if j.status == "draft"]
+    return render(request, "translation/comparison.html", {
+        "project": project, "label": label, "jobs": jobs, "rows": E.rows(jobs), "summary": E.rating_summary(jobs),
+        "drafts": [(j, services.summary(j), services.engine_label(j)) for j in drafts],
+        "needs_second": any(j.requires_second_confirmation for j in drafts),
+        "terms": _unique_terms(drafts),
+        "ratings": RATINGS, "columns": [(j, services.engine_label(j)) for j in jobs],
+        "running": any(j.status in ("confirmed", "running") and not services.is_stale(j) for j in jobs),
+        "url": _comparison_url(project, label),
+    })
+
+
+@researcher_required
+@require_POST
+def comparison_action(request, pk):
+    project = _corpus(request, pk)
+    label = request.POST.get("c", "")
+    jobs = E.comparison_jobs(request.user, project, label)
+    if not jobs:
+        raise Http404
+    action = request.POST.get("action")
+    if action == "confirm":
+        started, errors = E.confirm_all(jobs, request.user,
+                                        second_confirmation=bool(request.POST.get("second_confirmation")),
+                                        terms_acknowledged=bool(request.POST.get("terms_acknowledged")))
+        for job in started:
+            log_action(request, "translation.job_confirmed", job,
+                       f"Comparaison sur le corpus — {services.engine_label(job)} : {job.chars_estimated} caractère(s)")
+        for job, error in errors:
+            messages.error(request, f"{services.engine_label(job)} : {error}")
+        if started:
+            messages.success(request, f"{len(started)} traduction(s) du corpus lancée(s).")
+    elif action == "cancel":
+        for job in jobs:
+            if job.status == "draft":
+                services.cancel(job, request.user)
+        messages.info(request, "Moteurs non lancés annulés : rien ne leur a été envoyé.")
+    return redirect(_comparison_url(project, label))
+
+
+@researcher_required
+@require_POST
+def version_rate(request, pk):
+    version = get_object_or_404(TranslationVersion.objects.select_related("segment__document__project"), pk=pk)
+    project = version.segment.document.project
+    if project.owner_id != request.user.pk:
+        raise Http404
+    try:
+        E.rate(version, request.user, request.POST.get("rating", ""), request.POST.get("comment", ""))
+    except E.EvaluationError as exc:
+        messages.error(request, str(exc))
+    back = request.POST.get("next", "")
+    return redirect(back if back.startswith("/traduction/") else "translation:evaluation")
