diff --git a/templates/connectors/jps_databases.html b/templates/connectors/jps_databases.html
new file mode 100644
index 0000000..5c19232
--- /dev/null
+++ b/templates/connectors/jps_databases.html
@@ -0,0 +1,33 @@
+{% extends "base.html" %}
+{% block title %}Trouver une base Japan Search{% endblock %}
+{% block content %}
+<nav class="small mb-2"><a href="{% url 'connectors:list' %}">Sources</a> › <a href="{% url 'connectors:detail' 'japansearch' %}">Japan Search</a> › Trouver une base</nav>
+<div class="page-head"><div><h1>Trouver une base Japan Search</h1>
+  <p>Japan Search regroupe les catalogues de nombreuses institutions japonaises (archives nationales et préfectorales, universités, musées…). Cherchez une institution ou une collection, puis créez une source qui n'interroge que cette base, avec l'API officielle de Japan Search. La recherche ne s'effectue que lorsque vous cliquez sur « Chercher ».</p></div></div>
+<form method="get" class="card-soft d-flex flex-wrap gap-2 align-items-end mb-3" style="max-width: 44rem">
+  <div class="flex-grow-1"><label class="form-label" for="q">Institution ou collection (japonais conseillé)</label>
+    <input id="q" name="q" value="{{ q }}" class="form-control" placeholder="国立公文書館, 早稲田, 京都大学, 日文研, 公文書館…" required></div>
+  <button class="btn btn-primary"><i class="bi bi-search"></i> Chercher</button>
+</form>
+{% if error %}<div class="alert alert-warning">La liste des bases n'a pas pu être obtenue : {{ error }} L'incident a été ajouté au <a href="{% url 'incidents:list' %}?source=japansearch">journal des dysfonctionnements</a>.</div>{% endif %}
+{% if q and not error %}
+  {% if found %}
+  <div class="table-responsive"><table class="table table-sm align-middle">
+    <thead><tr><th>Base</th><th>Institution</th><th>Notices</th><th>API</th><th></th></tr></thead>
+    <tbody>{% for db in found %}<tr>
+      <td><span class="ja">{{ db.name }}</span>{% if db.name_en %}<div class="small text-muted">{{ db.name_en }}</div>{% endif %}<div class="small"><code>{{ db.id }}</code></div></td>
+      <td class="ja small">{{ db.provider|default:"—" }}</td>
+      <td class="small">{{ db.records|default:"?" }}</td>
+      <td>{% if db.api_ok %}<span class="chip chip-ok">diffusée</span>{% else %}<span class="chip chip-warn" title="L'institution n'autorise pas la diffusion de ces métadonnées par API">non diffusée</span>{% endif %}</td>
+      <td class="text-end">
+        {% if db.id in existing %}<span class="small text-muted">Déjà configurée</span>
+        {% elif db.api_ok %}
+        <form method="post" action="{% url 'connectors:jps_create_source' %}">{% csrf_token %}
+          <input type="hidden" name="db_id" value="{{ db.id }}"><input type="hidden" name="name" value="{{ db.name }}">
+          <input type="hidden" name="provider" value="{{ db.provider }}"><input type="hidden" name="url" value="{{ db.url }}">
+          <button class="btn btn-sm btn-outline-primary">Créer une source</button></form>
+        {% else %}<span class="small text-muted">Consultation externe uniquement</span>{% endif %}
+      </td></tr>{% endfor %}</tbody></table></div>
+  {% else %}<div class="empty">Aucune base ne correspond à « {{ q }} ». Essayez le nom japonais de l'institution.</div>{% endif %}
+{% endif %}
+{% endblock %}
diff --git a/templates/incidents/analysis.html b/templates/incidents/analysis.html
new file mode 100644
index 0000000..265258b
--- /dev/null
+++ b/templates/incidents/analysis.html
@@ -0,0 +1,39 @@
+{% extends "base.html" %}{% load app_tags %}
+{% block title %}Analyse des dysfonctionnements{% endblock %}
+{% block content %}
+<nav class="small mb-2"><a href="{% url 'incidents:list' %}">Journal des dysfonctionnements</a> › Analyse</nav>
+<div class="page-head"><div><h1>Analyse des dysfonctionnements</h1>
+  <p>Regroupements simples sur les {{ days }} derniers jours, pour repérer les problèmes qui reviennent. Les indisponibilités temporaires d'une source sont comptées à part : elles ne signifient pas que le connecteur est défectueux.</p></div>
+  <form method="get" class="d-flex gap-2 align-items-end"><div><label class="form-label small" for="j">Période (jours)</label><input id="j" name="jours" type="number" min="1" max="3650" value="{{ days }}" class="form-control form-control-sm" style="width:7rem"></div><button class="btn btn-sm btn-outline-secondary">Appliquer</button></form></div>
+
+{% if network_bursts %}
+<div class="alert alert-warning"><strong><i class="bi bi-wifi-off"></i> Plusieurs sources ont échoué en même temps.</strong> {{ origin_help.reseau }}
+  <ul class="small mb-0 mt-1">{% for at, sources in network_bursts %}<li>{{ at|date:"d/m/Y H:i" }} : {{ sources|join:", " }}</li>{% endfor %}</ul></div>
+{% endif %}
+
+<div class="row g-3">
+  <div class="col-lg-6"><div class="card-soft h-100"><h2 class="h6">Erreurs récurrentes</h2>
+    <table class="table table-sm small mb-0"><thead><tr><th>Incident</th><th>Fois</th><th>Statut</th></tr></thead><tbody>
+    {% for i in recurrent %}<tr><td><a href="{{ i.get_absolute_url }}">{{ i.uid }}</a> — {{ i.title|truncatechars:60 }}</td><td>{{ i.occurrence_count }}</td><td>{% incident_status_chip i %}</td></tr>
+    {% empty %}<tr><td colspan="3" class="text-muted">Aucune erreur répétée.</td></tr>{% endfor %}</tbody></table></div></div>
+
+  <div class="col-lg-6"><div class="card-soft h-100"><h2 class="h6">Sources les plus instables (indisponibilités)</h2>
+    <table class="table table-sm small mb-0"><thead><tr><th>Source</th><th>Indisponibilités</th><th></th></tr></thead><tbody>
+    {% for s in unstable %}<tr><td>{{ s.source_code }}</td><td>{{ s.n }}</td><td><a href="{% url 'incidents:list' %}?source={{ s.source_code }}&module=">Historique</a></td></tr>
+    {% empty %}<tr><td colspan="3" class="text-muted">Aucune indisponibilité sur la période.</td></tr>{% endfor %}</tbody></table></div></div>
+
+  <div class="col-lg-6"><div class="card-soft h-100"><h2 class="h6">Connecteurs qui échouent régulièrement</h2>
+    <p class="small text-muted">Erreurs techniques, réponses illisibles, erreurs de traitement ou de configuration : une correction du connecteur est probablement nécessaire.</p>
+    <table class="table table-sm small mb-0"><thead><tr><th>Source</th><th>Échecs</th><th>Incidents distincts</th></tr></thead><tbody>
+    {% for s in failing %}<tr><td><a href="{% url 'incidents:list' %}?source={{ s.source_code }}">{{ s.source_code }}</a></td><td>{{ s.n }}</td><td>{{ s.k }}</td></tr>
+    {% empty %}<tr><td colspan="3" class="text-muted">Aucun échec de connecteur sur la période.</td></tr>{% endfor %}</tbody></table></div></div>
+
+  <div class="col-lg-6"><div class="card-soft h-100"><h2 class="h6">Apparus avec la version actuelle ({{ APP_VERSION }})</h2>
+    <ul class="small mb-2">{% for i in new_in_version %}<li><a href="{{ i.get_absolute_url }}">{{ i.uid }}</a> — {{ i.title|truncatechars:70 }}</li>{% empty %}<li class="text-muted">Aucun.</li>{% endfor %}</ul>
+    <h3 class="h6 mt-3">Nouveaux incidents par version</h3>
+    <ul class="small mb-0">{% for v in by_version %}<li>Version {{ v.first_seen_version }} : {{ v.n }}</li>{% empty %}<li class="text-muted">—</li>{% endfor %}</ul></div></div>
+
+  <div class="col-12"><div class="card-soft"><h2 class="h6">Incidents corrigés qui sont réapparus</h2>
+    <ul class="small mb-0">{% for i in reappeared %}<li><a href="{{ i.get_absolute_url }}">{{ i.uid }}</a> — {{ i.title|truncatechars:80 }} : corrigé{% if i.fixed_in_version %} en {{ i.fixed_in_version }}{% endif %}, réapparu {{ i.reappeared_count }} fois (dernière fois en version {{ i.last_seen_version }})</li>{% empty %}<li class="text-muted">Aucune réapparition.</li>{% endfor %}</ul></div></div>
+</div>
+{% endblock %}
diff --git a/templates/incidents/detail.html b/templates/incidents/detail.html
new file mode 100644
index 0000000..00fd3ac
--- /dev/null
+++ b/templates/incidents/detail.html
@@ -0,0 +1,98 @@
+{% extends "base.html" %}{% load app_tags %}
+{% block title %}{{ incident.uid }}{% endblock %}
+{% block content %}
+<nav class="small mb-2"><a href="{% url 'incidents:list' %}">Journal des dysfonctionnements</a> › {{ incident.uid }}</nav>
+<div class="page-head">
+  <div>
+    <h1 class="h3">{{ incident.title }}</h1>
+    <p class="d-flex flex-wrap gap-1 align-items-center"><code class="me-2">{{ incident.uid }}</code>{% severity_chip incident %} {% incident_status_chip incident %}
+      {% if incident.is_manual %}<span class="chip chip-new"><i class="bi bi-person"></i> signalement manuel</span>{% endif %}
+      {% if incident.reappeared_count %}<span class="chip chip-warn">réapparu ×{{ incident.reappeared_count }} après correction</span>{% endif %}</p>
+  </div>
+  <div class="d-flex flex-wrap gap-2">
+    <a class="btn btn-outline-primary" href="{% url 'incidents:export' incident.uid %}"><i class="bi bi-file-earmark-arrow-down"></i> Exporter le diagnostic</a>
+    {% if incident.source_code %}<a class="btn btn-outline-secondary" href="{% url 'incidents:list' %}?source={{ incident.source_code }}">Historique de la source</a>{% endif %}
+  </div>
+</div>
+
+<div class="row g-4">
+  <div class="col-lg-7">
+    <div class="alert alert-light border">
+      <div class="fw-semibold mb-1"><i class="bi bi-lightbulb"></i> Origine probable : {{ incident.get_origin_display }}</div>
+      <div class="small">{{ incident.origin_help }}</div>
+    </div>
+    <div class="card-soft mb-3">
+      <dl class="fields">
+        <dt>Module</dt><dd>{{ incident.get_module_display }}</dd>
+        {% if incident.source_code %}<dt>Source documentaire</dt><dd>{{ incident.source_code }}</dd>{% endif %}
+        <dt>Catégorie</dt><dd>{{ incident.get_category_display }}</dd>
+        <dt>Opération en cours</dt><dd class="ja">{{ incident.operation|default:"—" }}</dd>
+        <dt>Message</dt><dd class="ja">{{ incident.message|default:"—"|linebreaksbr }}</dd>
+        {% if incident.technical_code %}<dt>Code technique</dt><dd><code>{{ incident.technical_code }}</code></dd>{% endif %}
+        {% if incident.http_status %}<dt>Code HTTP</dt><dd><code>{{ incident.http_status }}</code></dd>{% endif %}
+        {% if incident.last_request_id %}<dt>Identifiant de requête</dt><dd><code>{{ incident.last_request_id }}</code></dd>{% endif %}
+        <dt>Première occurrence</dt><dd>{{ incident.first_seen_at|date:"d/m/Y H:i:s" }} (version {{ incident.first_seen_version }})</dd>
+        <dt>Dernière occurrence</dt><dd>{{ incident.last_seen_at|date:"d/m/Y H:i:s" }} (version {{ incident.last_seen_version }})</dd>
+        <dt>Nombre d'occurrences</dt><dd>{{ incident.occurrence_count }}</dd>
+        {% if incident.fixed_in_version %}<dt>Corrigé dans la version</dt><dd>{{ incident.fixed_in_version }}{% if incident.fixed_at %} (le {{ incident.fixed_at|date:"d/m/Y" }}){% endif %}</dd>{% endif %}
+        {% if incident.is_manual %}
+        <dt>Opérations réalisées</dt><dd>{{ incident.steps|default:"—"|linebreaksbr }}</dd>
+        <dt>Résultat attendu</dt><dd>{{ incident.expected|default:"—"|linebreaksbr }}</dd>
+        <dt>Résultat obtenu</dt><dd>{{ incident.obtained|default:"—"|linebreaksbr }}</dd>
+        {% if incident.screenshot %}<dt>Capture d'écran</dt><dd><a href="{% url 'incidents:screenshot' incident.uid %}" target="_blank">Ouvrir la capture</a></dd>{% endif %}
+        {% endif %}
+      </dl>
+    </div>
+
+    {% if comparison %}
+    <div class="card-soft mb-3">
+      <h2 class="h6">Avant / après correction</h2>
+      <p class="small mb-0">Corrigé le {{ comparison.fixed_at|date:"d/m/Y H:i" }}{% if comparison.fixed_in_version %} (version {{ comparison.fixed_in_version }}){% endif %} :
+        <strong>{{ comparison.before }}</strong> occurrence(s) avant{% if comparison.last_before %}, la dernière le {{ comparison.last_before.occurred_at|date:"d/m/Y H:i" }}{% endif %} ;
+        <strong>{{ comparison.after }}</strong> après{% if comparison.first_after %}, la première le {{ comparison.first_after.occurred_at|date:"d/m/Y H:i" }} (version {{ comparison.first_after.app_version }}){% endif %}.
+        {% if comparison.after == 0 %}<span class="text-success">Aucune réapparition depuis la correction.</span>{% endif %}</p>
+    </div>
+    {% endif %}
+
+    <details class="card-soft mb-3">
+      <summary class="fw-semibold">Détail technique (contexte expurgé)</summary>
+      <pre class="diag-pre mt-2 mb-0">{{ incident.context|pretty_json }}</pre>
+    </details>
+
+    <div class="card-soft">
+      <h2 class="h6">Occurrences récentes</h2>
+      <div class="table-responsive"><table class="table table-sm small mb-0">
+        <thead><tr><th>Date</th><th>Version</th><th>Requête</th><th>HTTP</th><th>Opération</th></tr></thead>
+        <tbody>{% for o in occurrences %}
+          <tr><td class="text-nowrap">{{ o.occurred_at|date:"d/m/Y H:i:s" }}</td><td>{{ o.app_version }}</td><td><code>{{ o.request_id|default:"—" }}</code></td><td>{{ o.http_status|default:"" }}</td><td class="ja">{{ o.operation|truncatechars:80 }}</td></tr>
+        {% endfor %}</tbody></table></div>
+      {% if incident.occurrence_count > occurrences|length %}<p class="small text-muted mt-2 mb-0">{{ occurrences|length }} affichée(s) sur {{ incident.occurrence_count }}.</p>{% endif %}
+    </div>
+  </div>
+
+  <div class="col-lg-5">
+    {% if status_form %}
+    <form method="post" action="{% url 'incidents:status' incident.uid %}" class="card-soft mb-3">{% csrf_token %}
+      <h2 class="h6">Suivi de la correction</h2>
+      {% for field in status_form %}<div class="mb-2"><label class="form-label small" for="{{ field.id_for_label }}">{{ field.label }}</label>{{ field }}</div>{% endfor %}
+      <button class="btn btn-sm btn-primary">Enregistrer</button>
+    </form>
+    {% endif %}
+    <div class="card-soft mb-3">
+      <h2 class="h6">Historique</h2>
+      <ul class="list-unstyled small mb-0">{% for e in events %}
+        <li class="mb-2"><span class="text-muted">{{ e.at|date:"d/m/Y H:i" }}</span> · <strong>{{ e.get_kind_display }}</strong>
+          {% if e.from_status or e.to_status %}({% if e.from_status %}{{ e.get_from_status_display }} → {% endif %}{{ e.get_to_status_display }}){% endif %}
+          {% if e.app_version %}<span class="text-muted">· v{{ e.app_version }}</span>{% endif %}
+          {% if e.comment %}<div>{{ e.comment|linebreaksbr }}</div>{% endif %}</li>
+      {% endfor %}</ul>
+    </div>
+    {% if similar %}
+    <div class="card-soft">
+      <h2 class="h6">Autres incidents de même nature pour cette source</h2>
+      <ul class="small mb-0">{% for s in similar %}<li><a href="{{ s.get_absolute_url }}">{{ s.uid }}</a> — {{ s.title|truncatechars:70 }} ({{ s.get_status_display|lower }})</li>{% endfor %}</ul>
+    </div>
+    {% endif %}
+  </div>
+</div>
+{% endblock %}
diff --git a/templates/incidents/export_preview.html b/templates/incidents/export_preview.html
new file mode 100644
