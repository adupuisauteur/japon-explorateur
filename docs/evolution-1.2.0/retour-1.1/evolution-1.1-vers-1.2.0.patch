+{% extends "base.html" %}
+{% block title %}Rapport de diagnostic{% endblock %}
+{% block content %}
+<nav class="small mb-2"><a href="{% url 'incidents:list' %}">Journal des dysfonctionnements</a> › Rapport de diagnostic</nav>
+<div class="page-head"><div><h1>Rapport de diagnostic</h1>
+  <p>{% if uid %}Incident {{ uid }}{% else %}{{ count }} incident(s) selon les filtres du journal (100 au plus){% endif %}. Voici <strong>exactement</strong> ce que contiendra le fichier : relisez-le avant de le transmettre (à Claude ou à un développeur). Les mots de passe, clés API, jetons, adresses e-mail et chemins personnels sont masqués automatiquement.</p></div></div>
+<form method="get" class="card-soft d-flex flex-wrap gap-3 align-items-end mb-3">
+  {% for k, v in request.GET.items %}{% if k not in "format hide_terms download" %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endif %}{% endfor %}
+  <div><label class="form-label small" for="fmt">Format</label>
+    <select id="fmt" name="format" class="form-select form-select-sm">
+      <option value="md" {% if fmt == 'md' %}selected{% endif %}>Texte lisible (Markdown)</option>
+      <option value="json" {% if fmt == 'json' %}selected{% endif %}>Données structurées (JSON)</option></select></div>
+  <div class="form-check"><input class="form-check-input" type="checkbox" id="hide" name="hide_terms" value="on" {% if hide %}checked{% endif %}>
+    <label class="form-check-label small" for="hide">Masquer les termes de recherche</label></div>
+  <button class="btn btn-sm btn-outline-secondary">Mettre à jour l'aperçu</button>
+  <a class="btn btn-sm btn-primary ms-auto" href="?{{ download_query }}"><i class="bi bi-download"></i> Télécharger ce rapport</a>
+</form>
+<pre class="diag-pre">{{ content }}</pre>
+{% endblock %}
diff --git a/templates/incidents/list.html b/templates/incidents/list.html
new file mode 100644
index 0000000..4ff51b0
--- /dev/null
+++ b/templates/incidents/list.html
@@ -0,0 +1,62 @@
+{% extends "base.html" %}{% load app_tags %}
+{% block title %}Journal des dysfonctionnements{% endblock %}
+{% block content %}
+<div class="page-head">
+  <div>
+    <h1>Journal des dysfonctionnements</h1>
+    <p>Les problèmes rencontrés par l'application sont enregistrés ici automatiquement : sources injoignables, réponses illisibles, erreurs de traitement… Une recherche <strong>sans résultat</strong> n'est pas un dysfonctionnement et n'apparaît pas ici. Le journal reste sur ce poste : rien n'est envoyé à l'extérieur.</p>
+  </div>
+  <div class="d-flex flex-wrap gap-2">
+    <a class="btn btn-primary" href="{% url 'incidents:report' %}"><i class="bi bi-megaphone"></i> Signaler un problème</a>
+    <a class="btn btn-outline-secondary" href="{% url 'incidents:analysis' %}"><i class="bi bi-bar-chart"></i> Analyse</a>
+    <a class="btn btn-outline-secondary" href="{% url 'incidents:export_list' %}?{{ querystring }}"><i class="bi bi-file-earmark-arrow-down"></i> Exporter un diagnostic</a>
+  </div>
+</div>
+
