# Copiez ce fichier en « .env » puis complétez-le. Ne versionnez jamais le fichier .env.

# --- Installation d'essai 1.3.0 : INDÉPENDANTE de l'installation principale et de l'essai 1.2.0 --
# Nom du projet Docker : détermine le nom des conteneurs ET des volumes de données.
# Ne mettez NI « japon-explorateur » (installation principale) NI « japon-explorateur-essai »
# (essai 1.2.0) : ce seraient leurs bases. Ne recopiez pas le .env de l'essai 1.2.0 sans corriger
# ces deux lignes. Les conteneurs refusent de démarrer sous ces deux noms.
COMPOSE_PROJECT_NAME=japon-explorateur-essai-130
# Port local de l'essai 1.3.0 (installation principale : 8000 ; essai 1.2.0 : 8001).
WEB_PORT=8002
# ------------------------------------------------------------------------------------------------
# Générez les valeurs avec :  docker compose run --rm web python manage.py generate_secrets
#                       (ou, hors Docker :  python manage.py generate_secrets)

DJANGO_SECRET_KEY=à-remplacer
AI_KEYS_ENCRYPTION_KEY=à-remplacer
POSTGRES_PASSWORD=à-remplacer-par-un-mot-de-passe-long
# Jeton demandé par l'assistant de première configuration. Obligatoire si SECURE_HTTPS=true.
# SETUP_TOKEN=à-remplacer

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Accès distant (après mise en place d'HTTPS) :
# DJANGO_ALLOWED_HOSTS=japon.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://japon.example.org
# SECURE_HTTPS=true
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# Connexion : verrouillage temporaire après plusieurs échecs (identifiant + adresse IP)
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900

TZ=Europe/Paris

# Sauvegardes : copie externe (chemin vu par le conteneur, voir le volume dans docker-compose.yml)
# BACKUP_EXTERNAL_DIR=/backups-externes

# Imports : taille maximale d'un fichier (Mo)
IMPORT_MAX_FILE_SIZE_MB=50

# CiNii Research : identifiant d'application gratuit (inscription « CiNii API » auprès de NII).
# Laissez vide tant que vous ne l'avez pas : le connecteur CiNii sera simplement indiqué « non configuré ».
# Cette valeur n'est jamais enregistrée en base ni dans le journal des dysfonctionnements.
CINII_APPID=

# Connecteurs : identification envoyée aux catalogues et délai d'attente
# CONNECTOR_USER_AGENT=JaponExplorateurDocumentaire/1.0 (contact : votre-adresse)
CONNECTOR_DEFAULT_TIMEOUT=20

# --- Module de traduction (1.3.0) --------------------------------------------------------------
# Les clés DeepL et Google se saisissent dans l'application (Traduction → Moteurs), jamais ici.
# Délais de réponse (secondes) :
# TRANSLATION_TIMEOUT_DEEPL=60
# TRANSLATION_TIMEOUT_GOOGLE=60
# TRANSLATION_TIMEOUT_ARGOS=180
# Service Argos local (facultatif, lot 9) : laisser vide tant qu'il n'est pas activé.
# TRANSLATION_ARGOS_URL=

# PDF : police japonaise TrueType à incorporer (l'image Docker fournit IPAex)
# PDF_JAPANESE_FONT=/usr/share/fonts/opentype/ipaexfont-mincho/ipaexm.ttf
# PDF : polices de secours supplémentaires pour les caractères rares (TrueType, séparées par des virgules)
# PDF_FALLBACK_FONTS=

# IA : adresses locales autorisées pour un fournisseur « compatible OpenAI » (ex. Ollama sur la machine)
# AI_ALLOWED_LOCAL_URLS=http://host.docker.internal:11434/v1
