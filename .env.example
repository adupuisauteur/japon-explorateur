# Copiez ce fichier en « .env » puis complétez-le. Ne versionnez jamais le fichier .env.

# --- Nom et port de l'installation (2.0.0) ------------------------------------------------------
# Nom du projet Docker : détermine le nom des conteneurs ET des volumes de données. OBLIGATOIRE.
# Choisissez un nom propre à cette installation, par exemple « jed » (lettres minuscules, chiffres, tirets).
# Noms protégés : « japon-explorateur » (installation principale) et « japon-explorateur-essai » (essai
# existant) ; les conteneurs refusent de démarrer sous ces noms, sauf mise à jour autorisée (plus bas).
# Pour METTRE À JOUR une installation, gardez exactement le nom de son .env actuel.
COMPOSE_PROJECT_NAME=
# Port local (http://localhost:<port>). Deux installations simultanées doivent avoir deux ports différents.
WEB_PORT=8000
# ------------------------------------------------------------------------------------------------
# Générez les valeurs avec :  docker compose run --rm web python manage.py generate_secrets
#                       (ou, hors Docker :  python manage.py generate_secrets)

DJANGO_SECRET_KEY=à-remplacer
AI_KEYS_ENCRYPTION_KEY=à-remplacer
POSTGRES_PASSWORD=à-remplacer-par-un-mot-de-passe-long
# Jeton demandé par l'assistant de première configuration. Obligatoire si SECURE_HTTPS=true.
# SETUP_TOKEN=à-remplacer

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Accès distant (après mise en place d'HTTPS) :
# DJANGO_ALLOWED_HOSTS=japon.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://japon.example.org
# SECURE_HTTPS=true
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# Connexion : verrouillage temporaire après plusieurs échecs (identifiant + adresse IP)
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900

TZ=Europe/Paris

# Sauvegardes visibles dans Windows (2.0.0) : chaque sauvegarde est aussi copiée dans ce dossier de
# l'ordinateur (créé s'il n'existe pas). Choisissez un dossier HORS du dossier de l'application, qui est
# remplacé à chaque mise à jour. Sans cette ligne, la copie reste dans un volume Docker.
# DOSSIER_SAUVEGARDES=C:\J-ed\sauvegardes

# Imports : taille maximale d'un fichier (Mo)
IMPORT_MAX_FILE_SIZE_MB=50

# CiNii Research : identifiant d'application gratuit (inscription « CiNii API » auprès de NII).
# Laissez vide tant que vous ne l'avez pas : le connecteur CiNii sera simplement indiqué « non configuré ».
# Cette valeur n'est jamais enregistrée en base ni dans le journal des dysfonctionnements.
CINII_APPID=

# Connecteurs : identification envoyée aux catalogues et délai d'attente
# CONNECTOR_USER_AGENT=JaponExplorateurDocumentaire/1.0 (contact : votre-adresse)
CONNECTOR_DEFAULT_TIMEOUT=20

# Mise à jour d'une installation existante (principale ou essai) en gardant ses données : J-ed refuse de
# démarrer sous les noms « japon-explorateur » et « japon-explorateur-essai », sauf si cette ligne reprend
# EXACTEMENT la valeur de COMPOSE_PROJECT_NAME. Laissez-la commentée pour une installation séparée.
# AUTORISER_NOM_PROJET=

# Argos Translate (traduction hors ligne) : fait partie de l'installation standard (2.0.0). Il démarre avec J-ed
# grâce à la ligne ci-dessous. Poste à mémoire limitée : laissez-la vide (« COMPOSE_PROFILES= ») pour ne pas le
# démarrer. Les paquets de langues se récupèrent en un clic dans Traduction → Moteurs locaux (environ 200 Mo).
COMPOSE_PROFILES=argos
# Limites facultatives du service Argos : nombre de cœurs (par exemple 4) et mémoire maximale (par exemple 4g).
# 0 = sans limite (par défaut). Argos utilise environ 1 à 3 Go pendant une traduction ; 8 Go conseillés sur
# l'ordinateur.
# ARGOS_COEURS=0
# ARGOS_MEMOIRE_MAX=0

# IA locale (2.0.0, facultative) : une IA qui tourne sur cet ordinateur, gratuite, pour les résumés IA. Pour
# l'installer, ajoutez « ollama » à la ligne COMPOSE_PROFILES ci-dessus (COMPOSE_PROFILES=argos,ollama), puis
# « docker compose up -d ». Le programme (image Docker, environ 1 à 2 Go) est alors téléchargé ; un modèle ne
# l'est que sur votre choix, dans Traduction → Moteurs locaux (1,4 à 5,2 Go selon le modèle).
# Limites facultatives (0 = sans limite) ; un modèle moyen occupe environ 4 Go de mémoire pendant un résumé :
# OLLAMA_COEURS=0
# OLLAMA_MEMOIRE_MAX=0
# Version de l'image Ollama (fixée par J-ed) et délai de réponse d'une demande, en secondes :
# OLLAMA_VERSION=0.30.9
# OLLAMA_TIMEOUT=900

# Profil de machine (2.0.0) : calculé au démarrage d'après la mémoire et les cœurs accordés à Docker
# (économe, normal, puissant ; voir Administration → État de l'installation). Pour l'imposer :
# JED_PROFIL=normal
# puis « docker compose up -d ».

# Argos : découpage en phrases. « jed » (par défaut) : par la ponctuation, sans modèle ; « paquet » : modèle
# Stanza ou MiniSBD du paquet (les modèles Stanza des paquets ja→en 1.1 et en→fr 1.9 ne se chargent pas avec
# Stanza 1.10, constat du 15 novembre 2026).
# ARGOS_DECOUPAGE=jed
# --- Module de traduction --------------------------------------------------------------------
# Les clés DeepL et Google se saisissent dans l'application (Traduction → Moteurs), jamais ici.
# Délais de réponse (secondes) :
# TRANSLATION_TIMEOUT_DEEPL=60
# TRANSLATION_TIMEOUT_GOOGLE=60
# TRANSLATION_TIMEOUT_ARGOS=180
# Service Argos local : l'adresse interne par défaut (http://argos:5000) convient ; ne la changez que pour un
# service installé ailleurs. Sans le service, une traduction Argos est refusée (jamais simulée).
# TRANSLATION_ARGOS_URL=http://argos:5000
# Délai maximal d'une installation de paquet (téléchargement compris), en secondes :
# TRANSLATION_ARGOS_INSTALL_TIMEOUT=1800

# PDF : police japonaise TrueType à incorporer (l'image Docker fournit IPAex)
# PDF_JAPANESE_FONT=/usr/share/fonts/opentype/ipaexfont-mincho/ipaexm.ttf
# PDF : polices de secours supplémentaires pour les caractères rares (TrueType, séparées par des virgules)
# PDF_FALLBACK_FONTS=

# IA : adresses locales autorisées pour un fournisseur « compatible OpenAI » (ex. Ollama sur la machine)
# AI_ALLOWED_LOCAL_URLS=http://host.docker.internal:11434/v1

# 2.0.0 (lot 2) : délai, en secondes, entre deux vérifications de manifeste IIIF (respect des sites interrogés).
# IIIF_CHECK_DELAY_SECONDS=2
